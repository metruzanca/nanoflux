# Development / self-hosting image: builds the server from source so
# `docker compose up --build` works without a release. The GoReleaser
# Dockerfile (runtime-only, `COPY $TARGETPLATFORM/nanoflux`) is separate and
# untouched.
FROM golang:1.26-alpine AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${VERSION}" -o /out/nanoflux ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/nanoflux /usr/local/bin/nanoflux

ENV RSS_ADDR=:8080 \
    RSS_DB=/data/rss.db \
    RSS_FILE_STORE=/filestore

EXPOSE 8080
ENTRYPOINT ["nanoflux"]