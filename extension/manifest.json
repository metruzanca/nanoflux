{
  "manifest_version": 3,
  "name": "nanoflux",
  "version": "0.1.0",
  "description": "See which feeds are on the current page and save them to your nanoflux reader.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "nanoflux"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}