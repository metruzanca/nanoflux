# nanoflux environment variables
#
# Copy to .env and edit. All variables are optional; the defaults shown here
# (or in parentheses) apply when unset. Every variable uses the NF_ prefix.

# --- Server ---

# Listen address (default :8080)
NF_ADDR=:8080

# SQLite database path (default ./data/rss.db)
NF_DB=./data/rss.db

# Log level: debug, info, warn, error (default info)
NF_LOG_LEVEL=info

# Poller wake interval, Go duration syntax (default 15m)
NF_POLL_INTERVAL=15m

# Concurrent feed fetches (default 4). Distinct hosts are fetched in parallel;
# a single host's feeds are fetched one at a time to avoid rate limits.
NF_POLL_WORKERS=4

# Outbound User-Agent for feed fetching and discovery (default:
# "nanoflux (https://github.com/metruzanca/nanoflux)"). Set a contact URL for a
# large instance. Leave unset unless you need to override it.
# NF_USER_AGENT=

# --- First account ---
#
# Create the first account at startup when the database is empty; takes
# precedence over the default admin/admin account. Only set these on the very
# first run — later changes do not alter existing users.

# NF_ADMIN_USER=admin
# NF_ADMIN_PASS=

# --- Object storage ---
#
# Avatars and custom icons live in S3-compatible object storage. With no
# endpoint the store is the local directory NF_FILE_STORE (default:
# <db dir>/filestore). Use an https:// prefix to enable TLS.

NF_FILE_STORE=

# NF_S3_ENDPOINT=
# NF_S3_BUCKET=nanoflux
# NF_S3_ACCESS_KEY=
# NF_S3_SECRET_KEY=
# NF_S3_REGION=us-east-1

# --- Automatic backups ---
#
# Periodically snapshot the whole instance (database + local file store) and
# ship it to a destination. Off unless NF_BACKUP_INTERVAL and a destination are
# both set. The interval uses Go duration syntax (e.g. 24h, 12h30m). Snapshots
# are the same .tar.gz format as `make backup` / `nanoflux backup`.

# How often to back up; unset disables automatic backups.
# NF_BACKUP_INTERVAL=24h

# Snapshots to retain (newest kept, older pruned); 0 keeps everything.
# NF_BACKUP_KEEP=7

# Local destination directory (mutually exclusive with the S3 destination).
# NF_BACKUP_DIR=/backups

# S3-compatible destination, separate from the NF_S3_* blob config above so
# backups can live in a different bucket or account. Use an https:// endpoint
# for TLS. With S3 configured, the local file store is not included (the
# provider backs up its own objects).
# NF_BACKUP_S3_ENDPOINT=
# NF_BACKUP_S3_BUCKET=nanoflux-backups
# NF_BACKUP_S3_ACCESS_KEY=
# NF_BACKUP_S3_SECRET_KEY=
# NF_BACKUP_S3_REGION=us-east-1
# NF_BACKUP_S3_PREFIX=

# --- Plugins ---
#
# Directory scanned at startup for external feed plugins (executables). Native
# plugins (YouTube) are always available. Drop a built plugin into ./plugins on
# the host and restart. See docs/writing-plugins.md.

# NF_PLUGINS_DIR=/plugins