package web

import (
	"net/url"
	"strings"
)

// sourceIconHost extracts the lowercase hostname for /icons/ lookups, or ""
// when the url is unusable.
func sourceIconHost(rawurl string) string {
	u, err := url.Parse(rawurl)
	if err != nil || u.Hostname() == "" {
		return ""
	}
	return strings.ToLower(u.Hostname())
}

// SourceIcon renders a source-type icon for a feed URL. Icons are resolved
// server-side by /icons/{domain}, which prefers the user's cached custom icon
// for the domain and falls back to the built-in X/YouTube/globe icons.
templ SourceIcon(rawurl string) {
	if host := sourceIconHost(rawurl); host != "" {
		<img class="src-icon" src={ templ.URL("/icons/" + url.PathEscape(host)) } width="16" height="16" alt=""/>
	} else {
		@lucideIcon("globe", "src-icon")
	}
}

// lucideShapes holds the inner markup of the Lucide icons the UI inlines:
// https://lucide.dev (ISC), v0.469.0. Keep each entry a single SVG child set.
var lucideShapes = map[string]string{
	"check":      `<path d="M20 6 9 17l-5-5"/>`,
	"x":          `<path d="M18 6 6 18"/><path d="m6 6 12 12"/>`,
	"refresh-cw": `<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>`,
	"rotate-ccw": `<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>`,
	"square-pen": `<path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/>`,
	"layout-grid": `<rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>`,
	"list":        `<path d="M3 12h.01"/><path d="M3 18h.01"/><path d="M3 6h.01"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M8 6h13"/>`,
	"arrow-down": `<path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>`,
	"arrow-up":   `<path d="m5 12 7-7 7 7"/><path d="M12 19V5"/>`,
	"globe":      `<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>`,
	"ellipsis":   `<circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>`,
}

// Lucide inlines a Lucide glyph (by its icon name) at the default size. The
// .ic class sizes it to the surrounding text.
templ Lucide(name string) {
	@lucideIcon(name, "ic")
}

// lucideIcon inlines a Lucide glyph (by its icon name) inside a 24x24 stroked
// SVG. An unknown name renders nothing. class is optional CSS.
templ lucideIcon(name, class string) {
	if shape, ok := lucideShapes[name]; ok {
		<svg class={ class } viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@templ.Raw(shape)</svg>
	}
}

// FavIcon renders a Lucide star for the favorite toggle. When favorite it is
// filled (currentColor); otherwise it is the outline. The .star/.on classes
// tint it.
templ FavIcon(fav bool) {
	if fav {
		<svg class="star on" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
	} else {
		<svg class="star" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
	}
}

// EditIcon is the Lucide square-pen glyph, used for "edit" affordances.
templ EditIcon() {
	@lucideIcon("square-pen", "ic")
}