package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

// extFeedForm is the add-feed form the browser extension loads into its popup.
// The popup sets <base href="{server}/"> and a global hx-headers with the auth
// token, so the relative hx-post resolves to the nanoflux server; the result is
// swapped into #ext-result.
templ extFeedForm(feedURL, homeURL, title string, authors []store.Author) {
	<form class="stack" hx-post="/api/ext/save" hx-target="#ext-result" hx-swap="innerHTML">
		<input type="hidden" name="feed_url" value={ feedURL }/>
		<input type="hidden" name="home_url" value={ homeURL }/>
		<label>title
			<input name="title" type="text" value={ title } required/>
		</label>
		@comboSelect("author_id", "", "author", "auto — new author", extAuthorItems(authors), nil)
		<button type="submit">add feed</button>
	</form>
	<div id="ext-result"></div>
}

// extSaved is the success fragment shown after saving a feed from the extension.
// It links to the author the feed now belongs to (which may be one the user just
// created), so the popup never auto-navigates but offers a way there.
templ extSaved(title string, authorID int64) {
	<div class="ext-ok" role="status">saved <strong>{ title }</strong> @web.Lucide("check")</div>
	if authorID != 0 {
		<div class="ext-links">
			<a href={ templ.URL("/authors/" + strconv.FormatInt(authorID, 10)) } target="_blank" rel="noopener">open this author in nanoflux</a>
		</div>
	}
}

// extPageForm is the save-page form the browser extension loads into its popup
// when the current page is not a feed. The page URL is fixed; the title is
// prefilled from the tab and editable, and the page is saved into the selected
// destination (bookmarks by default) or a new list typed in the name field.
templ extPageForm(pageURL, title, selectedList string, lists []comboItem) {
	<form class="stack" hx-post="/api/ext/page-save" hx-target="#ext-result" hx-swap="innerHTML">
		<input type="hidden" name="url" value={ pageURL }/>
		<label>title
			<input name="title" type="text" value={ title } placeholder="page title"/>
		</label>
		<label>save to list
			<select name="list_id">
				for _, l := range lists {
					if l.Value == selectedList {
						<option value={ l.Value } selected>{ l.Label }</option>
					} else {
						<option value={ l.Value }>{ l.Label }</option>
					}
				}
			</select>
		</label>
		<label>or new list
			<input name="new_list" type="text" placeholder="new list name" autocomplete="off"/>
		</label>
		<button type="submit">save page</button>
	</form>
	<div id="ext-result"></div>
}

// extPageSaved is the success fragment shown after saving a page. It deep-links
// to the saved item's modal (#item-<id>), which opens from the id alone even
// when the item is not on the current page.
templ extPageSaved(itemID int64, title, list string) {
	<div class="ext-ok" role="status">saved <strong>{ title }</strong>
		if list != "" {
			<span class="muted">to { list }</span>
		}
		@web.Lucide("check")</div>
	if itemID != 0 {
		<div class="ext-links">
			<a href={ templ.URL("/#item-" + strconv.FormatInt(itemID, 10)) } target="_blank" rel="noopener">open this page in nanoflux</a>
		</div>
	}
}

// savePageForm is the in-app "save url for later" form, fetched into the shared
// #save-page-dialog by the nav "add" menu. Unlike the extension variant the URL
// is not fixed by the current tab, so it is an editable field. The page is saved
// into the selected destination (bookmarks by default) or a new list typed in
// the name field.
templ savePageForm(selectedList string, lists []comboItem) {
	<div class="row">
		<h2>save url for later</h2>
		<button type="button" class="link" data-close-dialog>@web.Lucide("x")</button>
	</div>
	<form class="stack" hx-post="/save-page" hx-target="#save-page-dialog" hx-swap="innerHTML">
		<label>url
			<input name="url" type="text" placeholder="https://site.com/page" autofocus required/>
		</label>
		<label>title
			<input name="title" type="text" placeholder="optional — fetched from the page"/>
		</label>
		<label>save to list
			<select name="list_id">
				for _, l := range lists {
					if l.Value == selectedList {
						<option value={ l.Value } selected>{ l.Label }</option>
					} else {
						<option value={ l.Value }>{ l.Label }</option>
					}
				}
			</select>
		</label>
		<label>or new list
			<input name="new_list" type="text" placeholder="new list name" autocomplete="off"/>
		</label>
		<div id="save-page-error" class="error"></div>
		<button type="submit">save page</button>
	</form>
}

// savePageSaved is the success fragment shown in the dialog after saving a page
// in-app, with a deep link to the saved item.
templ savePageSaved(itemID int64, title, list string) {
	<div class="ext-ok" role="status">saved <strong>{ title }</strong>
		if list != "" {
			<span class="muted">to { list }</span>
		}
		@web.Lucide("check")</div>
	<div class="row">
		if itemID != 0 {
			<a href={ templ.URL("/#item-" + strconv.FormatInt(itemID, 10)) }>open this page</a>
		}
		<button type="button" data-close-dialog>close</button>
	</div>
}

// extError is the error banner for the extension popup.
templ extError(msg string) {
	<div class="error" role="alert">{ msg }</div>
}