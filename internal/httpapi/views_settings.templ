package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ settingsPage(u store.User, d settingsData) {
	<h1>settings</h1>
	@settingsAvatar(d.settingsAvatarData)
	@settingsHomeCard(d.Home)
	@settingsTimezone(d.Timezone)
	@settingsTheme(d.Theme)
	@settingsAccent(d.Accent)
	@settingsPassword(d.Password)
	@settingsSessions(d.Sessions)
	@settingsOpml(d.Opml)
	@settingsExtension(d.Extension)
	<section class="card">
		<h2>custom source icons</h2>
		<p class="muted small">Add a domain and an icon url to override the built-in icons for that site. Icons are cached by nanoflux; use refresh to re-fetch the latest.</p>
		<form class="stack" hx-post="/settings/icons" hx-target="#settings-icons-list" hx-swap="beforeend">
			<div class="row">
				<label>domain
					<input name="domain" type="text" placeholder="github.com" required/>
				</label>
				<label>icon url
					<input name="icon_url" type="url" placeholder="https://.../icon.png" required/>
				</label>
			</div>
			<div id="settings-icons-error" class="error"></div>
			<button type="submit">add icon</button>
		</form>
		@SettingsIconsList(d.Icons)
	</section>

	@settingsMappings(d)

	@settingsShortcuts()
	@footer()
}

// settingsExtension is the browser-extension download card: the extension is
// served from this install (no browser store needed), with load-unpacked
// instructions that point at this server.
templ settingsExtension(d settingsExtensionData) {
	<section class="card" id="settings-extension-card">
		<h2>browser extension</h2>
		<p class="muted small">Save feeds from the page you're reading. The extension is served from this install — no browser store needed.</p>
		<div class="row">
			<a class="button" href="/settings/extension.zip">download extension (.zip)</a>
		</div>
		<ol class="muted small">
			<li>Unzip the download.</li>
			<li>Open <code>chrome://extensions</code> (or <code>brave://extensions</code>) and turn on <strong>Developer mode</strong>.</li>
			<li>Click <strong>Load unpacked</strong> and pick the unzipped folder.</li>
			<li>Open the extension's settings and enter this server: <code>{ d.ServerURL }</code>, then log in.</li>
		</ol>
	</section>
}

templ settingsShortcuts() {
	<section class="card">
		<h2>keyboard shortcuts</h2>
		<p class="muted small">Press ? anywhere to toggle this list.</p>
		@shortcutsTable()
	</section>
}

templ settingsAvatar(d settingsAvatarData) {
	<section class="card" id="settings-avatar-card">
		<h2>profile picture</h2>
		<form class="stack" hx-post="/settings/avatar" hx-target="#settings-avatar-card" hx-swap="outerHTML" enctype="multipart/form-data">
			<div class="row">
				if d.HasAvatar {
					<img class="avatar avatar-lg" src={ templ.URL("/avatar") } alt="profile picture"/>
				} else {
					<span class="muted">no picture yet</span>
				}
				<label>upload a picture
					<input type="file" name="avatar" accept="image/*"/>
				</label>
			</div>
			if d.Error != "" {
				<div class="error" role="alert">{ d.Error }</div>
			}
			<button type="submit">save</button>
		</form>
	</section>
}

templ settingsTimezone(d settingsTimezoneData) {
	<section class="card" id="settings-timezone-card">
		<h2>timezone</h2>
		<p class="muted small">Timestamps render in this timezone. Leave it empty to use the server's time.</p>
		<form class="stack" hx-post="/settings/timezone" hx-target="#settings-timezone-card" hx-swap="outerHTML">
			<label>iana timezone name
				<input type="text" name="timezone" value={ d.Timezone } placeholder="America/New_York" autocomplete="off"/>
			</label>
			if d.Error != "" {
				<div class="error" role="alert">{ d.Error }</div>
			}
			<button type="submit">save</button>
		</form>
	</section>
}

templ settingsTheme(d settingsThemeData) {
	<section class="card" id="settings-theme-card">
		<h2>theme</h2>
		<p class="muted small">system follows your device's light/dark preference.</p>
		<form class="stack" hx-post="/settings/theme" hx-target="#settings-theme-card" hx-swap="outerHTML">
			<div class="row">
				<label class="check">
					<input type="radio" name="theme" value="dark" checked={ d.Theme == "dark" }/> dark
				</label>
				<label class="check">
					<input type="radio" name="theme" value="light" checked={ d.Theme == "light" }/> light
				</label>
				<label class="check">
					<input type="radio" name="theme" value="system" checked={ d.Theme == "system" }/> system
				</label>
			</div>
			<button type="submit">save</button>
		</form>
	</section>
}

templ settingsAccent(d settingsAccentData) {
	<section class="card" id="settings-accent-card">
		<h2>accent color</h2>
		<p class="muted small">Used across the app for links, buttons, and highlights. Presets apply immediately; the picker needs save.</p>
		<form class="stack" hx-post="/settings/accent" hx-target="#settings-accent-card" hx-swap="outerHTML">
			<div class="accent-swatches" role="list" aria-label="preset accent colors">
				for _, c := range accentPresets {
					<button type="button" class="accent-swatch" data-accent-preset={ c } style={ "background: " + c } title={ c } aria-label={ "use accent " + c }></button>
				}
			</div>
			<label>custom color
				<input type="color" name="accent" value={ d.Accent }/>
			</label>
			if d.Error != "" {
				<div class="error" role="alert">{ d.Error }</div>
			}
			<button type="submit">save</button>
		</form>
	</section>
}

templ settingsPassword(d settingsPasswordData) {
	<section class="card" id="settings-password-card">
		<h2>password</h2>
		<form class="stack" hx-post="/settings/password" hx-target="#settings-password-card" hx-swap="outerHTML">
			<label>current password
				<input name="current_password" type="password" autocomplete="current-password" required/>
			</label>
			<label>new password
				<input name="new_password" type="password" autocomplete="new-password" minlength="8" required/>
			</label>
			<label>confirm new password
				<input name="confirm_password" type="password" autocomplete="new-password" required/>
			</label>
			if d.Error != "" {
				<div class="error" role="alert">{ d.Error }</div>
			}
			if d.Success != "" {
				<p class="muted">{ d.Success }</p>
			}
			<button type="submit">change password</button>
		</form>
	</section>
}

templ settingsSessions(d settingsSessionsData) {
	<section class="card" id="settings-sessions-card">
		<h2>sessions</h2>
		<p class="muted small">Devices logged into your account. Log out anything you don't recognize.</p>
		<ul class="plain" id="settings-sessions-list">
			for _, r := range d.Rows {
				<li id={ "session-" + r.Token }>
					<div class="row">
						<div class="item-meta">
							signed in { web.TimeFmt(d.Timezone, r.CreatedAt) }
							if r.IsCurrent {
								· <span class="badge">this device</span>
							}
						</div>
						<div class="row-actions">
							<button class="link" hx-post={ "/settings/sessions/" + r.Token + "/revoke" } hx-target="#settings-sessions-card" hx-swap="outerHTML">log out</button>
						</div>
					</div>
				</li>
			}
			if len(d.Rows) == 0 {
				<li class="muted small">no active sessions</li>
			}
		</ul>
	</section>
}

templ settingsOpml(d settingsOpmlData) {
	<section class="card" id="settings-opml-card">
		<h2>opml</h2>
		<p class="muted small">Export your subscriptions or import them from another reader. Feed urls that already exist are skipped.</p>
		<div class="row">
			<a class="button" href="/settings/export.opml">export</a>
			<form class="stack" hx-post="/settings/opml" hx-target="#settings-opml-card" hx-swap="outerHTML" enctype="multipart/form-data">
				<label>import file
					<input type="file" name="file" accept=".opml,.xml,application/xml,text/xml"/>
				</label>
				<div id="opml-error" class="error"></div>
				<button type="submit">import</button>
			</form>
		</div>
		if d.Message != "" {
			<p class="muted">{ d.Message }</p>
		}
	</section>
}

templ SettingsIconsList(rows []settingsIconRow) {
	<ul class="plain" id="settings-icons-list">
		for _, r := range rows {
			@SettingsIconRow(r)
		}
	</ul>
}

templ SettingsIconRow(r settingsIconRow) {
	<li id={ "settings-icon-" + strconv.FormatInt(r.ID, 10) }>
		if r.Flash != "" {
			<div class="error">{ r.Flash }</div>
		}
		<div class="row">
			<div class="row">
				<img class="src-icon" src={ "/icons/" + r.Domain } width="16" height="16" alt=""/>
				<strong>{ r.Domain }</strong>
				<span class="muted small">
					if r.LastFetchedAt != "" {
						cached { web.TimeFmt(r.Timezone, r.LastFetchedAt) }
					} else {
						not cached yet
					}
				</span>
			</div>
			<div class="row-actions">
				<button class="link" title="re-fetch the icon" hx-post={ "/settings/icons/" + strconv.FormatInt(r.ID, 10) + "/refresh" } hx-target={ "#settings-icon-" + strconv.FormatInt(r.ID, 10) } hx-swap="outerHTML">refresh</button>
				<button class="link danger" title="remove" hx-post={ "/settings/icons/" + strconv.FormatInt(r.ID, 10) + "/delete" } hx-target="#settings-icons-list" hx-swap="innerHTML" hx-confirm="remove this icon?">@web.Lucide("x")</button>
			</div>
		</div>
	</li>
}