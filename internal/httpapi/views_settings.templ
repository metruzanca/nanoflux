package httpapi

import (
	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ settingsPage(u store.User, d settingsData) {
	<h1>settings</h1>
	@settingsAvatar(d.settingsAvatarData)
	@settingsHomeCard(d.Home)
	@settingsTimezone(d.Timezone)
	@settingsAppearance(d.Appearance)
	@settingsAutoRead(d.AutoRead)
	@settingsSessions(d.Sessions)
	@settingsOpml(d.Opml)
	@settingsExtension(d.Extension)

	@settingsShortcuts()
	@passwordDialog(d.Password)
	@footer()
}

// settingsExtension is the browser-extension download card: the extension is
// served from this install (no browser store needed), with load-unpacked
// instructions that point at this server.
templ settingsExtension(d settingsExtensionData) {
	<section class="card" id="settings-extension-card">
		<h2>browser extension</h2>
		<p class="muted small">Save feeds from the page you're reading. The extension is served from this install — no browser store needed.</p>
		<div class="row">
			<a class="button" href="/settings/extension.zip">download extension (.zip)</a>
		</div>
		<ol class="muted small">
			<li>Unzip the download.</li>
			<li>Open <code>chrome://extensions</code> (or <code>brave://extensions</code>) and turn on <strong>Developer mode</strong>.</li>
			<li>Click <strong>Load unpacked</strong> and pick the unzipped folder.</li>
			<li>Open the extension's settings and enter this server: <code>{ d.ServerURL }</code>, then log in.</li>
		</ol>
	</section>
}

templ settingsShortcuts() {
	<section class="card">
		<h2>keyboard shortcuts</h2>
		<p class="muted small">Press ? anywhere to toggle this list.</p>
		@shortcutsTable()
	</section>
}

// settingsAvatar shows the profile picture with a pencil badge in its corner.
// Clicking the badge (or the picture) opens the file picker; picking a file, or
// dropping one onto the picture, uploads immediately. There is no save button:
// app.js submits the hidden form on change/drop. The card also carries the
// "change password" trigger, since the two account actions sit together.
templ settingsAvatar(d settingsAvatarData) {
	<section class="card" id="settings-avatar-card">
		<div class="row">
			<h2>profile</h2>
			<button type="button" class="link" data-open="password-dialog">change password</button>
		</div>
		<form id="avatar-form" class="stack" hx-post="/settings/avatar" hx-target="#settings-avatar-card" hx-swap="outerHTML" enctype="multipart/form-data">
			<div class="avatar-edit" id="avatar-edit" data-avatar-drop title="click or drop an image to update your picture">
				if d.HasAvatar {
					<img class="avatar avatar-lg" id="avatar-img" src={ templ.URL("/avatar") } alt="profile picture"/>
				} else {
					<span class="avatar avatar-lg avatar-default" id="avatar-img">{ web.Initial(d.Username) }</span>
				}
				<button type="button" class="avatar-pencil" aria-label="change profile picture" data-click="avatar-input">@web.Lucide("pencil")
</button>
				<input id="avatar-input" class="avatar-file" type="file" name="avatar" accept="image/*" data-submit-avatar/>
			</div>
			if d.Error != "" {
				<div class="error" role="alert">{ d.Error }</div>
			}
		</form>
	</section>
}

templ settingsTimezone(d settingsTimezoneData) {
	<section class="card" id="settings-timezone-card">
		<h2>timezone</h2>
		<p class="muted small">Timestamps render in this timezone. Pick "server time" to use the server's time.</p>
		<form class="stack" hx-post="/settings/timezone" hx-trigger="change" hx-target="#settings-timezone-card" hx-swap="outerHTML">
			@comboSelect("timezone", d.Timezone, "timezone", "search timezones", d.Items, nil)
			if d.Error != "" {
				<div class="error" role="alert">{ d.Error }</div>
			}
		</form>
	</section>
}

// settingsAppearance is the appearance card: theme, accent color, whether the
// navbar unread badges are shown, whether the "unread" nav item moves into the
// user menu, and how many columns grid display may use. Each control has its
// own sub-target so a change re-renders only that control.
templ settingsAppearance(d settingsAppearanceData) {
	<section class="card" id="settings-appearance-card">
		<h2>appearance</h2>
		<p class="muted small">Make the reader yours. Changes apply immediately.</p>
		<div class="stack">
			@appearanceTheme(settingsThemeData{Theme: d.Theme})
			@appearanceAccent(settingsAccentData{Accent: d.Accent, Error: d.AccentError})
			@appearanceUnreadCounts(settingsAppearanceData{HideUnreadCounts: d.HideUnreadCounts})
			@appearanceUnreadNav(settingsAppearanceData{HideUnreadNav: d.HideUnreadNav, HideUnreadCounts: d.HideUnreadCounts})
		</div>
	</section>
}

templ appearanceTheme(d settingsThemeData) {
	<div id="settings-theme-section">
		<form class="stack" hx-post="/settings/theme" hx-trigger="change" hx-target="#settings-theme-section" hx-swap="outerHTML">
			@comboSelect("theme", d.Theme, "theme", "select a theme", themeItems, nil)
		</form>
	</div>
}

templ appearanceAccent(d settingsAccentData) {
	<div id="settings-accent-section">
		<form class="stack" hx-post="/settings/accent" hx-target="#settings-accent-section" hx-swap="outerHTML">
			<label>accent color</label>
			<p class="muted small">Used across the app for links, buttons, and highlights.</p>
			<div class="accent-swatches" role="list" aria-label="preset accent colors">
				for _, c := range accentPresets {
					<button type="button" class="accent-swatch" data-accent-preset={ c } style={ "background: " + c } title={ c } aria-label={ "use accent " + c }></button>
				}
			</div>
			<label>custom color
				<input type="color" name="accent" value={ d.Accent } data-submit-on-change/>
			</label>
			if d.Error != "" {
				<div class="error" role="alert">{ d.Error }</div>
			}
		</form>
	</div>
}

templ appearanceUnreadCounts(d settingsAppearanceData) {
	<div id="settings-unread-counts-section">
		<form class="stack" hx-post="/settings/appearance/unread-counts" hx-trigger="change" hx-target="#settings-unread-counts-section" hx-swap="outerHTML">
			@switchField("hide_unread_counts", "hide global unread counts", d.HideUnreadCounts, nil)
			<p class="muted small">Hide the numbers next to unread and authors in the navbar. Great if they cause anxiety.</p>
		</form>
	</div>
}

templ appearanceUnreadNav(d settingsAppearanceData) {
	<div id="settings-unread-nav-section">
		<form class="stack" hx-post="/settings/appearance/unread-nav" hx-trigger="change" hx-target="#settings-unread-nav-section" hx-swap="outerHTML">
			@switchField("hide_unread_nav", "hide unread from nav", d.HideUnreadNav, nil)
			<p class="muted small">Move the "unread" link out of the navbar and into the user menu.</p>
		</form>
	</div>
}

templ appearanceGridColumns(d settingsAppearanceData) {
	<div id="settings-grid-columns-section">
		<form class="stack" hx-post="/settings/appearance/grid-columns" hx-trigger="change" hx-target="#settings-grid-columns-section" hx-swap="outerHTML">
			@sliderField("grid_max_columns", "home grid max columns", d.GridMaxColumns, 2, 6, nil)
			<p class="muted small">The most columns the home page grid may use. Other grid lists stay at two, and narrow screens drop to one.</p>
			if d.GridError != "" {
				<div class="error" role="alert">{ d.GridError }</div>
			}
		</form>
	</div>
}

templ settingsAutoRead(d settingsAutoReadData) {
	<section class="card" id="settings-auto-read-card">
		<h2>auto-read old items</h2>
		<p class="muted small">Unread items older than this are marked read automatically, including favorites and bookmarks. Off leaves everything as is. Marking read is reversible with "mark all unread".</p>
		<form class="stack" hx-post="/settings/auto-read" hx-trigger="change" hx-target="#settings-auto-read-card" hx-swap="outerHTML">
			@comboSelect("auto_read_after_days", d.Value, "mark items read after", "select a window", autoReadItems, nil)
			if d.Error != "" {
				<div class="error" role="alert">{ d.Error }</div>
			}
		</form>
	</section>
}

// passwordDialog is the change-password modal, opened from the profile card.
// Its body is settingsPasswordCard, which the form swaps in place on
// error/success so the dialog stays open and the message is visible (htmx's
// global beforeSwap listener renders 4xx bodies).
templ passwordDialog(d settingsPasswordData) {
	<dialog id="password-dialog" class="modal">
		@settingsPasswordCard(d)
	</dialog>
}

// settingsPasswordCard is the dialog's inner content and its own htmx swap
// target, so a failed or successful change re-renders just this, not the whole
// (open) dialog.
templ settingsPasswordCard(d settingsPasswordData) {
	<div id="settings-password-card">
		<div class="row">
			<h2>change password</h2>
			<button type="button" class="link" title="close" data-close="password-dialog">@web.Lucide("x")</button>
		</div>
		<form class="stack" hx-post="/settings/password" hx-target="#settings-password-card" hx-swap="outerHTML">
			<label>current password
				<input name="current_password" type="password" autocomplete="current-password" required/>
			</label>
			<label>new password
				<input name="new_password" type="password" autocomplete="new-password" minlength="8" required/>
			</label>
			<label>confirm new password
				<input name="confirm_password" type="password" autocomplete="new-password" required/>
			</label>
			if d.Error != "" {
				<div class="error" role="alert">{ d.Error }</div>
			}
			if d.Success != "" {
				<p class="muted">{ d.Success }</p>
			}
			<button type="submit">change password</button>
		</form>
	</div>
}

templ settingsSessions(d settingsSessionsData) {
	<section class="card" id="settings-sessions-card">
		<h2>sessions</h2>
		<p class="muted small">Devices logged into your account. Log out anything you don't recognize.</p>
		<ul class="plain" id="settings-sessions-list">
			for _, r := range d.Rows {
				<li id={ "session-" + r.Token }>
					<div class="row">
						<div class="item-meta">
							signed in { web.TimeFmt(d.Timezone, r.CreatedAt) }
							if r.IsCurrent {
								· <span class="badge">this device</span>
							}
						</div>
						<div class="row-actions">
							<button class="link" hx-post={ "/settings/sessions/" + r.Token + "/revoke" } hx-target="#settings-sessions-card" hx-swap="outerHTML">log out</button>
						</div>
					</div>
				</li>
			}
			if len(d.Rows) == 0 {
				<li class="muted small">no active sessions</li>
			}
		</ul>
	</section>
}

templ settingsOpml(d settingsOpmlData) {
	<section class="card" id="settings-opml-card">
		<h2>opml</h2>
		<p class="muted small">Export your subscriptions or import them from another reader. Feed urls that already exist are skipped.</p>
		<div class="row">
			<a class="button" href="/settings/export.opml">export</a>
			<form class="stack" hx-post="/settings/opml" hx-target="#settings-opml-card" hx-swap="outerHTML" enctype="multipart/form-data">
				<label>import file
					<input type="file" name="file" accept=".opml,.xml,application/xml,text/xml"/>
				</label>
				<div id="opml-error" class="error"></div>
				<button type="submit">import</button>
			</form>
		</div>
		if d.Message != "" {
			<p class="muted">{ d.Message }</p>
		}
	</section>
}
