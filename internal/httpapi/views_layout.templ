package httpapi

import (
	"strconv"
	"strings"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ head(title, accent string) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="theme-color" content="#111318"/>
	<meta name="mobile-web-app-capable" content="yes"/>
	<meta name="apple-mobile-web-app-capable" content="yes"/>
	<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
	<meta name="apple-mobile-web-app-title" content="nanoflux"/>
	<link rel="manifest" href="/manifest.webmanifest"/>
	<link rel="apple-touch-icon" href="/static/apple-touch-icon.png"/>
	<title>{ web.PageTitle(title) }</title>
	<link rel="icon" type="image/svg+xml" href={ templ.URL("/favicon.svg?c=" + logoColorParam(accent)) }/>
	<link rel="stylesheet" href={ templ.URL("/static/app.css") }/>
	<script src={ templ.URL("/static/htmx.min.js") } defer></script>
	<script src={ templ.URL("/static/vaadin.bundle.js") } defer></script>
	<script src={ templ.URL("/static/vaadin.js") } defer></script>
	<script src={ templ.URL("/static/home-grid.js") } defer></script>
	<script src={ templ.URL("/static/hls-video.js") } defer></script>
	<script src={ templ.URL("/static/app.js") } defer></script>
	if an := analyticsFrom(ctx); an.Enabled() {
		<script src={ templ.URL("/static/umami.js") } defer></script>
		<script
			src={ templ.URL(an.ScriptURL) }
			data-website-id={ an.WebsiteID }
			data-before-send="nfBeforeSend"
			data-do-not-track="true"
			data-exclude-hash="true"
			if an.HostURL != "" {
				data-host-url={ an.HostURL }
			}
			if an.Tag != "" {
				data-tag={ an.Tag }
			}
			defer
		></script>
	}
}

templ topbar(u store.User) {
	<header class="top">
		<a class="brand" href="/">
			<img class="brand-logo" src={ templ.URL("/logo.svg?c=" + logoColorParam(u.AccentColor)) } alt="" width="20" height="20"/>
			<span>nanoflux</span>
		</a>
		if u.ID != 0 {
			{{ nc := navCountsFrom(ctx) }}
			<nav id="top-nav">
				<div class="top-nav-center">
					if !u.HideUnreadNav {
						<a id="nav-unread" href="/unread">
							unread
							if nc.Unread > 0 && !u.HideUnreadCounts {
								<span id="nav-unread-count" class="nav-count">({ nc.Unread })</span>
							}
						</a>
					}
					<a id="nav-authors" href="/authors">
						authors
						if nc.AuthorsWithUnread > 0 && !u.HideUnreadCounts {
							<span id="nav-authors-count" class="nav-count">({ nc.AuthorsWithUnread })</span>
						}
					</a>
					<a href="/collections">collections</a>
					<a href="/lists">lists</a>
					if d := demoFrom(ctx); d.Active {
						<div class="demo-badge" id="demo-countdown" data-expires={ d.ExpiresAt } title="this demo account is temporary">
							<span class="demo-badge-dot"></span>demo · <span id="demo-countdown-time">--:--</span>
						</div>
					}
				</div>
				<div class="top-nav-right">
					<form class="top-search" action="/search" method="get" role="search">
						<input id="search-input" name="q" type="search" placeholder="search…" autocomplete="off"/>
					</form>
					<div class="add-menu">
						<button type="button" class="add-primary" data-action="addFeed">+ add feed</button>
						<button type="button" class="add-caret" id="add-menu-btn" aria-haspopup="true" aria-expanded="false" title="more add actions" onclick="toggleAddMenu(event)">@web.Lucide("chevron-down")</button>
						<div id="add-menu-pop" class="menu-pop" role="menu" hidden>
							<button type="button" class="link menu-item" role="menuitem" data-action="savePage">save url for later</button>
							for _, p := range provisionersFrom(ctx) {
								<button type="button" class="link menu-item" role="menuitem" data-action="provision" data-plugin={ p.Name } data-label={ p.Label }>Add a { p.Label }</button>
							}
							<button type="button" class="link menu-item" role="menuitem" data-action="addAuthor">add author</button>
							<button type="button" class="link menu-item" role="menuitem" data-action="addCollection">add collection</button>
							<button type="button" class="link menu-item" role="menuitem" data-action="addList">add list</button>
						</div>
					</div>
					<div class="user-menu">
						<button type="button" id="user-menu-btn" class="avatar-btn" aria-haspopup="true" aria-expanded="false" title={ u.Username } onclick="toggleUserMenu(event)">
							if u.HasAvatar {
								<img class="avatar avatar-sm" src={ templ.URL("/avatar") } alt={ u.Username }/>
							} else {
								<span class="avatar avatar-sm avatar-default">{ web.Initial(u.Username) }</span>
							}
						</button>
<div id="user-menu" class="user-menu-pop" role="menu" hidden>
							if u.HideUnreadNav {
								<a id="nav-unread" href="/unread" role="menuitem">
									unread
									if nc.Unread > 0 && !u.HideUnreadCounts {
										<span id="nav-unread-count" class="nav-count">({ nc.Unread })</span>
									}
								</a>
							}
							<a href="/read" role="menuitem">history</a>
							<a href="/favorites" role="menuitem">favorites</a>
							<a href="/bookmarks" role="menuitem">bookmarks</a>
							if u.IsAdmin {
								<a href="/admin" role="menuitem">admin</a>
							}
							<a href="/settings" role="menuitem">settings</a>
							<form action="/logout" method="post"><button class="link menu-item" type="submit">log out</button></form>
						</div>
					</div>
				</div>
			</nav>
			<button type="button" id="nav-toggle" class="hamburger" aria-label="menu" aria-expanded="false" aria-controls="top-nav" onclick="toggleNav(event)">
				<span></span>
				<span></span>
				<span></span>
			</button>
		}
	</header>

	<dialog id="item-dialog" class="modal wide">
		<div class="item-dialog-head">
			<div id="item-dialog-controls"></div>
			<button type="button" class="link" title="close" onclick="document.getElementById('item-dialog').close()">@web.Lucide("x")</button>
		</div>
		<div id="item-dialog-body" class="item-view" tabindex="0"></div>
		<div class="item-dialog-foot">
			<button type="button" id="item-prev" title="previous item" aria-label="previous item" onclick="itemNav(-1)">@web.Lucide("chevron-left")<span>previous</span></button>
			<button type="button" id="item-next" title="next item" aria-label="next item" onclick="itemNav(1)"><span>next</span>@web.Lucide("chevron-right")</button>
		</div>
	</dialog>

	<!-- Shared add-to-list picker; the item's "⋯" menu fetches its content into
	     this dialog (itemListsDialogInner) before showing it. -->
	<dialog id="item-lists-dialog" class="modal"></dialog>

	<!-- Save-page dialog; the nav "add" menu fetches its content (savePageForm)
	     into this dialog before showing it. -->
	<dialog id="save-page-dialog" class="modal"></dialog>

	<!-- Provision dialog; the nav "add" menu's "Add a …" entry fetches a
	     provisioning plugin's create form into this dialog. -->
	<dialog id="provision-dialog" class="modal">
		<div class="row">
			<h2 id="provision-dialog-title">create a feed</h2>
			<button type="button" class="link" title="close" onclick="document.getElementById('provision-dialog').close()">@web.Lucide("x")</button>
		</div>
		<div id="provision-dialog-body"></div>
	</dialog>

	<!-- Plugin docs dialog; the admin plugin card and the feed edit page fetch
	     a plugin's documentation (plugin-docs-dialog) into it before showing. -->
	<dialog id="plugin-docs-dialog" class="modal wide"></dialog>

	<!-- Command palette (ctrl/cmd+p) and unified entity search
	     (ctrl/cmd+shift+p). Both are filled client-side by app.js. -->
	<dialog id="command-palette" class="palette">
		<input id="command-input" type="text" placeholder="run a command…" autocomplete="off" spellcheck="false"/>
		<ul id="command-results" class="palette-results" role="listbox"></ul>
	</dialog>

	<dialog id="entity-palette" class="palette">
		<input id="entity-input" type="text" placeholder="search… @ authors  # collections  ! feeds" autocomplete="off" spellcheck="false"/>
		<ul id="entity-results" class="palette-results" role="listbox"></ul>
	</dialog>

	<dialog id="shortcuts-dialog" class="modal">
		<div class="row">
			<h2 class="muted">keyboard shortcuts</h2>
			<button type="button" class="link" onclick="document.getElementById('shortcuts-dialog').close()">@web.Lucide("x")</button>
		</div>
		@shortcutsTable()
	</dialog>
}

// shortcutsTable lists every key binding wired up in static/app.js. It's
// shared by the "?" help sheet and the settings page so the two stay in sync.
templ shortcutsTable() {
	<table class="shortcuts">
		<tr><td>j / k</td><td>next / previous item</td></tr>
		<tr><td>o / Enter</td><td>open item</td></tr>
		<tr><td>v</td><td>open original in a new tab</td></tr>
		<tr><td>s</td><td>favorite / unfavorite</td></tr>
		<tr><td>m</td><td>mark read / unread</td></tr>
		<tr><td>g / G</td><td>first / last item</td></tr>
		<tr><td>← / →</td><td>previous / next while reading</td></tr>
		<tr><td>/</td><td>focus the search box</td></tr>
		<tr><td>ctrl/⌘ + p</td><td>command palette</td></tr>
		<tr><td>ctrl/⌘ + shift + p</td><td>search authors, collections, feeds</td></tr>
		<tr><td>?</td><td>toggle this list</td></tr>
		<tr><td>Esc</td><td>close dialog</td></tr>
	</table>
}

// basePage renders a full HTML document: head, topbar, and the page content.
// The data-theme attribute on <html> selects the CSS variable set in app.css;
// "system" is resolved client-side via prefers-color-scheme. A per-user accent
// color (stored as "#rrggbb") is applied inline as --accent so it overrides
// both theme palettes; when unset the stylesheet's default is used.
templ basePage(title string, u store.User, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ u.Theme }
		if s := appearanceStyle(u); s != "" {
			style={ s }
		}>
		<head>
			@head(title, u.AccentColor)
		</head>
		<body data-admin={ strconv.FormatBool(u.IsAdmin) } class={ templ.KV("hide-counts", u.HideUnreadCounts) }>
			@topbar(u)
			<main>
				@content
			</main>
		</body>
	</html>
}

// appearanceStyle builds the inline CSS custom properties on <html>: the
// per-user accent color (omitted when unset, so the stylesheet default applies,
// e.g. on anonymous share pages) and the grid column cap.
func appearanceStyle(u store.User) string {
	var b strings.Builder
	if u.AccentColor != "" {
		b.WriteString("--accent: ")
		b.WriteString(u.AccentColor)
		b.WriteString(";")
	}
	b.WriteString("--grid-columns: ")
	b.WriteString(strconv.Itoa(store.ClampGridColumns(u.GridMaxColumns)))
	return b.String()
}

// FormError is the shared user-facing error banner (role="alert").
templ FormError(msg string) {
	<div class="error" role="alert">{ msg }</div>
}

// FormErrorOOB renders an error into a named slot via an htmx out-of-band
// swap, keeping the surrounding form untouched.
templ FormErrorOOB(target, msg string) {
	<div id={ target } hx-swap-oob="innerHTML">
		<div class="error" role="alert">{ msg }</div>
	</div>
}

// footer is the small site footer shown at the bottom of the login and settings
// pages: the project's website and source, its open source license, and a
// ko-fi tip link.
templ footer() {
	<footer class="site-foot">
		<a href="https://nanoflux.app" class="external" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">nanoflux.app</a>
		· <a href="https://github.com/metruzanca/nanoflux" class="external" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">github</a>
		· open source
		<div class="kofi">
			<a href="https://ko-fi.com/C1C51JBGUD" class="external" target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"><img src="https://storage.ko-fi.com/cdn/kofi3.png?v=6" alt="Buy me a coffee at ko-fi.com" height="36" style="border:0;height:36px;"/></a>
		</div>
	</footer>
}