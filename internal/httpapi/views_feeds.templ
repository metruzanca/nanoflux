package httpapi

import (
	"strconv"
	"strings"

	"github.com/metruzanca/nanoflux/internal/filtermatch"
	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ FeedsList(rows []feedRow) {
	<ul class="plain" id="feeds-list">
		for _, r := range rows {
			@FeedRow(r)
		}
	</ul>
}

// FeedRow is a feed as it appears on the author page's feed list (and the
// fragments that append to it). It is deliberately read-only: editing and
// refreshing live on the feed's own page, and the link points at the feed's
// home site rather than its feed URL, which is what a reader wants to visit.
templ FeedRow(r feedRow) {
	<li id={ "feed-" + strconv.FormatInt(r.ID, 10) }>
		<div>
			<a href={ "/feeds/" + strconv.FormatInt(r.ID, 10) }>
				<strong>
					@web.SourceIcon(feedIconURL(r.Feed))
					{ r.Title }
				</strong>
			</a>
			if !r.Enabled {
				if r.DisabledReason != "" {
					<span class="badge danger" title={ r.DisabledReason }>disabled · { r.DisabledReason }</span>
				} else {
					<span class="badge">paused</span>
				}
			}
			if r.LastError != "" {
				<span class="badge danger" title={ r.LastError }>last poll failed</span>
			}
			if r.Cooling() {
				<span class="badge warn" title="a rate limit asked us to wait before retrying">rate limited · retry { web.Until(r.NextPollAt) }</span>
			}
			@staleBadge(r.Feed, r.Timezone)
			<div class="item-meta">
				if home := strings.TrimSpace(r.HomeURL); home != "" {
					<a href={ templ.URL(home) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">home</a>
				} else {
					<a href={ templ.URL(r.FeedURL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">feed</a>
				}
				· { r.Unread } unread · last polled 
				if r.LastPolledAt != "" {
					{ web.TimeFmt(r.Timezone, r.LastPolledAt) }
				} else {
					never
				}
			</div>
			if len(r.Collections) > 0 {
				<div class="feed-collections">
					for _, c := range r.Collections {
						<a class="tag" href={ "/collections/" + strconv.FormatInt(c.ID, 10) } title={ c.Name }>#{ c.Name }</a>
					}
				</div>
			}
		</div>
	</li>
}

// staleBadge is the amber "no new posts in a while" marker on a feed row. It
// is intentionally distinct from the red "last poll failed" error: there is no
// failure, just no recent updates. Appears on the author page, /feeds,
// collections, and feed rows after refresh (FeedRow is shared).
templ staleBadge(f store.Feed, tz string) {
	if sf, ok := web.StaleFeedFor(f.LastItemAt); ok {
		<span class="badge warn" title={ "newest post " + web.TimeFmt(tz, f.LastItemAt) }>
			if sf.Abandoned {
				quiet { sf.Days }d · may be abandoned
			} else {
				no new posts in { sf.Days }d
			}
		</span>
	}
}

// feedPreviewFields is the combined add form: an author and their first feed
// together. In the global flow (authors page) the author select defaults to a
// new author pre-filled from discovery; on an author page the author is fixed
// and only the feed fields render.
templ feedPreviewFields(d feedPreviewForm) {
	<form class="stack" hx-post={ d.Action } hx-target={ d.Target } hx-swap={ d.Swap } data-form-close-reset>
		if d.Redirect {
			<input type="hidden" name="redirect" value="1"/>
		}
		<label>
			title
			<input name="title" type="text" value={ d.Title }/>
		</label>
		<label>
			feed url
			<input name="feed_url" type="text" value={ d.FeedURL } required/>
		</label>
		<label>
			home url
			<input id="feed-home-url" name="home_url" type="url" value={ d.HomeURL }/>
		</label>
		if d.FixedAuthor != nil {
			<input type="hidden" name="author_id" value={ strconv.FormatInt(d.FixedAuthor.ID, 10) }/>
			<p class="muted small">author · { d.FixedAuthor.Name }</p>
		} else {
			@comboSelect("author_id", authorValue(d.SelectedAuthorID), "author", "search authors", authorItems(d.Authors), templ.Attributes{
				"hx-get":     "/fragments/author-form",
				"hx-target":  "#new-author",
				"hx-swap":    "innerHTML",
				"hx-trigger": "change",
				"hx-include": "#feed-home-url",
			})
			<div id="new-author">
				if d.SelectedAuthorID == 0 {
					@authorCreateFields(d.newAuthor())
				}
			</div>
		}
		<div id="add-feed-error" class="error"></div>
		<button type="submit">add</button>
	</form>
}

// manualFeedButton is the "add manually" action shown next to "find feed". It
// posts the entered url to the manual-feed fragment, which swaps the combined
// add form into target pre-filled with that url as the feed url. Use it when the
// user already knows the feed url and discovery would just be an extra step.
templ manualFeedButton(target string) {
	<button type="button" hx-post="/fragments/manual-feed" hx-target={ target } hx-swap="innerHTML" hx-include="#feed-url-input, #feed-author-id, #feed-author-scoped, #share-url">add manually</button>
}

templ feedChooser(d feedChoose) {
	<form class="choose stack" hx-post="/fragments/feed-preview" hx-target={ d.Target } hx-swap="innerHTML" hx-include="#feed-url-input, #feed-author-id, #feed-author-scoped, #feed-redirect">
		<p class="muted">found { len(d.Candidates) } feeds on that page — pick one</p>
		if d.Redirect {
			<input type="hidden" id="feed-redirect" name="redirect" value="1"/>
		}
		@comboSelect("feed_url", candidateValue(d.Candidates), "", "search feeds", candidateItems(d.Candidates), templ.Attributes{
			"hx-post":   "/fragments/feed-preview",
			"hx-target": d.Target,
			"hx-swap":   "innerHTML",
			"hx-include": "#feed-url-input, #feed-author-id, #feed-author-scoped, #feed-redirect",
		})
		<button type="submit">use this feed</button>
	</form>
}

// noFeedFound is the "no feed at that url" banner with a manual-entry escape
// hatch. The button re-posts the entered url to its fragment handler, which
// swaps the combined add form into the same preview container. Reason carries a
// user-facing explanation when discovery failed for a detectable cause (e.g. an
// HTTP 429 rate limit).
templ noFeedFound(d noFeedFoundData) {
	<div class="error" role="alert">
		<p>no feed found at that url</p>
		if d.Reason != "" {
			<p class="small">{ d.Reason }</p>
		}
		<div class="row">
			@manualFeedButton(d.Target)
		</div>
	</div>
}

templ feedEditPage(u store.User, d feedsData) {
	<section class="card">
		<h1>edit feed</h1>
		<form class="stack" method="post" action={ "/feeds/" + strconv.FormatInt(d.Form.ID, 10) + "/edit" }>
			@csrfField()
			@feedFields(d)
			<button type="submit">save</button>
		</form>
		<form class="stack delete-form" method="post" action={ "/feeds/" + strconv.FormatInt(d.Form.ID, 10) + "/delete" } data-confirm="delete this feed?">
			@csrfField()
			if d.Panel != nil {
				<label class="check">
					<input type="checkbox" name="delete_remote" value="1"/>
					also delete it on the remote service
				</label>
			}
			<button type="submit" class="danger">delete</button>
		</form>
	</section>
	if d.Panel != nil {
		@feedPluginPanel(*d.Panel)
	}
	@feedRulesSection(d.Rules)
}

templ feedRulesSection(d feedRulesData) {
	<section class="card" id="feed-rules">
		<div class="row">
			<h2>filters</h2>
			if d.DocsPlugin != "" {
				<button type="button" class="link" data-plugin={ d.DocsPlugin } title="read this feed's plugin documentation" data-plugin-docs>plugin docs</button>
			}
		</div>
		{{ modeURL := "/feeds/" + strconv.FormatInt(d.FeedID, 10) + "/filter-mode" }}
		<div class="row">
			@PickerControl("filter-mode", "how the rules are applied", d.Mode, "", []pickerOption{
				{Value: filtermatch.ModeBlock, Label: "block list", HxPost: modeURL, HxVals: `{"mode":"block"}`, HxTarget: "#feed-rules"},
				{Value: filtermatch.ModeAllow, Label: "allow list", HxPost: modeURL, HxVals: `{"mode":"allow"}`, HxTarget: "#feed-rules", HxConfirm: "switch to allow list? items matching no rule are removed from this feed."},
			})
			<span class="muted small">
				if d.Mode == filtermatch.ModeAllow {
					keep only items matching a rule
				} else {
					act on items matching a rule
				}
			</span>
		</div>
		if d.Mode == filtermatch.ModeAllow {
			<p class="muted small">Rules run against new items when the feed is polled and are applied to this feed's existing items when added. In <strong>allow list</strong> mode an item is kept only when it matches at least one rule; items matching none are removed. The rule action is ignored here. The "category" field matches any feed-provided category, e.g. <code>r/golang</code> or <code>u/someuser</code>.</p>
			if len(d.Rows) == 0 {
				<p class="notice small">No allow rules yet, so every item is currently kept. Add a rule to start filtering.</p>
			}
		} else {
			<p class="muted small">Rules run against new items when the feed is polled and are applied to this feed's existing items when added. "delete" removes matching items from this feed; "mark read" stores them as already read. Switch to <strong>allow list</strong> to keep only items that match a rule. The "category" field matches any feed-provided category, e.g. <code>r/golang</code> or <code>u/someuser</code>.</p>
		}
		<form class="stack" hx-post={ "/feeds/" + strconv.FormatInt(d.FeedID, 10) + "/filters/preview" } hx-target="#filter-preview-dialog" hx-swap="innerHTML" data-after-show="filter-preview-dialog">
			<div class="row">
				if d.Mode != filtermatch.ModeAllow {
					@comboSelect("action", "delete", "action", "", filterActionItems, nil)
				}
				@comboSelect("field", "title", "field", "", filterFieldItems, nil)
				<label>
					pattern
					<input name="pattern" type="text" placeholder="e.g. sponsored" required/>
				</label>
				@switchField("is_regex", "regex", false, nil)
			</div>
			<div id="feed-rules-error" class="error"></div>
			<button type="submit">add rule</button>
		</form>
		@FilterList(d.FeedID, d.Mode, d.Rows)
		<!-- The preview dialog lives inside the section so saving a rule (which
		     swaps #feed-rules outerHTML) removes the open dialog with it. -->
		<dialog id="filter-preview-dialog" class="modal filter-preview-dialog"></dialog>
	</section>
}

// filterPreviewData is the preview modal's content: the pending rule, the items
// it would keep, and the items it would affect (deleted or marked read),
// truncated to PageSize per section (counts are the true totals).
type filterPreviewData struct {
	FeedID   int64
	Mode     string
	Rule     filterRuleInput
	Keep     []store.ItemWithFeed
	Affected []store.ItemWithFeed
	PageSize int
}

func filterPreviewAffectedTitle(mode, action string) string {
	if filtermatch.NormalizeMode(mode) == filtermatch.ModeAllow {
		return "remove (matches no rule)"
	}
	if action == filtermatch.ActionMarkRead {
		return "mark read"
	}
	return "delete"
}

// filterPreview is the confirmation modal shown when a rule is added: it lists
// what stays and what changes before anything is saved. The rule's hidden fields
// are posted to /feeds/{id}/filters by the save button; cancel and Esc abort.
templ filterPreview(d filterPreviewData) {
	<div class="row">
		<h2>
			if d.Mode == filtermatch.ModeAllow {
				add allow rule: { d.Rule.Field } <code>{ d.Rule.Pattern }</code>
			} else {
				add filter: { d.Rule.Action } { d.Rule.Field } <code>{ d.Rule.Pattern }</code>
			}
		</h2>
		<button type="button" class="link" title="close" data-close-dialog>@web.Lucide("x")</button>
	</div>
	<p class="muted small">applies to this feed's existing items now, and to new items when polled.</p>
	<div class="filter-preview-cols">
		<section>
			<h3>keep ({ len(d.Keep) })</h3>
			@previewItems(d.Keep, d.PageSize)
		</section>
		<section>
			<h3>{ filterPreviewAffectedTitle(d.Mode, d.Rule.Action) } ({ len(d.Affected) })</h3>
			@previewItems(d.Affected, d.PageSize)
		</section>
	</div>
	<div class="row-actions">
		<button type="button" class="link" autofocus data-close-dialog>cancel</button>
		<form hx-post={ "/feeds/" + strconv.FormatInt(d.FeedID, 10) + "/filters" } hx-target="#feed-rules" hx-swap="outerHTML">
			<input type="hidden" name="action" value={ d.Rule.Action }/>
			<input type="hidden" name="field" value={ d.Rule.Field }/>
			<input type="hidden" name="pattern" value={ d.Rule.Pattern }/>
			if d.Rule.IsRegex {
				<input type="hidden" name="is_regex" value="1"/>
			}
			<button type="submit">save filter</button>
		</form>
	</div>
}

// previewItems renders a preview column's items as a plain list, capped at
// pageSize, with a "showing X of Y" note when truncated. Rows are simplified
// (no favorite/read/⋯ controls, whose htmx targets assume a live list) and link
// to the item modal in a new tab so the pending rule form is not lost.
templ previewItems(items []store.ItemWithFeed, pageSize int) {
	if len(items) == 0 {
		<p class="muted small">none</p>
	} else {
		<ul class="plain filter-preview-items">
			for i, it := range items {
				if i >= pageSize {
					break
				}
				<li>
					<a href={ templ.URL("/#item-" + strconv.FormatInt(it.ID, 10)) } target="_blank" rel="noopener">{ it.Title }</a>
					<div class="item-meta">
						@web.SourceIcon(itemIconURL(it))
						<span>{ it.FeedTitle }</span>
						if it.PublishedAt != "" {
							· { web.TimeFmt(it.Timezone, it.PublishedAt) }
						}
					</div>
				</li>
			}
		</ul>
		if len(items) > pageSize {
			<p class="muted small">showing { pageSize } of { len(items) }</p>
		}
	}
}

templ FilterList(feedID int64, mode string, rows []store.Filter) {
	<ul class="plain" id="feed-filters-list">
		for _, r := range rows {
			<li id={ "filter-" + strconv.FormatInt(r.ID, 10) }>
				<div class="row">
					<span class="muted small">
						if filtermatch.NormalizeMode(mode) == filtermatch.ModeAllow {
							keep · { r.Field } · <code>{ r.Pattern }</code>
						} else {
							{ r.Action } · { r.Field } · <code>{ r.Pattern }</code>
						}
						if r.IsRegex {
							· regex
						}
					</span>
					<button class="link danger" title="delete rule" hx-post={ "/filters/" + strconv.FormatInt(r.ID, 10) + "/delete" } hx-target="#feed-filters-list" hx-swap="outerHTML" hx-confirm="delete this rule?">@web.Lucide("x")
</button>
				</div>
			</li>
		}
		if len(rows) == 0 {
			<li class="muted small">no rules yet</li>
		}
	</ul>
}

templ feedFields(d feedsData) {
	@switchField("enabled", "enabled (poll this feed)", d.Form.Enabled, nil)
	@switchField("cache_images", "cache images locally", d.Form.CacheImages || d.Form.CacheForced, nil)
	if d.Form.CacheForced {
		<p class="muted small">on for this site: its plugin serves image links that expire, so nanoflux keeps a copy. it cannot be turned off.</p>
	} else {
		<p class="muted small">download this feed's images into nanoflux so they keep working if the site's image links expire.</p>
	}
	<label>
		title
		<input name="title" value={ d.Form.Title } required/>
	</label>
	<label>
		feed url
		<input name="feed_url" type="text" value={ d.Form.FeedURL } required/>
	</label>
	<label>
		home url
		<input name="home_url" type="url" value={ d.Form.HomeURL }/>
	</label>
	@comboSelect("author_id", authorValue(d.Form.AuthorID), "author", "search authors", authorItems(d.Authors), templ.Attributes{
		"hx-get":     "/fragments/author-form",
		"hx-target":  "#new-author",
		"hx-swap":    "innerHTML",
		"hx-trigger": "change",
	})
	<div id="new-author"></div>
	@switchField("poll_interval_auto", "auto-adjust poll interval", d.Form.PollIntervalAuto, nil)
	<label>
		poll interval (seconds) — used when auto-adjust is off
		<input name="poll_interval_sec" type="number" value={ strconv.Itoa(d.Form.PollIntervalSec) } min="60"/>
	</label>
	if len(d.Collections) > 0 {
		@comboMulti("collections", "collections", nonAutoCollectionValues(d.Collections, d.Form.CollectionIDs), nonAutoCollections(d.Collections))
	}
}

templ feedPage(u store.User, d feedPageData) {
	<section class="card">
		<div class="row">
			<h1>
				@web.SourceIcon(feedIconURL(d.Row.Feed))
				{ d.Row.Title }
			</h1>
			<div class="row-actions">
				<a class="small" title="edit" href={ "/feeds/" + strconv.FormatInt(d.Row.ID, 10) + "/edit" }>@web.EditIcon()
</a>
				<button
					class="link"
					title="refresh"
					hx-post={ "/feeds/" + strconv.FormatInt(d.Row.ID, 10) + "/refresh" }
					hx-swap="none"
					data-reload-on-success
					if d.Row.Cooling() {
						disabled
					}
				>@web.Lucide("refresh-cw")
</button>
				@markAllReadControl(d.MarkAll)
			</div>
		</div>
		<p class="item-meta">
			if d.Row.AuthorName != "" {
				<a href={ "/authors/" + strconv.FormatInt(d.Row.AuthorID, 10) }>{ d.Row.AuthorName }</a> ·
			} else {
				no author ·
			}
			<a href={ templ.URL(d.Row.FeedURL) } class="external" referrerpolicy="no-referrer">feed</a>
			if d.Row.HomeURL != "" {
				· <a href={ templ.URL(d.Row.HomeURL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">home</a>
			}
		</p>
		<p class="muted small">
			{ d.Row.Unread } unread · last polled 
			if d.Row.LastPolledAt != "" {
				{ web.TimeFmt(d.Row.Timezone, d.Row.LastPolledAt) }
			} else {
				never
			}
		</p>
		if d.Row.LastError != "" {
			<div class="error" role="alert">last poll failed: { d.Row.LastError }</div>
		}
		if d.Row.Cooling() {
			<div class="notice">rate limited · retry { web.Until(d.Row.NextPollAt) }</div>
		}
		if sf, ok := web.StaleFeedFor(d.Row.LastItemAt); ok {
			<div class="notice">
				if sf.Abandoned {
					no new posts in { sf.Days } days · this account may be abandoned
				} else {
					no new posts in { sf.Days } days
				}
			</div>
		}
		if d.Row.NextPageURL != "" {
			@feedOlderControl(d.Row)
		}
	</section>
	<h2>items</h2>
	@ScopedItems(d.Scoped)
}

// feedOlderControl is the "load older items" control for a paginated feed. It
// is the htmx swap target for POST /feeds/{id}/older: the response replaces it
// (button advances to the next page, or becomes a "history complete" note once
// pages run out) and out-of-band swaps the item list.
templ feedOlderControl(f feedRow) {
	<div id="feed-older">
		if f.NextPageURL != "" {
			<button class="link" hx-post={ "/feeds/" + strconv.FormatInt(f.ID, 10) + "/older" } hx-target="#feed-older" hx-swap="outerHTML">load older items</button>
		} else {
			<span class="muted small">full history loaded</span>
		}
	</div>
}

