package httpapi

import (
	"strconv"
	"strings"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ FeedsList(rows []feedRow) {
	<ul class="feed-cards" id="feeds-list">
		for _, r := range rows {
			@FeedRow(r)
		}
	</ul>
}

// FeedRow is one of an author's feeds as a card: the link to the feed's scoped
// item list, the refresh action, the external feed/home link, the last-polled
// line and the cached-media stat. It is the htmx swap target for the add /
// refresh / toggle fragments, which re-render a single row. Editing a feed and
// marking it read live on the author edit page / the author card's filter-aware
// mark-all, not here.
templ FeedRow(r feedRow) {
	{{ id := strconv.FormatInt(r.ID, 10) }}
	{{ authorID := strconv.FormatInt(r.AuthorID, 10) }}
	{{ feedURL := "/authors/" + authorID + "?feed=" + id }}
	<li id={ "feed-" + id } class="feed-card-item">
		<div class="card feed-card">
			<div class="feed-card-main">
				<div class="feed-card-title">
					<a href={ templ.URL(feedURL) }>
						<strong>
							@web.SourceIcon(feedIconURL(r.Feed))
							{ r.Title }
						</strong>
					</a>
					if !r.Enabled {
						if r.DisabledReason != "" {
							<span class="badge danger" title={ r.DisabledReason }>disabled · { r.DisabledReason }</span>
						} else {
							<span class="badge">paused</span>
						}
					}
					if r.LastError != "" {
						<span class="badge danger" title={ r.LastError }>last poll failed</span>
					}
					if r.Cooling() {
						<span class="badge warn" title="a rate limit asked us to wait before retrying">rate limited · retry { web.Until(r.NextPollAt) }</span>
					}
					@staleBadge(r.Feed, r.Timezone)
				</div>
				<div class="item-meta">
					if home := strings.TrimSpace(r.HomeURL); home != "" {
						<a href={ templ.URL(home) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">home</a>
					} else {
						<a href={ templ.URL(r.FeedURL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">feed</a>
					}
					· { r.Unread } unread · last polled 
					if r.LastPolledAt != "" {
						{ web.TimeFmt(r.Timezone, r.LastPolledAt) }
					} else {
						never
					}
					if r.Storage > 0 {
						· cached media { web.FormatBytes(r.Storage) }
					}
				</div>
				if r.LastError != "" {
					<p class="feed-card-error" title={ r.LastError }>{ r.LastError }</p>
				}
			</div>
			<div class="feed-card-side">
				<div class="row-actions">
					<button
						class="link"
						title="refresh"
						hx-post={ "/feeds/" + id + "/refresh" }
						hx-target={ "#feed-" + id }
						hx-swap="outerHTML"
						if r.Cooling() {
							disabled
						}
					>@web.Lucide("refresh-cw")</button>
				</div>
				if len(r.Collections) > 0 {
					<div class="feed-collections">
						for _, c := range r.Collections {
							<a class="tag" href={ "/collections/" + strconv.FormatInt(c.ID, 10) } title={ c.Name }>#{ c.Name }</a>
						}
					</div>
				}
			</div>
		</div>
	</li>
}

// staleBadge is the amber "no new posts in a while" marker on a feed row. It
// is intentionally distinct from the red "last poll failed" error: there is no
// failure, just no recent updates. Appears on the author page, /feeds,
// collections, and feed rows after refresh (FeedRow is shared).
templ staleBadge(f store.Feed, tz string) {
	if sf, ok := web.StaleFeedFor(f.LastItemAt, f.PollIntervalSec); ok {
		<span class="badge warn" title={ "newest post " + web.TimeFmt(tz, f.LastItemAt) }>
			if sf.Abandoned {
				quiet { sf.Days }d · may be abandoned
			} else {
				no new posts in { sf.Days }d
			}
		</span>
	}
}

// feedPreviewFields is the combined add form: an author and their first feed
// together. In the global flow (authors page) the author select defaults to a
// new author pre-filled from discovery; on an author page the author is fixed
// and only the feed fields render.
templ feedPreviewFields(d feedPreviewForm) {
	<form class="stack" hx-post={ d.Action } hx-target={ d.Target } hx-swap={ d.Swap } data-form-close-reset>
		if d.Redirect {
			<input type="hidden" name="redirect" value="1"/>
		}
		<label>
			title
			<input name="title" type="text" value={ d.Title }/>
		</label>
		<label>
			feed url
			<input name="feed_url" type="text" value={ d.FeedURL } required/>
		</label>
		<label>
			home url
			<input id="feed-home-url" name="home_url" type="url" value={ d.HomeURL }/>
		</label>
		if d.FixedAuthor != nil {
			<input type="hidden" name="author_id" value={ strconv.FormatInt(d.FixedAuthor.ID, 10) }/>
			<p class="muted small">author · { d.FixedAuthor.Name }</p>
		} else {
			@comboSelect("author_id", authorValue(d.SelectedAuthorID), "author", "search authors", authorItems(d.Authors), templ.Attributes{
				"hx-get":     "/fragments/author-form",
				"hx-target":  "#new-author",
				"hx-swap":    "innerHTML",
				"hx-include": "#feed-home-url",
			})
			<div id="new-author">
				if d.SelectedAuthorID == 0 {
					@authorCreateFields(d.newAuthor())
				}
			</div>
		}
		<div id="add-feed-error" class="error"></div>
		<button type="submit">add</button>
	</form>
}

// manualFeedButton is the "add manually" action shown next to "find feed". It
// posts the entered url to the manual-feed fragment, which swaps the combined
// add form into target pre-filled with that url as the feed url. Use it when the
// user already knows the feed url and discovery would just be an extra step.
templ manualFeedButton(target string) {
	<button type="button" hx-post="/fragments/manual-feed" hx-target={ target } hx-swap="innerHTML" hx-include="#feed-url-input, #feed-author-id, #feed-author-scoped, #share-url" hx-vals={ `{"preview_target":"` + target + `"}` }>add manually</button>
}

templ feedChooser(d feedChoose) {
	<form class="choose stack" hx-post="/fragments/feed-preview" hx-target={ d.Target } hx-swap="innerHTML" hx-include="#feed-url-input, #feed-author-id, #feed-author-scoped, #feed-redirect, #feed-preview-target">
		<p class="muted">found { len(d.Candidates) } feeds on that page — pick one</p>
		<input type="hidden" id="feed-preview-target" name="preview_target" value={ d.Target }/>
		if d.Redirect {
			<input type="hidden" id="feed-redirect" name="redirect" value="1"/>
		}
		@comboSelect("feed_url", candidateValue(d.Candidates), "", "search feeds", candidateItems(d.Candidates), templ.Attributes{
			"hx-post":   "/fragments/feed-preview",
			"hx-target": d.Target,
			"hx-swap":   "innerHTML",
			"hx-include": "#feed-url-input, #feed-author-id, #feed-author-scoped, #feed-redirect, #feed-preview-target",
		})
		<button type="submit">use this feed</button>
	</form>
}

// noFeedFound is the "no feed at that url" banner with a manual-entry escape
// hatch. The button re-posts the entered url to its fragment handler, which
// swaps the combined add form into the same preview container. Reason carries a
// user-facing explanation when discovery failed for a detectable cause (e.g. an
// HTTP 429 rate limit).
templ noFeedFound(d noFeedFoundData) {
	<div class="error" role="alert">
		<p>no feed found at that url</p>
		if d.Reason != "" {
			<p class="small">{ d.Reason }</p>
		}
		<div class="row">
			@manualFeedButton(d.Target)
		</div>
	</div>
}

// feedAccordionItem is one feed panel in the author edit page's sources
// accordion. A selected panel renders its form inline; the rest lazy-load it
// the first time they are opened.
templ feedAccordionItem(r feedRow, editor *feedsData) {
	{{ id := strconv.FormatInt(r.ID, 10) }}
	{{ selected := editor != nil && editor.Form.ID == r.ID }}
	<details class="feed-accordion-item" name="author-sources" id={ "feed-acc-" + id } if selected { open }>
		@feedAccordionBody(r, editor)
	</details>
}

// feedAccordionBody is the inside of one feed's accordion item: its summary and
// editor. Auto-saves swap only this body, never the <details> itself, so the
// panel keeps its open state (replacing an open named <details> makes the
// browser close the replacement during htmx's insert-before-remove swap).
templ feedAccordionBody(r feedRow, editor *feedsData) {
	{{ id := strconv.FormatInt(r.ID, 10) }}
	{{ selected := editor != nil && editor.Form.ID == r.ID }}
	<summary>
		@web.SourceIcon(feedIconURL(r.Feed))
		<span class="feed-accordion-title">{ r.Title }</span>
		if !r.Enabled {
			if r.DisabledReason != "" {
				<span class="badge danger" title={ r.DisabledReason }>disabled</span>
			} else {
				<span class="badge">paused</span>
			}
		}
		if r.LastError != "" {
			<span id={ "feed-error-badge-" + id } class="badge danger" title={ r.LastError }>last poll failed</span>
		}
		if r.Cooling() {
			<span class="badge warn" title="a rate limit asked us to wait before retrying">rate limited</span>
		}
	</summary>
	if selected {
		<div class="feed-accordion-body">@feedEditorPanel(*editor)</div>
	} else {
		<div class="feed-accordion-body" hx-get={ "/feeds/" + id + "/edit-fragment" } hx-trigger="toggle from:closest details once" hx-swap="innerHTML">
			<p class="muted small">loading…</p>
		</div>
	}
}

// feedEditorPanel wraps one feed's settings in its own auto-saving form. The
// form swaps the accordion item's contents so the summary title and badges
// update too, without replacing the <details> that holds the open state. The
// delete block stays outside the form so its remote checkbox does not trigger
// an auto-save.
templ feedEditorPanel(d feedsData) {
	{{ id := strconv.FormatInt(d.Form.ID, 10) }}
	<form class="stack" method="post" action={ "/feeds/" + id + "/edit" } hx-post={ "/feeds/" + id + "/edit" } hx-trigger="change delay:600ms, submit" hx-sync="closest form:replace" hx-target={ "#feed-acc-" + id } hx-swap="innerHTML" hx-disinherit="*" data-autosave>
		@csrfField()
		@feedEditorBody(d)
	</form>
	@feedDeleteBlock(d)
}

// feedDeleteBlock is the feed's destructive action, kept outside the
// auto-saving form.
templ feedDeleteBlock(d feedsData) {
	{{ id := strconv.FormatInt(d.Form.ID, 10) }}
	<div class="stack delete-form">
		if d.Panel != nil {
			<label class="check">
				<input type="checkbox" name={ "delete_remote_" + id } value="1"/>
				also delete it on the remote service
			</label>
		}
		<button type="button" class="danger" data-post-action={ "/feeds/" + id + "/delete" } data-include={ "delete_remote_" + id } data-confirm={ "delete feed " + d.Form.Title + "?" }>{ "delete feed " + d.Form.Title }</button>
	</div>
}

// feedEditorBody is one feed's settings as fields, with no <form> of its own.
templ feedEditorBody(d feedsData) {
	{{ id := strconv.FormatInt(d.Form.ID, 10) }}
	if d.FormError != "" {
		<div class="error" role="alert">{ d.FormError }</div>
	}
	if d.DocsPlugin != "" {
		<div class="row">
			<button type="button" class="link" data-plugin={ d.DocsPlugin } title="read this feed's plugin documentation" data-plugin-docs>plugin docs</button>
		</div>
	}
	if d.LastError != "" {
		<div class="feed-error" role="alert">
			<div class="feed-error-head">
				<span class="badge danger">last poll failed</span>
				if d.PluginName != "" {
					<span class="muted small">via the { d.PluginName } plugin</span>
				}
				if d.LastPolledAt != "" {
					<span class="muted small">last polled { web.TimeFmt(d.Timezone, d.LastPolledAt) }</span>
				}
				if d.Form.Enabled {
					<button type="button" class="link" title="retry the fetch now" hx-post={ "/feeds/" + id + "/refresh" } hx-params="none" hx-swap="none" data-reload-on-success>refresh now</button>
				}
				<button type="button" class="link" title="clear this feed's error" data-clear-feed-error hidden?={ d.Form.Enabled } hx-post={ "/feeds/" + id + "/clear-error" } hx-params="none" hx-target="closest .feed-error" hx-swap="outerHTML">clear error</button>
			</div>
			<p class="feed-error-msg">{ d.LastError }</p>
		</div>
	}
	@feedFields(d)
	@feedHistoryCard(feedHistoryData{
		FeedID: d.Form.ID, Unread: d.Stats.Unread, Read: d.Stats.Read,
		OldestAt: d.Stats.FirstAt, Timezone: d.Timezone, NextPageURL: d.NextPageURL,
	})
	if d.Panel != nil {
		@feedPluginPanel(*d.Panel)
	}
}

// feedFields is a feed's editable settings, grouped by concern: how nanoflux
// fetches the feed, and how the feed is presented in the app.
templ feedFields(d feedsData) {
	{{ id := strconv.FormatInt(d.Form.ID, 10) }}
	{{ cacheHelp := "download this feed's images into nanoflux so they keep working if the site's image links expire." }}
	if d.Form.CacheForced {
		{{ cacheHelp = "on for this site: its plugin serves image links that expire, so nanoflux keeps a copy. it cannot be turned off." }}
	}
	{{ minPoll := d.Form.MinPollIntervalSec }}
	if minPoll < 60 {
		{{ minPoll = 60 }}
	}
	<div class="field-group">
		<h3>fetching</h3>
		@switchField("enabled", "enabled (poll this feed)", d.Form.Enabled, "", nil)
		@switchField("poll_interval_auto", "auto-adjust poll interval", d.Form.PollIntervalAuto, "", nil)
		<label>
			poll interval (seconds), used when auto-adjust is off
			<input name="poll_interval_sec" type="number" value={ strconv.Itoa(d.Form.PollIntervalSec) } min={ strconv.Itoa(minPoll) }/>
			if d.Form.MinPollIntervalSec > 0 {
				<span class="muted small">minimum { strconv.Itoa(d.Form.MinPollIntervalSec) } seconds for this feed</span>
			}
		</label>
		<label>
			feed url
			<input name="feed_url" type="text" value={ d.Form.FeedURL } required/>
		</label>
		@switchField("cache_images", "cache images locally", d.Form.CacheImages || d.Form.CacheForced, cacheHelp, nil)
	</div>
	<div class="field-group">
		<h3>display</h3>
		<label>
			title
			<input name="title" value={ d.Form.Title } required/>
		</label>
		<label>
			home url
			<input name="home_url" type="url" value={ d.Form.HomeURL }/>
		</label>
		if len(d.Collections) > 0 {
			@comboMulti("collections", "collections", nonAutoCollectionValues(d.Collections, d.Form.CollectionIDs), nonAutoCollections(d.Collections))
		}
	</div>
	<div class="field-group">
		<h3>author</h3>
		<p class="muted small">move this feed and its items to a <button type="button" class="link" data-change-author={ id }>different author</button>.</p>
	</div>
}

// changeAuthorForm is the content of the shared #change-author-dialog: the feed
// being moved and a shadcn combobox of the user's other authors. Saving posts to
// /feeds/{id}/author and swaps the feed's accordion item out, removing it from
// the current author's edit page. The form lives in a topbar dialog, outside the
// author edit page's own <form>, so the nested form is valid.
templ changeAuthorForm(d changeAuthorData) {
	{{ id := strconv.FormatInt(d.FeedID, 10) }}
	<div class="row">
		<h2>change author</h2>
		<button type="button" class="link" title="close" data-close-dialog>@web.Lucide("x")</button>
	</div>
	<p class="muted small">move “{ d.FeedTitle }” and its items to another author.</p>
	if len(d.Authors) == 0 {
		<p class="muted">there are no other authors yet.</p>
		<div class="row">
			<button type="button" data-close-dialog>cancel</button>
		</div>
	} else {
		<form class="stack"
			hx-post={ "/feeds/" + id + "/author" }
			hx-target={ "#feed-acc-" + id }
			hx-swap="outerHTML"
			data-form-close-reset>
			@comboSelect("author_id", "", "author", "search authors", d.Authors, nil)
			if d.Err != "" {
				@FormError(d.Err)
			}
			<div class="row">
				<button type="submit">save</button>
				<button type="button" data-close-dialog>cancel</button>
			</div>
		</form>
	}
}

// feedHistoryData backs a feed's history card in its settings panel: the feed's
// unread/read counts and oldest post, plus the "load older items" control.
// NextPageURL empty means the history is exhausted; Message reports a
// successful load; Err reports a failed one.
type feedHistoryData struct {
	FeedID      int64
	Unread      int
	Read        int
	OldestAt    string
	Timezone    string
	NextPageURL string
	Message     string
	Err         string
}

// feedHistoryCard is the small history card in a feed's settings panel. It is
// the htmx swap target for POST /feeds/{id}/older, so a load refreshes the
// counts and the oldest-post date along with the control, and a failed fetch
// shows an inline error instead of failing silently.
templ feedHistoryCard(d feedHistoryData) {
	{{ id := strconv.FormatInt(d.FeedID, 10) }}
	<div id={ "feed-history-" + id } class="feed-history-card">
		<div class="feed-history-stats">
			<span><strong>{ strconv.Itoa(d.Unread) }</strong> unread</span>
			<span><strong>{ strconv.Itoa(d.Read) }</strong> read</span>
			if d.OldestAt != "" {
				<span>oldest { web.TimeFmt(d.Timezone, d.OldestAt) }</span>
			} else {
				<span>no posts yet</span>
			}
		</div>
		<div class="feed-history-actions">
			if d.NextPageURL != "" {
				<button type="button" class="link" hx-post={ "/feeds/" + id + "/older" } hx-params="none" hx-target={ "#feed-history-" + id } hx-swap="outerHTML">load older items</button>
			} else {
				<span class="muted small">full history loaded</span>
			}
			if d.Message != "" {
				<span class="muted small">{ d.Message }</span>
			}
			if d.Err != "" {
				<span class="error" role="alert">{ d.Err }</span>
			}
		</div>
	</div>
}

