package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ FeedsList(rows []feedRow) {
	<ul class="plain" id="feeds-list">
		for _, r := range rows {
			@FeedRow(r)
		}
	</ul>
}

templ FeedRow(r feedRow) {
	<li id={ "feed-" + strconv.FormatInt(r.ID, 10) }>
		<div class="row">
			<div>
				<a href={ "/feeds/" + strconv.FormatInt(r.ID, 10) }>
					<strong>@web.SourceIcon(r.FeedURL)
					{ r.Title }</strong>
				</a>
				if !r.Enabled {
					<span class="badge">paused</span>
				}
				if r.LastError != "" {
					<span class="badge danger" title={ r.LastError }>last poll failed</span>
				}
				<div class="item-meta">
					<a href={ templ.URL(r.FeedURL) } class="external" referrerpolicy="no-referrer">feed</a> · { r.Unread } unread · last polled 
					if r.LastPolledAt != "" {
						{ web.TimeFmt(r.Timezone, r.LastPolledAt) }
					} else {
						never
					}
				</div>
			</div>
			<div class="row-actions">
				<a class="small" href={ "/feeds/" + strconv.FormatInt(r.ID, 10) + "/edit" }>edit</a>
				<button class="link" title={ toggleTitle(r.Enabled) } hx-post={ "/feeds/" + strconv.FormatInt(r.ID, 10) + "/toggle" } hx-target={ "#feed-" + strconv.FormatInt(r.ID, 10) } hx-swap="outerHTML">
					if r.Enabled {
						⏸
					} else {
						▶
					}
				</button>
				<button class="link" title="refresh" hx-post={ "/feeds/" + strconv.FormatInt(r.ID, 10) + "/refresh" } hx-target={ "#feed-" + strconv.FormatInt(r.ID, 10) } hx-swap="outerHTML">↻</button>
				<button class="link danger" title="delete" hx-post={ "/feeds/" + strconv.FormatInt(r.ID, 10) + "/delete" } hx-target={ "#feed-" + strconv.FormatInt(r.ID, 10) } hx-swap="outerHTML" hx-confirm="delete this feed?">✕</button>
			</div>
		</div>
	</li>
}

// feedPreviewFields is the combined add form: an author and their first feed
// together. In the global flow (authors page) the author select defaults to a
// new author pre-filled from discovery; on an author page the author is fixed
// and only the feed fields render.
templ feedPreviewFields(d feedPreviewForm) {
	<form class="stack" hx-post={ d.Action } hx-target={ d.Target } hx-swap={ d.Swap } hx-on::after-request="if(event.detail.successful && event.detail.elt === this){this.closest('dialog').close();this.reset()}">
		<label>title
			<input name="title" type="text" value={ d.Title }/>
		</label>
		<label>feed url
			<input name="feed_url" type="text" value={ d.FeedURL } required/>
		</label>
		<label>home url
			<input id="feed-home-url" name="home_url" type="url" value={ d.HomeURL }/>
		</label>
		if d.FixedAuthor != nil {
			<input type="hidden" name="author_id" value={ strconv.FormatInt(d.FixedAuthor.ID, 10) }/>
			<p class="muted small">author · { d.FixedAuthor.Name }</p>
		} else {
			<label>author
				<select name="author_id" hx-get="/fragments/author-form" hx-target="#new-author" hx-swap="innerHTML" hx-trigger="change" hx-include="#feed-home-url">
					<option value="new">+ create new author</option>
					for _, a := range d.Authors {
						if a.ID == d.SelectedAuthorID {
							<option value={ strconv.FormatInt(a.ID, 10) } selected>{ a.Name }</option>
						} else {
							<option value={ strconv.FormatInt(a.ID, 10) }>{ a.Name }</option>
						}
					}
				</select>
			</label>
			<div id="new-author">@authorCreateFields(d.newAuthor())</div>
		}
		<div id="add-feed-error" class="error"></div>
		<button type="submit">add</button>
	</form>
}

templ feedChooser(d feedChoose) {
	<div class="choose">
		<p class="muted">found { len(d.Candidates) } feeds on that page — pick one</p>
		<select name="feed_url" hx-post="/fragments/feed-preview" hx-target="#feed-preview" hx-swap="innerHTML" hx-include="#feed-url-input, #feed-author-id, #feed-author-scoped">
			for _, c := range d.Candidates {
				<option value={ c.FeedURL }>{ c.Title }</option>
			}
		</select>
	</div>
}

templ feedEditPage(u store.User, d feedsData) {
	<section class="card">
		<h1>edit feed</h1>
		<form class="stack" method="post" action={ "/feeds/" + strconv.FormatInt(d.Form.ID, 10) + "/edit" }>
			@feedFields(d)
			<button type="submit">save</button>
		</form>
	</section>
	@feedRulesSection(d.Rules)
}

templ feedRulesSection(d feedRulesData) {
	<section class="card" id="feed-rules">
		<h2>filters</h2>
		<p class="muted small">Rules run against new items when the feed is polled. "hide" drops the item; "mark read" stores it as already read.</p>
		<form class="stack" hx-post={ "/feeds/" + strconv.FormatInt(d.FeedID, 10) + "/filters" } hx-target="#feed-rules" hx-swap="outerHTML">
			<div class="row">
				<label>action
					<select name="action">
						<option value="hide">hide</option>
						<option value="mark_read">mark read</option>
					</select>
				</label>
				<label>field
					<select name="field">
						<option value="title">title</option>
						<option value="summary">summary</option>
						<option value="link">link</option>
					</select>
				</label>
				<label>pattern
					<input name="pattern" type="text" placeholder="e.g. sponsored" required/>
				</label>
				<label class="check"><input type="checkbox" name="is_regex" value="1"/> regex</label>
			</div>
			<div id="feed-rules-error" class="error"></div>
			<button type="submit">add rule</button>
		</form>
		@FilterList(d.FeedID, d.Rows)
	</section>
}

templ FilterList(feedID int64, rows []store.Filter) {
	<ul class="plain" id="feed-filters-list">
		for _, r := range rows {
			<li id={ "filter-" + strconv.FormatInt(r.ID, 10) }>
				<div class="row">
					<span class="muted small">
						{ r.Action } · { r.Field } · <code>{ r.Pattern }</code>
						if r.IsRegex {
							· regex
						}
					</span>
					<button class="link danger" title="delete rule" hx-post={ "/filters/" + strconv.FormatInt(r.ID, 10) + "/delete" } hx-target="#feed-filters-list" hx-swap="outerHTML" hx-confirm="delete this rule?">✕</button>
				</div>
			</li>
		}
		if len(rows) == 0 {
			<li class="muted small">no rules yet</li>
		}
	</ul>
}

templ feedFields(d feedsData) {
	<label>title
		<input name="title" value={ d.Form.Title } required/>
	</label>
	<label>feed url
		<input name="feed_url" type="text" value={ d.Form.FeedURL } required/>
	</label>
	<label>home url
		<input name="home_url" type="url" value={ d.Form.HomeURL }/>
	</label>
	<label>author
		<select name="author_id" hx-get="/fragments/author-form" hx-target="#new-author" hx-swap="innerHTML" hx-trigger="change">
			<option value="new">+ create new author</option>
			for _, a := range d.Authors {
				if a.ID == d.Form.AuthorID {
					<option value={ strconv.FormatInt(a.ID, 10) } selected>{ a.Name }</option>
				} else {
					<option value={ strconv.FormatInt(a.ID, 10) }>{ a.Name }</option>
				}
			}
		</select>
	</label>
	<div id="new-author"></div>
	<label>poll interval (seconds)
		<input name="poll_interval_sec" type="number" value={ strconv.Itoa(d.Form.PollIntervalSec) } min="60"/>
	</label>
	<label class="check"><input type="checkbox" name="enabled" value="1" checked={ d.Form.Enabled }/> enabled (poll this feed)</label>
	if len(d.Collections) > 0 {
		<fieldset>
			<legend>collections</legend>
			for _, c := range d.Collections {
				if !c.IsAuto {
					if hasID(c.ID, d.Form.CollectionIDs) {
						<label class="check"><input type="checkbox" name="collections" value={ strconv.FormatInt(c.ID, 10) } checked/> { c.Name }</label>
					} else {
						<label class="check"><input type="checkbox" name="collections" value={ strconv.FormatInt(c.ID, 10) }/> { c.Name }</label>
					}
				}
			}
		</fieldset>
	}
}

templ feedPage(u store.User, d feedPageData) {
	<section class="card">
		<div class="row">
			<h1>@web.SourceIcon(d.Row.FeedURL)
			{ d.Row.Title }</h1>
			<div class="row-actions">
				<a class="small" href={ "/feeds/" + strconv.FormatInt(d.Row.ID, 10) + "/edit" }>edit</a>
				<button class="link" title="refresh" hx-post={ "/feeds/" + strconv.FormatInt(d.Row.ID, 10) + "/refresh" } hx-swap="none" hx-on::after-request="if(event.detail.successful) window.location.reload()">↻</button>
			</div>
		</div>
		<p class="item-meta">
			if d.Row.AuthorName != "" {
				<a href={ "/authors/" + strconv.FormatInt(d.Row.AuthorID, 10) }>{ d.Row.AuthorName }</a> ·
			} else {
				no author ·
			}
			<a href={ templ.URL(d.Row.FeedURL) } class="external" referrerpolicy="no-referrer">feed</a>
			if d.Row.HomeURL != "" {
				· <a href={ templ.URL(d.Row.HomeURL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">home</a>
			}
		</p>
		<p class="muted small">{ d.Row.Unread } unread · last polled 
		if d.Row.LastPolledAt != "" {
			{ web.TimeFmt(d.Row.Timezone, d.Row.LastPolledAt) }
		} else {
			never
		}
	</p>
		if d.Row.LastError != "" {
			<div class="error" role="alert">last poll failed: { d.Row.LastError }</div>
		}
		if d.Row.NextPageURL != "" {
			@feedOlderControl(d.Row)
		}
	</section>
	<h2>items</h2>
	@ScopedItems(d.Scoped)
}

// feedOlderControl is the "load older items" control for a paginated feed. It
// is the htmx swap target for POST /feeds/{id}/older: the response replaces it
// (button advances to the next page, or becomes a "history complete" note once
// pages run out) and out-of-band swaps the item list.
templ feedOlderControl(f feedRow) {
	<div id="feed-older">
		if f.NextPageURL != "" {
			<button class="link" hx-post={ "/feeds/" + strconv.FormatInt(f.ID, 10) + "/older" } hx-target="#feed-older" hx-swap="outerHTML">load older items</button>
		} else {
			<span class="muted small">full history loaded</span>
		}
	</div>
}

// toggleTitle returns the toggle button tooltip for a feed's enabled state.
func toggleTitle(enabled bool) string {
	if enabled {
		return "pause polling"
	}
	return "resume polling"
}

// hasID reports whether id is present in ids.
func hasID(id int64, ids []int64) bool {
	for _, i := range ids {
		if i == id {
			return true
		}
	}
	return false
}