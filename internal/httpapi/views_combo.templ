package httpapi

// comboSelect is a single-select Vaadin combo-box with a hidden native mirror.
// The mirror carries the field name and any hx-* attributes (spread from attrs),
// so htmx sees exactly the element it used to see when this was a <select>: the
// component's value is copied into the mirror, which then fires "change".
//
// label renders an external <label>; the component's own label part stays empty.
// placeholder is the empty-state text.
templ comboSelect(name, value, label, placeholder string, items []comboItem, attrs templ.Attributes) {
	<div class="combo-field">
		if label != "" {
			<label for={ name }>{ label }</label>
		}
		<div class="combo" data-vaadin="single">
			<vaadin-combo-box id={ name } placeholder={ placeholder }></vaadin-combo-box>
			<input type="hidden" data-vaadin-target name={ name } value={ value } { attrs... }/>
			@templ.JSONScript("", comboPayload{Items: items, Value: value})
		</div>
	</div>
}

// comboSelectInline is comboSelect without the external label, for compact
// controls that sit inline in a row (e.g. the home section render-mode picker).
templ comboSelectInline(name, value, placeholder string, items []comboItem, attrs templ.Attributes) {
	<div class="combo combo-inline" data-vaadin="single">
		<vaadin-combo-box id={ name } placeholder={ placeholder }></vaadin-combo-box>
		<input type="hidden" data-vaadin-target name={ name } value={ value } { attrs... }/>
		@templ.JSONScript("", comboPayload{Items: items, Value: value})
	</div>
}

// comboMulti is a multi-select Vaadin combo-box that submits like the checkbox
// group it replaces: one hidden input per selected value, all sharing name, so
// the server still reads r.Form[name] as repeated params. The server renders the
// initial inputs; the component's change handler rebuilds them.
templ comboMulti(name, label string, values []string, items []comboItem) {
	<div class="combo-field">
		<label for={ name }>{ label }</label>
		<div class="combo" data-vaadin="multi" data-vaadin-name={ name }>
			<vaadin-multi-select-combo-box id={ name } auto-expand-horizontally auto-expand-vertically placeholder="—"></vaadin-multi-select-combo-box>
			<div data-vaadin-mirrors>
				for _, v := range values {
					<input type="hidden" name={ name } value={ v }/>
				}
			</div>
			@templ.JSONScript("", comboPayload{Items: items, Value: values})
		</div>
	</div>
}

// comboChips is a display-only multi-select used where the current members are
// shown and removed individually (the collection edit feed list). removeURL is
// the per-item endpoint prefix; the client appends the removed value's id. When
// readonly, the chips hide their remove button and the list is inspect-only
// (auto collections). auto-expand-* keep every name visible, wrapping as needed.
templ comboChips(removeURL string, values []string, items []comboItem, readonly bool) {
	<div class="combo combo-chips" data-vaadin="chips" data-remove-url={ removeURL }>
		<vaadin-multi-select-combo-box auto-expand-horizontally auto-expand-vertically readonly?={ readonly } placeholder="—"></vaadin-multi-select-combo-box>
		@templ.JSONScript("", comboPayload{Items: items, Value: values})
	</div>
}
