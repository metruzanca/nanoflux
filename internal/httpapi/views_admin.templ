package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ adminPage(u store.User, d adminData) {
	<h1>admin</h1>
	@AdminInstanceCard(d)
	@AdminStats(d.Stats)
	@AdminPluginsCard(d.Plugins, d.PluginOwners)
	@AdminBackupCard(d.Backup)
	<section class="card">
		<h2>users</h2>
		<p class="muted small">Manage accounts: reset passwords, grant or revoke the admin flag, or delete users. Deleting a user removes all of their data.</p>
		@AdminUserList(d.Users)
	</section>
}

// AdminPluginsCard lists the feed plugins the host loaded at startup, with the
// kind (native vs external) and API version each reported. Below them it lists
// the domains currently owned by a plugin, each with a "reset" action: clearing
// a domain's owner and re-reconciling lets the loaded registry re-derive it, the
// escape hatch when a plugin is removed, renamed, or swapped.
templ AdminPluginsCard(rows []adminPluginRow, domains []adminPluginDomain) {
	<section class="card" id="admin-plugins-card">
		<h2>plugins</h2>
		<p class="muted small">Feed plugins loaded at startup. Native plugins are compiled into nanoflux and take precedence over external ones when both match a URL.</p>
		if len(rows) == 0 {
			<p class="muted small">no plugins loaded.</p>
		} else {
			<ul class="plain" id="admin-plugins-list">
				for _, r := range rows {
					<li>
						<div class="row">
							<div>
								<strong>{ r.Name }</strong>
								<span class="badge">{ r.Kind }</span>
								if r.RawNet {
									<span class="badge warn" title="plugin uses its own HTTP client and surfaces rate limits itself">raw network</span>
								}
								<div class="item-meta muted">
									api { r.Version }
									if r.UserAgent != "" {
										· user-agent: { r.UserAgent }
									} else {
										· user-agent: app default
									}
								</div>
							</div>
						</div>
					</li>
				}
			</ul>
		}
		<div id="admin-plugins-error" class="error"></div>
		if len(domains) > 0 {
			<h3>plugin-owned domains</h3>
			<p class="muted small">Reset a domain to clear its plugin owner and re-derive it from the loaded plugins. Use this after removing, renaming, or swapping a plugin: feeds on the domain are re-owned automatically, or fall back to the generic parser when no plugin matches.</p>
			<ul class="plain" id="admin-plugin-domains">
				for _, d := range domains {
					<li>
						<div class="row">
							<div>
								<strong>{ d.Domain }</strong>
								<span class="badge">{ d.Plugin }</span>
								<span class="muted small">
									if d.Feeds == 1 {
										1 feed
									} else {
										{ strconv.Itoa(d.Feeds) } feeds
									}
								</span>
							</div>
							<div class="row-actions">
								<button class="link" hx-post="/admin/plugins/reset" hx-vals={ "{\"domain\": " + strconv.Quote(d.Domain) + "}" } hx-target="#admin-plugins-card" hx-swap="outerHTML" hx-confirm={ "reset the plugin for " + d.Domain + "? its feeds will be re-owned by the loaded plugins" }>reset</button>
							</div>
						</div>
					</li>
				}
			</ul>
		}
	</section>
}

// AdminBackupCard shows automatic-backup configuration and the last run, with a
// "back up now" button. Rendered only for admins; the button re-renders the
// card itself after a manual snapshot.
templ AdminBackupCard(b adminBackup) {
	<section class="card" id="admin-backup-card">
		<h2>backups</h2>
		if !b.Enabled {
			<p class="muted small">automatic backups are off. Set <code>NF_BACKUP_INTERVAL</code> and a destination (<code>NF_BACKUP_DIR</code> or <code>NF_BACKUP_S3_*</code>) to enable them. See the backups docs.</p>
		} else {
			<p class="muted small">
				snapshotting the whole instance to <strong>{ b.Destination }</strong> every { b.Interval }
				if b.Keep > 0 {
					, keeping the newest { strconv.Itoa(b.Keep) }
				}
				.
			</p>
		}
		if b.LastError != "" {
			<div class="error" role="alert">last backup failed: { b.LastError }</div>
		} else if b.LastRun != "" {
			<div class="muted small">
				last backup { web.TimeFmt(b.Timezone, b.LastRun) }
				if b.LastArchive != "" {
					· { b.LastArchive }
				}
				if b.LastSize != "" {
					· { b.LastSize }
				}
			</div>
		} else if b.Enabled {
			<div class="muted small">no backup has run yet.</div>
		}
		<div id="admin-backup-error" class="error"></div>
		if b.Enabled {
			<button type="button" hx-post="/admin/backup" hx-target="#admin-backup-card" hx-swap="outerHTML" hx-disabled-elt="this">back up now</button>
		}
	</section>
}

// AdminInstanceCard carries the global signup setting and, while signups are
// open and the current admin hasn't dismissed it, the "consider disabling
// signups" banner. Mutations re-render the card via outerHTML.
templ AdminInstanceCard(d adminData) {
	<section class="card" id="admin-instance-card">
		<h2>instance</h2>
		if d.BannerShown {
			<div class="error banner" role="alert">
				<strong>signups are open to anyone.</strong> Anyone who can reach this instance can create an account — consider disabling signups.
				<div class="row">
					<button class="small" hx-post="/admin/settings/signup" hx-vals='{"allow": "false"}' hx-target="#admin-instance-card" hx-swap="outerHTML">disable signups</button>
					<button class="link" hx-post="/admin/settings/signup-banner-dismiss" hx-target="#admin-instance-card" hx-swap="outerHTML">dismiss</button>
				</div>
			</div>
		}
		<div id="admin-instance-error" class="error"></div>
		<div class="row">
			<span>signups</span>
			<button class="link" hx-post="/admin/settings/signup" hx-vals={ "{\"allow\": " + strconv.FormatBool(!d.AllowSignup) + "}" } hx-target="#admin-instance-card" hx-swap="outerHTML">
				if d.AllowSignup {
					enabled
				} else {
					disabled
				}
			</button>
		</div>
	</section>
}

templ AdminStats(st adminStats) {
	<div class="row stats" aria-label="instance statistics">
		<span><strong>{ st.Users }</strong> users</span>
		<span><strong>{ st.Feeds }</strong> feeds</span>
		<span><strong>{ st.Authors }</strong> authors</span>
		<span><strong>{ st.Items }</strong> items</span>
		<span><strong>{ st.Unread }</strong> unread</span>
		<span><strong>{ st.Objects }</strong> objects</span>
		<span><strong>{ st.Storage }</strong> storage</span>
	</div>
}

templ AdminUserList(rows []adminUserRow) {
	<ul class="plain" id="admin-users-list">
		for _, r := range rows {
			@AdminUserRow(r)
		}
	</ul>
}

templ AdminUserRow(r adminUserRow) {
	<li id={ "admin-user-" + strconv.FormatInt(r.ID, 10) }>
		<div id={ "admin-user-" + strconv.FormatInt(r.ID, 10) + "-error" } class="error"></div>
		<div class="row">
			<div>
				<strong>{ r.Username }</strong>
				if r.IsAdmin {
					<span class="badge">admin</span>
				}
				if r.IsSelf {
					<span class="muted">you</span>
				}
				<div class="item-meta muted">joined { web.TimeFmt(r.Timezone, r.CreatedAt) }</div>
			</div>
			<div class="row-actions">
				if !r.IsSelf {
					<form class="row" hx-post={ "/admin/users/" + strconv.FormatInt(r.ID, 10) + "/reset-password" } hx-target="#admin-users-list" hx-swap="innerHTML">
						<input name="password" type="password" placeholder="new password" minlength="8" required/>
						<button type="submit" class="small">reset</button>
					</form>
					<button class="link" hx-post={ "/admin/users/" + strconv.FormatInt(r.ID, 10) + "/set-admin" } hx-vals={ "{\"admin\": " + strconv.FormatBool(!r.IsAdmin) + "}" } hx-target="#admin-users-list" hx-swap="innerHTML">
						if r.IsAdmin {
							remove admin
						} else {
							make admin
						}
					</button>
					<button class="link danger" title="delete" hx-post={ "/admin/users/" + strconv.FormatInt(r.ID, 10) + "/delete" } hx-target="#admin-users-list" hx-swap="innerHTML" hx-confirm={ "delete user " + r.Username + "? this removes all of their data" }>@web.Lucide("x")</button>
				}
			</div>
		</div>
	</li>
}

// forbiddenPage is rendered for non-admins hitting an admin route, so the
// denial is visible rather than a bare status.
templ forbiddenPage(msg string) {
	<section class="card">
		<h1>forbidden</h1>
		<div class="error" role="alert">{ msg }</div>
	</section>
}