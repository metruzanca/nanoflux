package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ adminPage(u store.User, d adminData) {
	<h1>admin</h1>
	@AdminInstanceCard(d)
	@AdminStats(d.Stats)
	@AdminPollCard(d.Poll, u.Timezone)
	@AdminStorageCard(d.Storage)
	@AdminPluginsCard(d.Plugins)
	@AdminBackupCard(d.Backup)
	<section class="card">
		<h2>users</h2>
		<p class="muted small">Manage accounts: reset a password to a new random value, grant or revoke the admin flag, or delete users. Deleting a user removes all of their data.</p>
		<div id="admin-users-list">@AdminUserList(d.Users, "")</div>
	</section>
}

// AdminPluginsCard lists the feed plugin executables the host loaded at
// startup, with the API version each reported and the feeds it currently
// handles. Ownership is re-derived at boot, so the owned list is the debugging
// surface for seeing which plugin takes which domains and URLs.
templ AdminPluginsCard(rows []adminPluginRow) {
	<section class="card" id="admin-plugins-card">
		<h2>plugins</h2>
		<p class="muted small">Feed plugins loaded from the plugins directory at startup. Ownership is re-derived on every launch; expand a plugin to see the domains and feed URLs it currently matches.</p>
		if len(rows) == 0 {
			<p class="muted small">no plugins loaded.</p>
		} else {
			<ul class="plain plugin-list" id="admin-plugins-list">
				for _, r := range rows {
					<li class="plugin-row">
						<div class="plugin-row-main">
							<div class="plugin-row-head">
								<strong>{ r.Name }</strong>
								<span class="badge" title="plugin API version the plugin reported">api { r.Version }</span>
								if r.RawNet {
									<span class="badge warn" title="plugin uses its own HTTP client and surfaces rate limits itself">raw network</span>
								}
								if r.ProvisionLabel != "" {
									<span class="badge" title={"can create a feed for you: " + r.ProvisionLabel}>creates feeds</span>
								}
								if r.CanManageFeeds {
									<span class="badge" title="can manage your subscribed feeds on the site (sync, delete)">manages feeds</span>
								}
							</div>
							if r.Summary != "" {
								<p class="plugin-summary muted small">{ r.Summary }</p>
							}
							if r.Owned.Feeds > 0 {
								<details class="plugin-owned">
									<summary class="muted small">
										owns { strconv.Itoa(r.Owned.Feeds) }
										if r.Owned.Feeds == 1 {
											feed
										} else {
											feeds
										}
										on { " " }
										for i, d := range r.Owned.Domains {
											if i > 0 {
												{ ", " }
											}
											{ d }
										}
									</summary>
									<ul class="plain plugin-owned-urls">
										for _, u := range r.Owned.URLs {
											<li><code>{ u }</code></li>
										}
									</ul>
								</details>
							} else {
								<p class="muted small">no feeds use this plugin</p>
							}
						</div>
						<div class="plugin-row-actions">
							if r.HasDocs {
								<button type="button" class="link plugin-docs-btn" data-plugin={ r.Name } title="read this plugin's documentation" aria-label={ "documentation for " + r.Name } data-plugin-docs>@web.Lucide("info")</button>
							}
							if len(r.Settings) > 0 {
								<button type="button" class="link plugin-settings-btn" data-open={ "plugin-settings-" + r.Name } title={ "settings for " + r.Name } aria-label={ "settings for " + r.Name }>@web.Lucide("settings")</button>
							}
						</div>
					</li>
				}
			</ul>
			for _, r := range rows {
				if len(r.Settings) > 0 {
					<dialog id={ "plugin-settings-" + r.Name } class="modal">
						<div class="row">
							<h2>{ r.Name } settings</h2>
							<button type="button" class="link" title="close" data-close={ "plugin-settings-" + r.Name }>@web.Lucide("x")</button>
						</div>
						<div id={ "plugin-settings-error-" + r.Name } class="error"></div>
						@adminPluginSettingsForm(r)
					</dialog>
				}
			}
		}
		<div id="admin-plugins-error" class="error"></div>
	</section>
}

// adminPluginSettingsForm is the settings form for one configurable plugin,
// rendered inside that plugin's modal from its declared schema. A password field
// is write-only: it shows whether a value is set and never renders the stored
// secret back; a "clear" checkbox unsets it. Submitting re-renders the whole
// plugins card.
templ adminPluginSettingsForm(r adminPluginRow) {
	<form class="stack plugin-settings" hx-post={ "/admin/plugins/" + r.Name + "/settings" } hx-target="#admin-plugins-card" hx-swap="outerHTML">
		for _, s := range r.Settings {
			<label>
				{ s.Label }
				if s.Kind == "password" {
					<input type="password" name={ "setting_" + s.Name } placeholder={ passwordPlaceholder(s) } autocomplete="new-password"/>
					if s.Set {
						<label class="check">
							<input type="checkbox" name={ "clear_" + s.Name } value="1"/>
							clear the stored value
						</label>
					}
				} else if s.Kind == "url" {
					<input type="url" name={ "setting_" + s.Name } value={ s.Value } placeholder={ s.Placeholder } required?={ s.Required }/>
				} else if s.Kind == "bool" {
					<input type="checkbox" name={ "setting_" + s.Name } value="1" checked?={ s.Checked }/>
				} else {
					<input type="text" name={ "setting_" + s.Name } value={ s.Value } placeholder={ s.Placeholder } required?={ s.Required }/>
				}
				if s.Help != "" {
					<span class="muted small">{ s.Help }</span>
				}
			</label>
		}
		<button type="submit" class="small">save settings</button>
	</form>
}

// passwordPlaceholder describes a write-only password field's stored state
// without revealing the value.
func passwordPlaceholder(s adminPluginSetting) string {
	if s.Set {
		return "•••••••• (set)"
	}
	return s.Placeholder
}

// AdminBackupCard shows automatic-backup configuration and the last run, with a
// "back up now" button. Rendered only for admins; the button re-renders the
// card itself after a manual snapshot.
templ AdminBackupCard(b adminBackup) {
	<section class="card" id="admin-backup-card">
		<h2>backups</h2>
		if !b.Enabled {
			<p class="muted small">automatic backups are off. Set <code>NF_BACKUP_INTERVAL</code> and a destination (<code>NF_BACKUP_DIR</code> or <code>NF_BACKUP_S3_*</code>) to enable them. See the backups docs.</p>
		} else {
			<p class="muted small">
				snapshotting the whole instance to <strong>{ b.Destination }</strong> every { b.Interval }
				if b.Keep > 0 {
					, keeping the newest { strconv.Itoa(b.Keep) }
				}
				.
			</p>
		}
		if b.LastError != "" {
			<div class="error" role="alert">last backup failed: { b.LastError }</div>
		} else if b.LastRun != "" {
			<div class="muted small">
				last backup { web.TimeFmt(b.Timezone, b.LastRun) }
				if b.LastArchive != "" {
					· { b.LastArchive }
				}
				if b.LastSize != "" {
					· { b.LastSize }
				}
			</div>
		} else if b.Enabled {
			<div class="muted small">no backup has run yet.</div>
		}
		<div id="admin-backup-error" class="error"></div>
		if b.Enabled {
			<button type="button" hx-post="/admin/backup" hx-target="#admin-backup-card" hx-swap="outerHTML" hx-disabled-elt="this">back up now</button>
		}
	</section>
}

// AdminInstanceCard carries the global signup setting and, while signups are
// open and the current admin hasn't dismissed it, the "consider disabling
// signups" banner. Mutations re-render the card via outerHTML.
templ AdminInstanceCard(d adminData) {
	<section class="card" id="admin-instance-card">
		<h2>instance</h2>
		if d.BannerShown {
			<div class="error banner" role="alert">
				<strong>signups are open to anyone.</strong> Anyone who can reach this instance can create an account — consider disabling signups.
				<div class="row">
					<button class="small" hx-post="/admin/settings/signup" hx-vals='{"allow": "0"}' hx-target="#admin-instance-card" hx-swap="outerHTML">disable signups</button>
					<button class="link" hx-post="/admin/settings/signup-banner-dismiss" hx-target="#admin-instance-card" hx-swap="outerHTML">dismiss</button>
				</div>
			</div>
		}
		<div id="admin-instance-error" class="error"></div>
		if !d.AllowSignup {
			<p class="muted small">Registration is closed. Existing accounts can still sign in.</p>
		}
		@switchField("allow", "signups", d.AllowSignup, "", templ.Attributes{
			"hx-post":   "/admin/settings/signup",
			"hx-target": "#admin-instance-card",
			"hx-swap":   "outerHTML",
			"hx-trigger": "change",
		})
	</section>
}

templ AdminStats(st adminStats) {
	<section class="card">
		<h2>stats</h2>
		<div class="row stats" aria-label="instance statistics">
			<span><strong>{ st.Users }</strong> users</span>
			<span><strong>{ st.Feeds }</strong> feeds</span>
			<span><strong>{ st.Authors }</strong> authors</span>
			<span><strong>{ st.Items }</strong> items</span>
			<span><strong>{ st.Unread }</strong> unread</span>
			<span><strong>{ st.Objects }</strong> objects</span>
			<span><strong>{ st.Storage }</strong> storage</span>
		</div>
	</section>
}

// AdminPollCard shows whether the poller can keep up. Demand is how many fetches
// per day the host's feeds ask for at their current intervals; capacity is what
// the host's spacing allows. Demand above capacity is the permanent-lateness
// signal: the backlog cannot drain until the load or spacing changes.
templ AdminPollCard(d adminPoll, tz string) {
	<section class="card" id="admin-poll-card">
		<h2>polling</h2>
		if d.Unavailable {
			<p class="muted small">polling stats unavailable.</p>
		} else if d.Enabled == 0 {
			<p class="muted small">no enabled feeds.</p>
		} else {
			<p class="muted small">
				<strong>{ strconv.Itoa(d.Behind) }</strong> of { strconv.Itoa(d.Enabled) } feeds behind schedule
				if d.OldestRef != "" {
					{ " · oldest " }
					<strong>{ d.OldestTitle }</strong>
					{ " last polled " }
					{ web.TimeFmt(tz, d.OldestRef) }
				}
			</p>
			if d.Overloaded > 0 {
				<div class="error banner" role="alert">
					<strong>
						if d.Overloaded == 1 {
							1 host cannot keep up.
						} else {
							{ strconv.Itoa(d.Overloaded) } hosts cannot keep up.
						}
					</strong>
					At their current spacing they cannot fetch every feed as often as its interval asks, so the backlog will keep growing. Reduce the number of feeds on those hosts or lengthen their poll intervals.
				</div>
			}
			if len(d.Hosts) == 0 {
				<p class="muted small">all feeds are on schedule.</p>
			} else {
				<table class="admin-users">
					<thead>
						<tr>
							<th>host</th>
							<th>behind</th>
							<th>spacing</th>
							<th>demand/day</th>
							<th>capacity/day</th>
							<th>clear</th>
						</tr>
					</thead>
					<tbody>
						for _, h := range d.Hosts {
							<tr>
								<td>
									<strong>{ h.Host }</strong>
									if h.Overloaded {
										<span class="badge warn">overloaded</span>
									}
								</td>
								<td>{ strconv.Itoa(h.Behind) } / { strconv.Itoa(h.Feeds) }</td>
								<td>{ h.Spacing }</td>
								<td>{ h.Demand }</td>
								<td>{ h.Capacity }</td>
								<td>{ h.Clear }</td>
							</tr>
						}
					</tbody>
				</table>
				<p class="muted small">Capacity uses the current host spacing, including a learned rate-limit window. Active 429 cooldowns are not included.</p>
			}
		}
	</section>
}

// AdminStorageCard breaks the object store down by kind and cache plugin, so it
// is visible which feeds/sites dominate storage. Cached item media is excluded
// from backups; orphaned blobs no row references are flagged for `storage gc`.
templ AdminStorageCard(d adminStorage) {
	<section class="card" id="admin-storage-card">
		<h2>storage</h2>
		if d.Total == "" || d.Total == "unavailable" {
			<p class="muted small">storage breakdown unavailable.</p>
		} else {
			<p class="muted small">
				total { d.Total }. Cached item media is left out of backups; avatars and icons are included.
			</p>
			if d.OrphanObjects > 0 {
				<p class="muted small">orphaned cached media: <strong>{ d.Orphans }</strong> in { strconv.Itoa(d.OrphanObjects) } objects — run <code>nanoflux storage gc --apply</code> to remove.</p>
			}
			<div class="row stats" aria-label="storage breakdown">
				for _, g := range d.Groups {
					<span><strong>{ web.FormatBytes(g.Bytes) }</strong> { g.Label }</span>
				}
			</div>
		}
	</section>
}

templ AdminUserList(rows []adminUserRow, notice string) {
	if notice != "" {
		<div class="notice admin-users-notice" role="status">{ notice }</div>
	}
	<table class="admin-users">
		<thead>
			<tr>
				<th>user</th>
				<th>joined</th>
				<th class="col-actions">actions</th>
			</tr>
		</thead>
		<tbody>
			for _, r := range rows {
				@AdminUserRow(r)
			}
		</tbody>
	</table>
}

templ AdminUserRow(r adminUserRow) {
	<tr id={ "admin-user-" + strconv.FormatInt(r.ID, 10) }>
		<td>
			<strong>{ r.Username }</strong>
			if r.IsAdmin {
				<span class="badge">admin</span>
			}
			if r.IsSelf {
				<span class="muted">you</span>
			}
		</td>
		<td class="muted">{ web.TimeFmt(r.Timezone, r.CreatedAt) }</td>
		<td class="col-actions">
			<div id={ "admin-user-" + strconv.FormatInt(r.ID, 10) + "-error" } class="error"></div>
			if !r.IsSelf {
				<button type="button" class="link" hx-post={ "/admin/users/" + strconv.FormatInt(r.ID, 10) + "/reset-password" } hx-target="#admin-users-list" hx-swap="innerHTML" hx-confirm={ "reset the password for " + r.Username + "? a new random password will be generated and shown once" }>reset password</button>
				<button type="button" class="link" hx-post={ "/admin/users/" + strconv.FormatInt(r.ID, 10) + "/set-admin" } hx-vals={ "{\"admin\": " + strconv.FormatBool(!r.IsAdmin) + "}" } hx-target="#admin-users-list" hx-swap="innerHTML">
					if r.IsAdmin {
						remove admin
					} else {
						make admin
					}
				</button>
				<button type="button" class="link danger" title="delete" hx-post={ "/admin/users/" + strconv.FormatInt(r.ID, 10) + "/delete" } hx-target="#admin-users-list" hx-swap="innerHTML" hx-confirm={ "delete user " + r.Username + "? this removes all of their data" }>@web.Lucide("x")</button>
			}
		</td>
	</tr>
}

// forbiddenPage is rendered for non-admins hitting an admin route, so the
// denial is visible rather than a bare status.
templ forbiddenPage(msg string) {
	<section class="card">
		<h1>forbidden</h1>
		<div class="error" role="alert">{ msg }</div>
	</section>
}