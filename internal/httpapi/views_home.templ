package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/web"
)

// homeModeControl picks how one pinned home section renders (list, grid, or
// cards). It is the custom pill picker (not a combo box): the choice is a
// server-side mutation, so each option POSTs to /settings/home and the card is
// swapped back.
templ homeModeControl(collectionID int64, mode string) {
	@PickerControl("mode-"+strconv.FormatInt(collectionID, 10), "how this section renders", normalizeHomeMode(mode), "", []pickerOption{
		{
			Value: "list", Label: "list", Icon: "list",
			HxPost:   "/settings/home",
			HxTarget: "#settings-home-card",
			HxVals:   `{"action":"mode","collection_id":"` + strconv.FormatInt(collectionID, 10) + `","mode":"list"}`,
		},
		{
			Value: "grid", Label: "grid", Icon: "grid",
			HxPost:   "/settings/home",
			HxTarget: "#settings-home-card",
			HxVals:   `{"action":"mode","collection_id":"` + strconv.FormatInt(collectionID, 10) + `","mode":"grid"}`,
		},
		{
			Value: "cards", Label: "cards", Icon: "cards",
			HxPost:   "/settings/home",
			HxTarget: "#settings-home-card",
			HxVals:   `{"action":"mode","collection_id":"` + strconv.FormatInt(collectionID, 10) + `","mode":"cards"}`,
		},
	})
}

// homeSectionModeControl is homeModeControl as it appears in a dashboard
// section header: the options POST to the section endpoint and swap just that
// section in place (outerHTML), rather than the settings card.
templ homeSectionModeControl(collectionID int64, mode string) {
	{{ id := strconv.FormatInt(collectionID, 10) }}
	{{ endpoint := "/home/sections/" + id }}
	{{ target := "#home-section-" + id }}
	@PickerControl("mode-"+id, "how this section renders", normalizeHomeMode(mode), "", []pickerOption{
		{Value: "list", Label: "list", Icon: "list", HxPost: endpoint, HxTarget: target, HxVals: `{"action":"mode","mode":"list"}`},
		{Value: "grid", Label: "grid", Icon: "grid", HxPost: endpoint, HxTarget: target, HxVals: `{"action":"mode","mode":"grid"}`},
		{Value: "cards", Label: "cards", Icon: "cards", HxPost: endpoint, HxTarget: target, HxVals: `{"action":"mode","mode":"cards"}`},
	})
}

// homeSectionSortControl is the sort picker in a dashboard section header: the
// three sorts POST to the section endpoint and swap the section in place.
templ homeSectionSortControl(collectionID int64, sort string) {
	{{ id := strconv.FormatInt(collectionID, 10) }}
	{{ endpoint := "/home/sections/" + id }}
	{{ target := "#home-section-" + id }}
	@PickerControl("sort-"+id, "how this section is sorted", normalizeHomeSort(sort), "", []pickerOption{
		{Value: "magic", Label: "magic", Icon: "magic", HxPost: endpoint, HxTarget: target, HxVals: `{"action":"sort","sort":"magic"}`},
		{Value: "newest", Label: "newest", Icon: "desc", HxPost: endpoint, HxTarget: target, HxVals: `{"action":"sort","sort":"newest"}`},
		{Value: "oldest", Label: "oldest", Icon: "asc", HxPost: endpoint, HxTarget: target, HxVals: `{"action":"sort","sort":"oldest"}`},
	})
}

// homeSectionBlock is one pinned collection block on the dashboard: its title,
// the desktop-only display/sort pickers in the header, the item list, and the
// "more" link pinned to the bottom-right.
templ homeSectionBlock(sec homeSectionData) {
	{{ id := strconv.FormatInt(sec.Collection.ID, 10) }}
	<section class="home-section" id={ "home-section-" + id }>
		<div class="row home-section-head">
			<h2><a href={ "/collections/" + id }>{ sec.Collection.Name }</a></h2>
			<div class="row-actions home-section-controls">
				@homeSectionSortControl(sec.Collection.ID, sec.Sort.param())
				@homeSectionModeControl(sec.Collection.ID, sec.Mode)
			</div>
		</div>
		<ul class={ itemsListClass(sec.Mode) }>
			for _, it := range sec.Items {
				@ItemRow(it, false)
			}
		</ul>
		<div class="home-section-more">
			<a class="small" href={ "/collections/" + id }>more →</a>
		</div>
	</section>
}

// homeSortControl picks one pinned home section's item sort (newest, oldest, or
// magic — the default). Like homeModeControl it POSTs to /settings/home and the
// card is swapped back.
templ homeSortControl(collectionID int64, sort string) {
	@PickerControl("sort-"+strconv.FormatInt(collectionID, 10), "how this section is sorted", normalizeHomeSort(sort), "", []pickerOption{
		{
			Value: "magic", Label: "magic", Icon: "magic",
			HxPost:   "/settings/home",
			HxTarget: "#settings-home-card",
			HxVals:   `{"action":"sort","collection_id":"` + strconv.FormatInt(collectionID, 10) + `","sort":"magic"}`,
		},
		{
			Value: "newest", Label: "newest", Icon: "desc",
			HxPost:   "/settings/home",
			HxTarget: "#settings-home-card",
			HxVals:   `{"action":"sort","collection_id":"` + strconv.FormatInt(collectionID, 10) + `","sort":"newest"}`,
		},
		{
			Value: "oldest", Label: "oldest", Icon: "asc",
			HxPost:   "/settings/home",
			HxTarget: "#settings-home-card",
			HxVals:   `{"action":"sort","collection_id":"` + strconv.FormatInt(collectionID, 10) + `","sort":"oldest"}`,
		},
	})
}

// settingsHomeCard lets the user pin collections to their home screen, in
// order, and drag them to reorder. The list is a vaadin-grid; each row's markup
// is a server-rendered <template> (below) that the grid clones per item, so the
// row keeps its htmx attributes and the JS is limited to rendering and the
// drag-drop reorder POST. Empty collections simply don't render on the home page.
templ settingsHomeCard(d settingsHomeData) {
	<section class="card" id="settings-home-card">
		<h2>home screen</h2>
		<p class="muted small">Pin collections to your home page. Each shows that collection's unread items; a collection with no unread items is hidden. Pick list or grid per section, choose how each section sorts (magic is the default), and drag a row to reorder. With nothing pinned, home is your unread list.</p>
		if d.Error != "" {
			<div class="error" role="alert">{ d.Error }</div>
		}
		if len(d.Rows) == 0 {
			<p class="muted small">no pinned collections</p>
		} else {
			<vaadin-grid
				id="settings-home-grid"
				all-rows-visible
				rows-draggable
				drop-mode="between"
				items={ homeGridItemsJSON(d.Rows) }
				data-reorder-url="/settings/home"
				aria-label="pinned collections, drag to reorder"
			>
				<vaadin-grid-column></vaadin-grid-column>
			</vaadin-grid>
			for _, r := range d.Rows {
				<template id={ "settings-home-row-" + strconv.FormatInt(r.Collection.ID, 10) }>
					@homeGridRow(r)
				</template>
			}
		}
		if len(d.Collections) > 0 {
			<form class="pin-row" hx-post="/settings/home" hx-target="#settings-home-card" hx-swap="outerHTML">
				<input type="hidden" name="action" value="add"/>
				@comboSelect("add_collection", firstCollectionValue(d.Collections), "pin a collection", "pick a collection", collectionComboItems(d.Collections), nil)
				<button type="submit" class="small">pin</button>
			</form>
		}
		if len(d.Rows) > 0 {
			<button class="link" hx-post="/settings/home/reset" hx-target="#settings-home-card" hx-swap="outerHTML" hx-confirm="reset your home screen to the default unread list?">reset to default</button>
		}
		<div class="home-grid-columns">
			@appearanceGridColumns(settingsAppearanceData{GridMaxColumns: d.GridMaxColumns})
		</div>
	</section>
}

// homeGridRow is one row's markup, cloned by the grid once per pinned item. It
// is a plain server fragment (not grid-specific): the collection link, the
// render-mode picker, and the remove button, all wired with htmx.
templ homeGridRow(r settingsHomeRow) {
	<div class="home-grid-row">
		<a href={ "/collections/" + strconv.FormatInt(r.Collection.ID, 10) }>{ r.Collection.Name }</a>
		<div class="row-actions">
			@homeSortControl(r.Collection.ID, r.Sort)
			@homeModeControl(r.Collection.ID, r.Mode)
			<button class="link danger" title="remove" hx-post="/settings/home" hx-target="#settings-home-card" hx-swap="outerHTML" hx-vals={ `{"action":"remove","collection_id":"` + strconv.FormatInt(r.Collection.ID, 10) + `"}` }>@web.Lucide("x")</button>
		</div>
	</div>
}
