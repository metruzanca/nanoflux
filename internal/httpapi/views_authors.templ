package httpapi

import (
	"net/url"
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ authorsPage(u store.User, d authorsData) {
	<div class="row">
		<h1>authors</h1>
		<div class="row-actions">
			@AuthorSortControl()
			<button type="button" data-open="add-author-dialog">+ add feed</button>
		</div>
	</div>
	@AuthorsList(d.Rows)
	if len(d.Rows) == 0 {
		<p class="muted">paste a site or feed url and nanoflux will find the feed, creating an author for it when needed.</p>
	}

	<dialog id="add-author-dialog" class="modal">
		<div class="row">
			<h2>add feed</h2>
			<button type="button" class="link" data-close-dialog>@web.Lucide("x")</button>
		</div>
		<form class="stack" hx-post="/fragments/feed-preview" hx-target="#author-preview" hx-swap="innerHTML">
			<label>url
				<input id="feed-url-input" name="url" type="text" placeholder="https://site.com or /feed.xml" autofocus required/>
			</label>
			<div class="row">
				<button type="submit">find feed</button>
				@manualFeedButton("#author-preview")
			</div>
		</form>
		<div id="author-preview"></div>
	</dialog>

	<dialog id="create-author-dialog" class="modal">
		<form class="stack" hx-post="/authors">
			<div class="row">
				<h2>add author</h2>
				<button type="button" class="link" data-close-dialog>@web.Lucide("x")</button>
			</div>
			<label>name
				<input name="name" autofocus required/>
			</label>
			<label>avatar url
				<input name="avatar_url" type="url"/>
			</label>
			<label>description
				<textarea name="description" rows="3"></textarea>
			</label>
			@authorLinkFields(authorsData{})
			<div id="add-author-error" class="error"></div>
			<button type="submit">add author</button>
		</form>
	</dialog>
}

templ AuthorsList(rows []authorRow) {
	<ul class="plain" id="authors-list">
		for _, r := range rows {
			@AuthorRow(r)
		}
	</ul>
}

templ AuthorRow(r authorRow) {
	<li id={ "author-" + strconv.FormatInt(r.ID, 10) } data-name={ r.Name } data-created={ r.CreatedAt } data-unread={ strconv.Itoa(r.Unread) } data-taste={ strconv.Itoa(r.Taste) }>
		<div class="row">
			<a href={ "/authors/" + strconv.FormatInt(r.ID, 10) }>
				if r.AvatarKey != "" {
					<img class="avatar avatar-sm" src={ "/authors/" + strconv.FormatInt(r.ID, 10) + "/avatar?v=" + url.QueryEscape(r.LastFetchedAt) } alt=""/>
				} else if r.AvatarURL != "" {
					<img class="avatar avatar-sm" src={ web.ProxiedImageURL(r.AvatarURL) } data-hide-on-error alt=""/>
				}
				<strong>{ r.Name }</strong>
			</a>
			<span class="muted"><span class="unread-count">{ r.Unread } unread</span> · { r.FeedCount } feeds
				if r.ViewCount > 0 {
					· { strconv.Itoa(r.ViewCount) }
					if r.ViewCount == 1 {
						view
					} else {
						views
					}
				}
			</span>
		</div>
	</li>
}

// authorEditPage is a set of independently auto-saving sections: the author
// profile, the always-on filter card (manual apply), the collapsible auto-read
// override (manual apply), and one accordion of sources (feeds and views). Each
// feed and view panel is its own form, so a change saves just that panel.
templ authorEditPage(u store.User, d authorsData) {
	@authorBasicsCard(d)
	@authorFilterCard(d)
	@authorAutoReadCard(d)
	{{ sources := len(d.Feeds) + len(d.Views) }}
	<div class="author-sources">
		<h2>sources</h2>
		if sources == 0 {
			<p class="muted small">no sources yet. add a feed from the add menu, or create a view from any item list.</p>
		} else {
			<div class="feed-accordion">
				for _, r := range d.Feeds {
					@feedAccordionItem(r, d.Editor)
				}
				for _, r := range d.Views {
					@viewAccordionItem(u, r, d.ViewEditor)
				}
			</div>
		}
	</div>
	<div class="stack delete-form">
		<button type="button" class="danger" data-post-action={ "/authors/" + strconv.FormatInt(d.Form.ID, 10) + "/delete" } data-confirm={ "delete author " + d.Form.Name + " and their feeds?" }>{ "delete author " + d.Form.Name }</button>
	</div>
}

// authorBasicsCard is the author's own fields and links. It saves on change and
// re-renders itself, so the avatar and link rows stay current after a save.
templ authorBasicsCard(d authorsData) {
	{{ action := "/authors/" + strconv.FormatInt(d.Form.ID, 10) + "/edit" }}
	<section id="author-basics-card" class="card">
		<form class="stack" method="post" action={ action } hx-post={ action } hx-trigger="change delay:600ms, submit" hx-sync="closest form:replace" hx-target="#author-basics-card" hx-swap="outerHTML" hx-disinherit="*" data-autosave>
			@csrfField()
			<div class="row">
				<h2>profile</h2>
				<a class="button small" href={ "/authors/" + strconv.FormatInt(d.Form.ID, 10) }>close</a>
			</div>
			if d.FormError != "" {
				<div class="error" role="alert">{ d.FormError }</div>
			}
			@authorAvatarFields(d.AvatarCard)
			@authorFields(d)
			@authorLinkFields(d)
		</form>
	</section>
}

// authorAvatarFields renders the avatar section at the top of the edit form:
// the image (with its cache status) sits to the left, and the avatar url input
// and refetch button inline to its right. The url input lives outside
// #author-avatar-card so a refetch (which swaps the card via outerHTML) leaves
// the input's unsaved value alone.
templ authorAvatarFields(d authorAvatarCardData) {
	<div class="avatar-edit">
		@authorAvatarCard(d)
		<input class="avatar-edit-url" name="avatar_url" type="url" value={ d.AvatarURL } placeholder="avatar url" aria-label="avatar url"/>
		<button type="button" class="link" title="re-fetch the avatar from its url" hx-post={ "/authors/" + strconv.FormatInt(d.ID, 10) + "/avatar-refresh" } hx-params="none" hx-target="#author-avatar-card" hx-swap="outerHTML">refetch avatar</button>
	</div>
}

// authorAvatarCard is the swap target for the refetch button: the flash, the
// avatar image (or its placeholder) and the cached/not-cached status. It is a
// display:contents box so its children lay out inside .avatar-edit's grid.
templ authorAvatarCard(d authorAvatarCardData) {
	<div id="author-avatar-card" class="avatar-edit-card">
		if d.Flash != "" {
			<div class="error" role="alert">{ d.Flash }</div>
		}
		if d.AvatarKey != "" {
			<img class="avatar avatar-lg avatar-edit-visual" src={ "/authors/" + strconv.FormatInt(d.ID, 10) + "/avatar?v=" + url.QueryEscape(d.LastFetchedAt) } alt=""/>
		} else if d.AvatarURL != "" {
			<img class="avatar avatar-lg avatar-edit-visual" src={ web.ProxiedImageURL(d.AvatarURL) } data-hide-on-error alt=""/>
		} else {
			<span class="muted avatar-edit-visual">no avatar url set</span>
		}
		<span class="muted small avatar-edit-status">
			if d.AvatarKey != "" {
				cached { web.TimeFmt(d.Timezone, d.LastFetchedAt) }
			} else {
				not cached yet
			}
		</span>
	</div>
}

// authorFilterCard configures the author's always-on allow/block rules. It is
// a collapsible card that auto-opens when rules exist; edits still preview
// live, but the rules are only persisted by the explicit apply button.
templ authorFilterCard(d authorsData) {
	<details id="author-filter-card" class="card author-filter-card" open?={ len(d.Rules) > 0 } data-author-filters data-filter-scope
		hx-post={ "/authors/" + strconv.FormatInt(d.Form.ID, 10) + "/filters/preview" }
		hx-trigger="change delay:400ms, authorfilterschanged"
		hx-include="#author-filter-fields"
		hx-target="#author-filter-preview"
		hx-swap="innerHTML">
		<summary>
			<h2>filters</h2>
			if len(d.Rules) > 0 {
				<span class="badge">{ strconv.Itoa(len(d.Rules)) } rules</span>
			}
		</summary>
		<p class="muted small">Always on. Allow rows must all match; block rows hide matching posts. Filters apply to every list and count for this author, and to views assigned to them. Views are not filtered by the author who owns the feed they draw from.</p>
		if d.FilterError != "" {
			<div class="error" role="alert">{ d.FilterError }</div>
		}
		<input type="hidden" name="author_filters_present" value="1"/>
		<div id="author-filter-fields">
			<div class="filter-rows" id="author-filter-rows" data-filter-rows>
				for i, f := range d.Rules {
					@filterRow("author-filter-"+strconv.Itoa(i), strconv.Itoa(i), f.Kind, f.Action, f.Combine, f.Values, d.FilterTagOptions, d.FilterFeedOptions, []string{filterKindTag, filterKindFeed}, true, "")
				}
				if len(d.Rules) == 0 {
					@filterRow("author-filter-empty", "empty", filterKindTag, filterShow, filterAll, nil, d.FilterTagOptions, d.FilterFeedOptions, []string{filterKindTag, filterKindFeed}, true, "")
				}
			</div>
			<template id="author-filter-row-template" data-filter-row-template>
				@filterRow("author-filter-__token__", "__token__", filterKindTag, filterShow, filterAll, nil, d.FilterTagOptions, d.FilterFeedOptions, []string{filterKindTag, filterKindFeed}, true, "")
			</template>
		</div>
		<div class="row-actions">
			<button type="button" class="link" data-add-filter-row>@web.Lucide("plus") add filter</button>
			<button type="button" hx-post={ "/authors/" + strconv.FormatInt(d.Form.ID, 10) + "/filters" } hx-include="#author-filter-fields" hx-target="#author-filter-card" hx-swap="outerHTML">apply</button>
		</div>
		<div id="author-filter-preview" class="author-filter-preview">
			@authorFilterPreviewFragment(d.FilterPreview)
		</div>
	</details>
}

// authorAutoReadCard overrides the account auto-read window for this author's
// feeds. "inherit" follows the account setting; off keeps the author's items
// unread. It is collapsible and saves from its explicit apply button.
templ authorAutoReadCard(d authorsData) {
	{{ action := "/authors/" + strconv.FormatInt(d.Form.ID, 10) + "/auto-read" }}
	<details id="author-auto-read-card" class="card author-auto-read-card" open?={ d.AutoReadValue != "inherit" || d.AutoReadError != "" }>
		<summary>
			<h2>auto-read</h2>
		</summary>
		<form class="stack" method="post" action={ action } hx-post={ action } hx-sync="closest form:replace" hx-target="#author-auto-read-card" hx-swap="outerHTML" hx-disinherit="*">
			@csrfField()
			<p class="muted small">Overrides the account auto-read window for this author's feeds. Items older than the effective window are marked read automatically, including favorites and bookmarks. Off keeps this author's items unread.</p>
			<input type="hidden" name="author_auto_read_present" value="1"/>
			if d.AutoReadError != "" {
				<div class="error" role="alert">{ d.AutoReadError }</div>
			}
			@comboSelect("author_auto_read_after_days", d.AutoReadValue, "mark items read after", "select a window", authorAutoReadItems, nil)
			<p class="muted small">account default: { d.AutoReadDefault }</p>
			<div class="row-actions">
				<button type="submit">apply</button>
			</div>
		</form>
	</details>
}

// authorFilterPreviewFragment renders the allowed/blocked sample. It is used for
// the initial page render and the live htmx preview.
templ authorFilterPreviewFragment(p store.AuthorFilterPreview) {
	<div class="filter-preview-grid">
		<div>
			<h3>allowed ({ strconv.Itoa(p.AllowedCount) })</h3>
			if len(p.Allowed) == 0 {
				<p class="muted small">no allowed posts</p>
			} else {
				<ul class="filter-preview-list">
					for _, it := range p.Allowed {
						<li>
							<span class="filter-preview-title">{ it.Title }</span>
							<span class="muted small">{ it.FeedTitle }
								if it.PublishedAt != "" {
									· { web.TimeFmt("", it.PublishedAt) }
								}
							</span>
						</li>
					}
				</ul>
			}
		</div>
		<div>
			<h3>blocked ({ strconv.Itoa(p.BlockedCount) })</h3>
			if len(p.Blocked) == 0 {
				<p class="muted small">no blocked posts</p>
			} else {
				<ul class="filter-preview-list">
					for _, it := range p.Blocked {
						<li>
							<span class="filter-preview-title">{ it.Title }</span>
							<span class="muted small">{ it.FeedTitle }
								if it.PublishedAt != "" {
									· { web.TimeFmt("", it.PublishedAt) }
								}
							</span>
						</li>
					}
				</ul>
			}
		</div>
	</div>
	<p class="muted small">{ strconv.Itoa(p.Total) } posts in scope · newest matches shown first</p>
}

templ authorFields(d authorsData) {
	<label>name
		<input name="name" value={ d.Form.Name } required/>
	</label>
	<label>description
		<textarea name="description" rows="3">{ d.Form.Description }</textarea>
	</label>
}

// authorLinkFields renders an author's external bookmarks as editable form
// rows. Each row is a hidden link id plus label/url; a row with no id creates a
// new link, an existing id updates in place, and a link whose row was removed
// from the form (its trash button) is deleted on save. The blank row is a
// <template> cloned client-side by addAuthorLinkRow. With no links the section
// collapses to the heading and add button on one line.
templ authorLinkFields(d authorsData) {
	<div class="row author-links-edit">
		<h2>links</h2>
		<button type="button" class="link" data-add-author-link>+ add link</button>
	</div>
	<input type="hidden" name="links_present" value="1"/>
	<div id="author-link-fields" class="stack">
		for _, l := range d.Links {
			@authorLinkFieldRow(strconv.FormatInt(l.ID, 10), l.Label, l.URL)
		}
	</div>
	<template id="author-link-row-template">
		@authorLinkFieldRow("", "", "")
	</template>
}

templ authorLinkFieldRow(id, label, linkURL string) {
	<div class="author-link-row">
		<input type="hidden" name="link_id" value={ id }/>
		<input name="link_label" type="text" value={ label } placeholder="label (optional)" aria-label="link label"/>
		<input name="link_url" type="text" value={ linkURL } placeholder="https://..." aria-label="link url"/>
		<button type="button" class="link danger" title="remove link" data-remove-closest=".author-link-row">@web.Lucide("trash-2")</button>
	</div>
}

// authorPageLinks renders an author's external bookmarks inline in the author
// card, under the author's name. A link with a Simple Icons glyph shows it; an
// unlabeled link with a glyph is icon-only (the domain stays its accessible
// name). Each link is external (marked ↗).
templ authorPageLinks(links []store.AuthorLink, icons map[string][]string) {
	if len(links) > 0 {
		<p class="author-links">
			for i, l := range links {
				if i > 0 {
					·
				}
				{{ domain := web.LinkDomain(l.URL) }}
				{{ name := web.LinkLabel(l.Label, l.URL) }}
				{{ paths := icons[domain] }}
				if l.Label != "" {
					<a href={ templ.URL(l.URL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">
						if len(paths) > 0 {
							@web.LinkIcon(paths, "link-icon")
						}
						<span class="link-label">{ l.Label }</span>
					</a>
				} else {
					<a href={ templ.URL(l.URL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external" title={ name } aria-label={ name }>
						if len(paths) > 0 {
							@web.LinkIcon(paths, "link-icon")
						} else {
							{ domain }
						}
					</a>
				}
			}
		</p>
	}
}

templ authorPage(u store.User, d authorData) {
	<section class="card">
		<div class="author-head">
			<div class="author-head-identity">
				if d.Author.AvatarKey != "" {
					<img class="avatar avatar-lg" src={ "/authors/" + strconv.FormatInt(d.Author.ID, 10) + "/avatar?v=" + url.QueryEscape(d.Author.LastFetchedAt) } alt=""/>
				} else if d.Author.AvatarURL != "" {
					<img class="avatar avatar-lg" src={ web.ProxiedImageURL(d.Author.AvatarURL) } data-hide-on-error alt=""/>
				}
				<h1>{ d.Author.Name }</h1>
			</div>
			<div class="row-actions">
				@markAllReadControl(d.MarkAll)
				<a class="small" title="edit" href={ "/authors/" + strconv.FormatInt(d.Author.ID, 10) + "/edit" }>@web.EditIcon()</a>
			</div>
		</div>
		@authorPageLinks(d.Links, d.LinkIcons)
		if d.Author.Description != "" {
			<p>{ d.Author.Description }</p>
		}
		@authorStats(d.Stats, len(d.Rows), d.Frequency, d.Timezone)
		if len(d.Collections) > 0 {
			<div class="author-collections" aria-label="collections this author's feeds belong to">
				for _, c := range d.Collections {
					<a class="tag" href={ "/collections/" + strconv.FormatInt(c.ID, 10) } title={ c.Name }>#{ c.Name }</a>
				}
			</div>
		}
		{{ sources := len(d.Rows) + len(d.Views) }}
		if sources > 0 {
			<details class="author-feeds">
				<summary>sources ({ strconv.Itoa(sources) })</summary>
				<div class="author-feeds-body">
					if len(d.Rows) > 0 {
						@FeedsList(d.Rows)
					}
					if len(d.Views) > 0 {
						<ul class="feed-cards">
							for _, v := range d.Views {
								@savedViewCard(v)
							}
						</ul>
					}
				</div>
			</details>
		}
	</section>
	<div class="author-items">
		@ScopedItems(d.Scoped)
	</div>
}

templ authorCreateFields(d authorPreviewForm) {
	<div class="new-author">
		<label>new author name
			<input name="author_name" type="text" value={ d.Name } required/>
		</label>
		<label>avatar url
			<input name="avatar_url" type="url" value={ d.AvatarURL }/>
		</label>
	</div>
}

// authorStats shows aggregate numbers across all of an author's feeds: posts
// published, the posting cadence, and how fresh the newest post is. Rendered
// inside the author card.
templ authorStats(s store.AuthorItemStats, feedCount int, frequency, tz string) {
	if s.Total > 0 || feedCount > 0 {
		<div class="author-stats">
			<div class="row stats" aria-label="author statistics">
				<span><strong>{ s.Total }</strong> posts</span>
				<span><strong>{ feedCount }</strong> feeds</span>
				if frequency != "" {
					<span title="approximate posting frequency"><strong>{ frequency }</strong></span>
				}
				if s.Recent > 0 {
					<span><strong>{ s.Recent }</strong> in last 30 days</span>
				}
				if s.Favorites > 0 {
					<span><strong>{ s.Favorites }</strong> favorited</span>
				}
				if s.Storage > 0 {
					<span title="cached media for this author's feeds"><strong>{ web.FormatBytes(s.Storage) }</strong> cached</span>
				}
			</div>
			if s.FirstAt != "" {
				<div class="item-meta">
					first post { web.TimeFmt(tz, s.FirstAt) } · newest post { web.TimeFmt(tz, s.LastAt) }
				</div>
			}
		</div>
	}
}
