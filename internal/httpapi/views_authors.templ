package httpapi

import (
	"net/url"
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ authorsPage(u store.User, d authorsData) {
	<div class="row">
		<h1>authors</h1>
		<div class="row-actions">
			@AuthorSortControl()
			<button type="button" onclick="document.getElementById('add-author-dialog').showModal()">+ add feed</button>
		</div>
	</div>
	@AuthorsList(d.Rows)
	if len(d.Rows) == 0 {
		<p class="muted">paste a site or feed url and nanoflux will find the feed, creating an author for it when needed.</p>
	}

	<dialog id="add-author-dialog" class="modal">
		<div class="row">
			<h2>add feed</h2>
			<button type="button" class="link" onclick="this.closest('dialog').close()">@web.Lucide("x")</button>
		</div>
		<form class="stack" hx-post="/fragments/feed-preview" hx-target="#author-preview" hx-swap="innerHTML">
			<label>url
				<input id="feed-url-input" name="url" type="text" placeholder="https://site.com or /feed.xml" autofocus required/>
			</label>
			<button type="submit">find feed</button>
		</form>
		<div id="author-preview"></div>
	</dialog>
}

templ AuthorsList(rows []authorRow) {
	<ul class="plain" id="authors-list">
		for _, r := range rows {
			@AuthorRow(r)
		}
	</ul>
}

templ AuthorRow(r authorRow) {
	<li id={ "author-" + strconv.FormatInt(r.ID, 10) } data-name={ r.Name } data-created={ r.CreatedAt } data-unread={ strconv.Itoa(r.Unread) }>
		<div class="row">
			<a href={ "/authors/" + strconv.FormatInt(r.ID, 10) }>
				if r.AvatarKey != "" {
					<img class="avatar avatar-sm" src={ "/authors/" + strconv.FormatInt(r.ID, 10) + "/avatar?v=" + url.QueryEscape(r.LastFetchedAt) } alt=""/>
				} else if r.AvatarURL != "" {
					<img class="avatar avatar-sm" src={ "/img?u=" + url.QueryEscape(r.AvatarURL) } onerror="this.style.display='none'" alt=""/>
				}
				<strong>{ r.Name }</strong>
			</a>
			<span class="muted"><span class="unread-count">{ r.Unread } unread</span> · { r.FeedCount } feeds</span>
		</div>
	</li>
}

templ authorEditPage(u store.User, d authorsData) {
	<section class="card">
		<h1>edit author</h1>
		<form class="stack" method="post" action={ "/authors/" + strconv.FormatInt(d.Form.ID, 10) + "/edit" }>
			@authorFields(d)
			@authorLinkFields(d)
			@authorAvatarFields(d.AvatarCard)
			<button type="submit">save</button>
		</form>
		<form class="stack delete-form" method="post" action={ "/authors/" + strconv.FormatInt(d.Form.ID, 10) + "/delete" } onsubmit="return confirm('delete this author and their feeds?')">
			<button type="submit" class="danger">delete</button>
		</form>
	</section>
}

// authorAvatarFields renders the avatar section inside the edit form: the
// image, its cache status, the refetch button, and the avatar url input sit
// together. The refetch button swaps only the inner #author-avatar-card (image
// + status + button), leaving the avatar url input's unsaved value alone.
templ authorAvatarFields(d authorAvatarCardData) {
	<h2>avatar</h2>
	<div id="author-avatar-card">
		if d.Flash != "" {
			<div class="error" role="alert">{ d.Flash }</div>
		}
		<div class="row">
			<div class="row">
				if d.AvatarKey != "" {
					<img class="avatar avatar-lg" src={ "/authors/" + strconv.FormatInt(d.ID, 10) + "/avatar?v=" + url.QueryEscape(d.LastFetchedAt) } alt=""/>
				} else if d.AvatarURL != "" {
					<img class="avatar avatar-lg" src={ "/img?u=" + url.QueryEscape(d.AvatarURL) } onerror="this.style.display='none'" alt=""/>
				} else {
					<span class="muted">no avatar url set</span>
				}
				<span class="muted small">
					if d.AvatarKey != "" {
						cached { web.TimeFmt(d.Timezone, d.LastFetchedAt) }
					} else {
						not cached yet
					}
				</span>
			</div>
			<div class="row-actions">
				<button type="button" class="link" title="re-fetch the avatar from its url" hx-post={ "/authors/" + strconv.FormatInt(d.ID, 10) + "/avatar-refresh" } hx-target="#author-avatar-card" hx-swap="outerHTML">refetch avatar</button>
			</div>
		</div>
	</div>
	<label>avatar url
		<input name="avatar_url" type="url" value={ d.AvatarURL }/>
	</label>
}

templ authorFields(d authorsData) {
	<label>name
		<input name="name" value={ d.Form.Name } required/>
	</label>
	<label>url
		<input name="url" type="url" value={ d.Form.URL }/>
	</label>
	<label>description
		<textarea name="description" rows="3">{ d.Form.Description }</textarea>
	</label>
}

// authorLinkFields renders an author's external bookmarks as editable form
// rows. Each row is a hidden link id plus label/url; a row with no id creates a
// new link, an existing id updates in place, and a link whose row was removed
// from the form (its ✕) is deleted on save. The blank row is a <template>
// cloned client-side by addAuthorLinkRow.
templ authorLinkFields(d authorsData) {
	<h2>links</h2>
	<input type="hidden" name="links_present" value="1"/>
	<div id="author-link-fields" class="stack">
		for _, l := range d.Links {
			@authorLinkFieldRow(strconv.FormatInt(l.ID, 10), l.Label, l.URL)
		}
	</div>
	<button type="button" class="link" onclick="addAuthorLinkRow()">+ add link</button>
	<template id="author-link-row-template">
		@authorLinkFieldRow("", "", "")
	</template>
}

templ authorLinkFieldRow(id, label, linkURL string) {
	<div class="author-link-row">
		<input type="hidden" name="link_id" value={ id }/>
		<label>label
			<input name="link_label" type="text" value={ label } placeholder="optional"/>
		</label>
		<label>url
			<input name="link_url" type="text" value={ linkURL } placeholder="https://..."/>
		</label>
		<button type="button" class="link danger" title="remove link" onclick="this.closest('.author-link-row').remove()">@web.Lucide("x")</button>
	</div>
}

// authorPageLinks renders an author's external bookmarks inline in the author
// card, under the home url. Each is an external link (marked ↗).
templ authorPageLinks(links []store.AuthorLink) {
	if len(links) > 0 {
		<p class="author-links">
			for i, l := range links {
				if i > 0 {
					· 
				}
				<a href={ templ.URL(l.URL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">{ web.LinkLabel(l.Label, l.URL) }</a>
			}
		</p>
	}
}

templ authorPage(u store.User, d authorData) {
	<section class="card">
		<div class="row">
			<div class="row">
				if d.Author.AvatarKey != "" {
					<img class="avatar avatar-lg" src={ "/authors/" + strconv.FormatInt(d.Author.ID, 10) + "/avatar?v=" + url.QueryEscape(d.Author.LastFetchedAt) } alt=""/>
				} else if d.Author.AvatarURL != "" {
					<img class="avatar avatar-lg" src={ "/img?u=" + url.QueryEscape(d.Author.AvatarURL) } onerror="this.style.display='none'" alt=""/>
				}
				<h1>{ d.Author.Name }</h1>
			</div>
			<a class="small" title="edit" href={ "/authors/" + strconv.FormatInt(d.Author.ID, 10) + "/edit" }>@web.EditIcon()</a>
		</div>
		if d.Author.URL != "" {
			<p><a href={ templ.URL(d.Author.URL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">{ d.Author.URL }</a></p>
		}
		@authorPageLinks(d.Links)
		if d.Author.Description != "" {
			<p>{ d.Author.Description }</p>
		}
	</section>
	<div class="row">
		<h2>feeds</h2>
		<button type="button" onclick="document.getElementById('add-author-feed-dialog').showModal()">+ add feed</button>
	</div>
	@FeedsList(d.Rows)
	<h2>items</h2>
	@ScopedItems(d.Scoped)

	<dialog id="add-author-feed-dialog" class="modal">
		<div class="row">
			<h2>add feed for { d.Author.Name }</h2>
			<button type="button" class="link" onclick="this.closest('dialog').close()">@web.Lucide("x")</button>
		</div>
		<form class="stack" hx-post="/fragments/feed-preview" hx-target="#author-feed-preview" hx-swap="innerHTML">
			<input type="hidden" id="feed-author-id" name="author_id" value={ strconv.FormatInt(d.Author.ID, 10) }/>
			<input type="hidden" id="feed-author-scoped" name="scoped" value="1"/>
			<label>url
				<input id="feed-url-input" name="url" type="text" placeholder="https://site.com or /feed.xml" autofocus required/>
			</label>
			<button type="submit">find feed</button>
		</form>
		<div id="author-feed-preview"></div>
	</dialog>
}

templ authorCreateFields(d authorPreviewForm) {
	<div class="new-author">
		<label>new author name
			<input name="author_name" type="text" value={ d.Name } required/>
		</label>
		<label>new author url
			<input name="author_url" type="url" value={ d.URL }/>
		</label>
		<label>avatar url
			<input name="avatar_url" type="url" value={ d.AvatarURL }/>
		</label>
	</div>
}