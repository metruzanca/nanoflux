package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/pluginapi"
)

// provisionFormFields is the create form for one provisioning plugin, shown in
// the shared #provision-dialog. The author is not chosen here: a created feed is
// its own author (defaulted to the feed title server-side), since the nav "add"
// menu is not scoped to an author. A create swaps the created panel into
// #provision-dialog-body; a validation error is an out-of-band swap into
// #provision-error, so the form stays put.
templ provisionFormFields(d provisionFormData) {
	<form class="stack" hx-post="/feeds/provision" hx-target="#provision-dialog-body" hx-swap="innerHTML">
		<input type="hidden" name="plugin" value={ d.Plugin }/>
		<p class="muted small">nanoflux will create a { d.Label } and show you the address to subscribe with.</p>
		<label>
			title
			<input name="title" type="text" placeholder={ d.Placeholder } autofocus required/>
		</label>
		<div id="provision-error" class="error"></div>
		<button type="submit">create feed</button>
	</form>
}

// provisionCreated is shown after a remote feed is created: the feed URL plus
// the display fields the plugin returned (the subscribe address), each with a
// copy control, and a deep link to the new feed.
templ provisionCreated(feedID int64, title string, fields []pluginapi.Field) {
	<div class="stack">
		<p><strong>{ title }</strong> was created.</p>
		if len(fields) > 0 {
			<p class="muted small">subscribe a newsletter with this address. it is the only credential — anyone with it can read the feed or unsubscribe you, so do not share it.</p>
			for _, f := range fields {
				<div class="copy-field">
					<span class="muted small">{ f.Label }</span>
					<input type="text" value={ f.Value } readonly data-select-on-click/>
					<button type="button" class="link" data-copy-prev>copy</button>
				</div>
			}
		}
		<a class="button" href={ "/feeds/" + strconv.FormatInt(feedID, 10) }>open the feed</a>
	</div>
}

// feedPluginPanel is the "managed by a plugin" card on a feed's edit page: the
// plugin's display fields (the subscribe address) and a title-sync action.
// Remote deletion is the edit page's delete form ("also delete it on the remote
// service"), so the card offers no destructive action of its own. The sync form
// posts to /feeds/{id}/plugin-admin and re-renders this card.
templ feedPluginPanel(d feedPanelData) {
	<section class="card" id={ "feed-plugin-panel-" + strconv.FormatInt(d.FeedID, 10) }>
		<div class="row">
			<h2>managed feed</h2>
		</div>
		if d.Message != "" {
			<div class="notice">{ d.Message }</div>
		}
		<div id={ pluginPanelErrorID(d.FeedID) } class="error"></div>
		if len(d.Fields) > 0 {
			for _, f := range d.Fields {
				<div class="copy-field">
					<span class="muted small">{ f.Label }</span>
					<input type="text" value={ f.Value } readonly data-select-on-click/>
					<button type="button" class="link" data-copy-prev>copy</button>
				</div>
			}
		}
		<p class="muted small">sync the feed title to the remote service. to remove the feed there too, use the delete form above.</p>
		<div class="row-actions">
			<form hx-post={ "/feeds/" + strconv.FormatInt(d.FeedID, 10) + "/plugin-admin" } hx-target={ "#feed-plugin-panel-" + strconv.FormatInt(d.FeedID, 10) } hx-swap="outerHTML">
				<input type="hidden" name="action" value="save"/>
				<button type="submit" class="small">sync title</button>
			</form>
		</div>
	</section>
}
