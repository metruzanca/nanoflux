package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ collectionsPage(u store.User, rows []store.CollectionWithCounts) {
	<div class="row">
		<h1>collections</h1>
		<button type="button" data-action="addCollection">+ add collection</button>
	</div>
	@CollectionsList(rows)
}

// addCollectionDialog is fetched into the shared #add-collection-dialog. A
// successful save redirects to the new collection's page; the result container
// is what htmx resolves before the redirect.
templ addCollectionDialog() {
	<form class="stack" hx-post="/collections" hx-target="#add-collection-result" hx-swap="innerHTML" data-form-close-reset>
		<div class="row">
			<h2>add collection</h2>
			<button type="button" class="link" data-close-dialog>@web.Lucide("x")</button>
		</div>
		<label>name
			<input name="name" autofocus required/>
		</label>
		<div id="add-collection-error" class="error"></div>
		<button type="submit">add collection</button>
	</form>
	<div id="add-collection-result"></div>
}

// CollectionsList renders the user's collections, most unread first.
templ CollectionsList(rows []store.CollectionWithCounts) {
	<ul class="plain" id="collections-list">
		for _, c := range rows {
			@CollectionRow(c)
		}
	</ul>
	if len(rows) == 0 {
		<p class="muted" id="collections-empty">no collections yet — add one to group authors together.</p>
	}
}

// collectionCreated is the response to creating a collection: the new row plus
// an out-of-band delete of the empty-state note.
templ collectionCreated(c store.CollectionWithCounts) {
	@CollectionRow(c)
	<p id="collections-empty" hx-swap-oob="delete" hidden></p>
}

templ CollectionRow(c store.CollectionWithCounts) {
	<li id={ "collection-" + strconv.FormatInt(c.ID, 10) }>
		<div class="card">
			<div class="row">
				<div>
					<a href={ "/collections/" + strconv.FormatInt(c.ID, 10) }><strong>{ c.Name }</strong></a>
				</div>
			</div>
			<div class="item-meta">
				{ c.AuthorCount } authors
				· { c.Unread } unread
			</div>
		</div>
	</li>
}

// collectionRefreshNote is the response to "refresh all". The poller owns the
// fetches (it keeps per-host spacing and rate-limit cooldowns), so the request
// only reports what it queued and what it skipped.
templ collectionRefreshNote(queued, paused, limited int) {
	<span id="collection-refresh-status" class="muted small">
		if queued == 1 {
			queued 1 feed for a refresh
		} else if queued > 1 {
			queued { queued } feeds for a refresh
		} else {
			nothing to refresh
		}
		if paused > 0 {
			· { queuedLabel(paused, "paused") }
		}
		if limited > 0 {
			· { queuedLabel(limited, "rate limited") }
		}
	</span>
}

// queuedLabel renders a skip count with its reason, e.g. "2 paused".
func queuedLabel(n int, label string) string {
	return strconv.Itoa(n) + " " + label
}

templ collectionPage(u store.User, d collectionData) {
	<div class="row">
		<h1>{ d.Collection.Name }</h1>
		<div class="row-actions">
			if len(d.Authors) > 0 {
				<button type="button" title="fetch every feed from this collection's authors now" hx-post={ "/collections/" + strconv.FormatInt(d.Collection.ID, 10) + "/refresh" } hx-target="#collection-refresh-status" hx-swap="outerHTML">@web.Lucide("refresh-cw") refresh all</button>
				<span id="collection-refresh-status" class="muted small"></span>
			}
			@markAllReadControl(d.MarkAll)
			<a class="button" title="edit" href={ "/collections/" + strconv.FormatInt(d.Collection.ID, 10) + "/edit" }>@web.EditIcon() edit</a>
			if len(d.AllAuthors) > 0 {
				<button type="button" data-open="collection-add-author-dialog">+ add author</button>
			}
		</div>
	</div>
	@ScopedItems(d.Scoped)

	if len(d.AllAuthors) > 0 {
		<dialog id="collection-add-author-dialog" class="modal">
			<div class="row">
				<h2>add author</h2>
				<button type="button" class="link" data-close-dialog>@web.Lucide("x")</button>
			</div>
			<form class="stack" hx-post={ "/collections/" + strconv.FormatInt(d.Collection.ID, 10) + "/add-author" } hx-target="#scoped-items" hx-swap="outerHTML" data-form-close-reset>
				<input type="hidden" name="tab" value={ d.Scoped.View }/>
				@comboSelect("author_id", d.AllAuthors[0].Value, "author", "search authors", d.AllAuthors, nil)
				<button type="submit">add</button>
			</form>
		</dialog>
	}
}

// collectionEditPage edits a collection's name, its member authors, and deletes
// it. Collections group authors, so a feed joins a collection by adding its
// author.
templ collectionEditPage(u store.User, d collectionData) {
	<section class="card">
		<div class="row">
			<h1>edit collection</h1>
		</div>
		<form class="stack" method="post" action={ "/collections/" + strconv.FormatInt(d.Collection.ID, 10) + "/edit" }>
			@csrfField()
			<label>name
				<input name="name" value={ d.Collection.Name } required/>
			</label>
			<button type="submit">save</button>
		</form>
		<div class="stack delete-form">
			<button type="button" class="danger" data-post-action={ "/collections/" + strconv.FormatInt(d.Collection.ID, 10) + "/delete" } data-confirm="delete this collection?">delete</button>
		</div>
	</section>
	<section class="card">
		<h2>authors</h2>
		@collectionAuthors(d)
		if len(d.AllAuthors) > 0 {
			<form class="stack" hx-post={ "/collections/" + strconv.FormatInt(d.Collection.ID, 10) + "/add-author" } hx-target="#collection-authors" hx-swap="outerHTML">
				<input type="hidden" name="edit" value="1"/>
				@comboSelect("author_id", d.AllAuthors[0].Value, "add an author", "search authors", d.AllAuthors, nil)
				<button type="submit">add author</button>
			</form>
		}
	</section>
}

// CollectionAuthorCards lists a collection's member authors as cards for the
// collection page's "sources" tab.
templ CollectionAuthorCards(rows []authorRow) {
	if len(rows) == 0 {
		<p class="muted">no authors in this collection</p>
		return
	}
	<ul class="plain" id="collection-authors-list" data-feed-sort-list>
		for _, r := range rows {
			@AuthorRow(r)
		}
	</ul>
}

// collectionAuthors renders the collection's member authors as remove-able
// chips. Removing an author removes their feeds and views from the collection.
templ collectionAuthors(d collectionData) {
	if len(d.Authors) == 0 {
		<p class="muted" id="collection-authors">no authors in this collection</p>
		return
	}
	<div id="collection-authors">
		@comboChips(removeAuthorURL(d.Collection), authorRowIDs(d.Authors), authorRowItems(d.Authors), false)
	</div>
}
