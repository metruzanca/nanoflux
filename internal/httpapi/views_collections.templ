package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

templ collectionsPage(u store.User, rows []store.CollectionWithCounts) {
	<div class="row">
		<h1>collections</h1>
		<button type="button" onclick="document.getElementById('add-collection-dialog').showModal()">+ add collection</button>
	</div>
	@CollectionsList(rows)

	<dialog id="add-collection-dialog" class="modal">
		<form class="stack" hx-post="/collections" hx-target="#collections-list" hx-swap="beforeend" hx-on::after-request="if(event.detail.successful && event.detail.elt === this){this.closest('dialog').close();this.reset()}">
			<div class="row">
				<h2>add collection</h2>
				<button type="button" class="link" onclick="this.closest('dialog').close()">@web.Lucide("x")</button>
			</div>
			<label>name
				<input name="name" autofocus required/>
			</label>
			<div id="add-collection-error" class="error"></div>
			<button type="submit">add collection</button>
		</form>
	</dialog>
}

templ CollectionsList(rows []store.CollectionWithCounts) {
	<ul class="plain" id="collections-list">
		for _, c := range rows {
			@CollectionRow(c)
		}
	</ul>
}

templ CollectionRow(c store.CollectionWithCounts) {
	<li id={ "collection-" + strconv.FormatInt(c.ID, 10) }>
		<div class="card">
			<div class="row">
				<div>
					<a href={ "/collections/" + strconv.FormatInt(c.ID, 10) }><strong>{ c.Name }</strong></a>
					if c.IsAuto {
						<span class="badge">auto</span>
					}
				</div>
			</div>
			<div class="item-meta">
				{ c.FeedCount } feeds · { c.Unread } unread · { c.Read } read
			</div>
		</div>
	</li>
}

templ collectionPage(u store.User, d collectionData) {
	<div class="row">
		<h1>{ d.Collection.Name }</h1>
		<div class="row-actions">
			if d.Collection.IsAuto {
				<span class="badge">auto</span>
			}
			<a class="small" title="edit" href={ "/collections/" + strconv.FormatInt(d.Collection.ID, 10) + "/edit" }>@web.EditIcon()</a>
			if !d.Collection.IsAuto {
				<button type="button" onclick="document.getElementById('collection-add-feed-dialog').showModal()">+ add feed</button>
			}
		</div>
	</div>
	if d.Collection.IsAuto {
		<p class="muted small">auto collections are created from a feed's site and update automatically. Use edit to see every feed in this collection.</p>
	}
	@ScopedItems(d.Scoped)

	if !d.Collection.IsAuto {
		<dialog id="collection-add-feed-dialog" class="modal">
			<div class="row">
				<h2>add feed</h2>
				<button type="button" class="link" onclick="this.closest('dialog').close()">@web.Lucide("x")</button>
			</div>
			<form class="stack" hx-post={ "/collections/" + strconv.FormatInt(d.Collection.ID, 10) + "/add-feed" } hx-target="#scoped-items" hx-swap="outerHTML" hx-on::after-request="if(event.detail.successful && event.detail.elt === this){this.closest('dialog').close();this.reset()}">
				<input type="hidden" name="view" value={ d.Scoped.View }/>
				<select name="feed_id">
					for _, g := range d.AllFeeds {
						<optgroup label={ g.AuthorName }>
							for _, f := range g.Feeds {
								<option value={ strconv.FormatInt(f.ID, 10) }>{ f.Title }</option>
							}
						</optgroup>
					}
				</select>
				<button type="submit">add</button>
			</form>
		</dialog>
	}
}

// collectionEditPage edits a collection's name, removes its feeds, and deletes
// it — the collection's own management surface, mirroring the author/feed edit
// pages (delete lives in the form, not on the listing). Auto collections use the
// same screen to inspect their feeds, but the name is read-only and feeds can't
// be removed: they are managed from each feed's site.
templ collectionEditPage(u store.User, d collectionData) {
	<section class="card">
		<div class="row">
			<h1>edit collection</h1>
			if d.Collection.IsAuto {
				<span class="badge">auto</span>
			}
		</div>
		if d.Collection.IsAuto {
			<p class="muted small">auto collections follow a feed's site and can't be renamed or have feeds removed. Add or remove the feed itself to change this collection.</p>
			<form class="stack">
				<label>name
					<input name="name" value={ d.Collection.Name } readonly/>
				</label>
			</form>
		} else {
			<form class="stack" method="post" action={ "/collections/" + strconv.FormatInt(d.Collection.ID, 10) + "/edit" }>
				<label>name
					<input name="name" value={ d.Collection.Name } required/>
				</label>
				<button type="submit">save</button>
			</form>
		}
		<form class="stack delete-form" method="post" action={ "/collections/" + strconv.FormatInt(d.Collection.ID, 10) + "/delete" } onsubmit="return confirm('delete this collection?')">
			<button type="submit" class="danger">delete</button>
		</form>
	</section>
	<section class="card">
		<h2>feeds</h2>
		@collectionFeeds(d)
	</section>
}

templ collectionFeeds(d collectionData) {
	<ul class="plain" id="collection-feeds">
		if len(d.Feeds) > 0 {
			for _, f := range d.Feeds {
				<li>
					<div class="row">
						<a href={ "/feeds/" + strconv.FormatInt(f.ID, 10) }>{ f.Title }</a>
						if !d.Collection.IsAuto {
							<button class="link danger" title="remove" hx-post={ "/collections/" + strconv.FormatInt(d.Collection.ID, 10) + "/remove-feed/" + strconv.FormatInt(f.ID, 10) } hx-target="#collection-feeds" hx-swap="outerHTML">@web.Lucide("x")</button>
						}
					</div>
				</li>
			}
		} else {
			<li class="muted">no feeds in this collection</li>
		}
	</ul>
}
