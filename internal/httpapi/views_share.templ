package httpapi

// shareAddPage is the PWA share-target landing page. It runs the existing
// feed-preview flow for the shared URL, rendering the add form (or the picker,
// or the no-feed banner) into #share-preview; redirect=1 makes the save land on
// the new author's page.
templ shareAddPage(url string) {
	<h1>add feed</h1>
	<p class="muted small">Looking for a feed on { url }…</p>
	<input type="hidden" id="share-url" name="url" value={ url }/>
	<div id="share-preview"
		hx-post="/fragments/feed-preview"
		hx-trigger="load"
		hx-include="#share-url"
		hx-vals={ `{"redirect":"1"}` }
		hx-target="#share-preview"
		hx-swap="innerHTML">
		<p class="muted">searching…</p>
	</div>
}