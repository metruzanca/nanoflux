package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

// savedViewsPage is the private index of every saved view, grouped by the author
// it is assigned to (unassigned last).
templ savedViewsPage(d savedViewsPageData) {
	<div class="row">
		<h1>views ({ d.Total })</h1>
		<a class="button small" href="/unread">browse lists</a>
	</div>
	<p class="muted small">A view is a saved filter recipe. Create one with the bookmark button on any item list, then assign it to an author to keep it beside their feeds.</p>
	if d.Total == 0 {
		<p class="muted">no views yet. open a list, set your filters, and use “save this list as a view”.</p>
	} else {
		for _, g := range d.Groups {
			<section class="card">
				<div class="row">
					<h2>
						if g.AuthorID > 0 {
							<a href={ templ.URL("/authors/" + strconv.FormatInt(g.AuthorID, 10)) }>{ g.AuthorName }</a>
						} else {
							unassigned
						}
					</h2>
				</div>
				<ul class="feed-cards">
					for _, r := range g.Rows {
						@savedViewCard(r)
					}
				</ul>
			</section>
		}
	}
}

// savedViewCard is one view as a feed-style card: title, base tab, scope, filter
// chips and its matching-item count, with open/edit actions.
templ savedViewCard(r savedViewRow) {
	{{ id := strconv.FormatInt(r.ID, 10) }}
	{{ href := "/views/" + id }}
	if r.AuthorID > 0 {
		{{ href = "/authors/" + strconv.FormatInt(r.AuthorID, 10) + "?view=" + id }}
	}
	if len(r.Filters) == 0 {
		// A view from before filters became mandatory: send it to the editor.
		{{ href = "/views/" + id + "/edit" }}
	}
	<li id={ "view-" + id } class="feed-card-item">
		<div class="card feed-card">
			<div class="feed-card-main">
				<div class="feed-card-title">
					<a href={ templ.URL(href) }>
						<strong>{ r.Title } @web.Lucide("bookmark-plus")</strong>
					</a>
				</div>
				<div class="item-meta">
					{ r.Count } unread
					if r.AuthorID > 0 && r.AuthorName != "" {
						· assigned to <a href={ templ.URL("/authors/" + strconv.FormatInt(r.AuthorID, 10)) }>{ r.AuthorName }</a>
					}
				</div>
				if len(r.Filters) > 0 {
					<div class="chips active-tags">
						for _, f := range r.Filters {
							<span class={ "chip" } title={ f.Action + " " + f.Kind }>{ f.label() }</span>
						}
					</div>
				}
				if len(r.Collections) > 0 {
					<div class="chips active-tags" aria-label="collections">
						for _, c := range r.Collections {
							<a class="tag" href={ templ.URL("/collections/" + strconv.FormatInt(c.ID, 10)) } title={ c.Name }>#{ c.Name }</a>
						}
					</div>
				}
			</div>
			<div class="feed-card-side">
				<div class="row-actions">
					<a class="small" title="edit" href={ templ.URL("/views/" + id + "/edit") }>@web.EditIcon()</a>
				</div>
			</div>
		</div>
	</li>
}

// savedViewPage is the view itself: its header, mark-all control and the shared
// scoped item list (tabs, sorter, filters, pagination).
templ savedViewPage(u store.User, d savedViewPageData) {
	{{ id := strconv.FormatInt(d.Row.ID, 10) }}
	<section class="card">
		<div class="row">
			<h1>{ d.Row.Title }</h1>
			<div class="row-actions">
				@markAllReadControl(d.MarkAll)
				<a class="small" title="edit" href={ templ.URL("/views/" + id + "/edit") }>@web.EditIcon()</a>
			</div>
		</div>
		if d.Row.AuthorID > 0 && d.Row.AuthorName != "" {
			<p class="muted small">
				assigned to <a href={ templ.URL("/authors/" + strconv.FormatInt(d.Row.AuthorID, 10)) }>{ d.Row.AuthorName }</a>
			</p>
		}
	</section>
	<div class="author-items">
		@ScopedItems(d.Scoped)
	</div>
	<div class="stack delete-form">
		<button type="button" class="danger" data-post-action={ templ.URL("/views/" + id + "/delete") } data-confirm="delete this view?">delete view</button>
	</div>
}

// savedViewFormPage is the create/edit page. The title, assigned author,
// collections and filter rows are editable; the view always matches all feeds.
// viewAccordionItem is one saved-view panel in the author edit page's sources
// accordion. A selected panel renders its form inline; the rest lazy-load it.
templ viewAccordionItem(u store.User, r savedViewRow, editor *savedViewForm) {
	{{ id := strconv.FormatInt(r.ID, 10) }}
	{{ selected := editor != nil && editor.ID == r.ID }}
	<details class="feed-accordion-item" name="author-sources" id={ "view-acc-" + id } if selected { open }>
		<summary>
			@web.Lucide("bookmark-plus")
			<span class="feed-accordion-title">{ r.Title }</span>
			<span class="badge">{ r.Count } unread</span>
			if len(r.Collections) > 0 {
				for _, c := range r.Collections {
					<span class="badge">{ c.Name }</span>
				}
			}
		</summary>
		if selected {
			<div class="feed-accordion-body">@viewEditorPanel(u, *editor)</div>
		} else {
			<div class="feed-accordion-body" hx-get={ "/views/" + id + "/edit-fragment" } hx-trigger="toggle from:closest details once" hx-swap="innerHTML">
				<p class="muted small">loading…</p>
			</div>
		}
	</details>
}

// viewEditorPanel wraps one view's editor in its own auto-saving form. The form
// targets the whole accordion item so its summary title and badges update too.
templ viewEditorPanel(u store.User, f savedViewForm) {
	{{ id := strconv.FormatInt(f.ID, 10) }}
	<form class="stack" method="post" action={ "/views/" + id + "/edit" } hx-post={ "/views/" + id + "/edit" } hx-trigger="change delay:600ms, submit" hx-sync="closest form:replace" hx-target={ "#view-acc-" + id } hx-swap="outerHTML" hx-disinherit="*" data-autosave>
		@csrfField()
		@viewEditorBody(u, f)
	</form>
}

// savedViewFormPage is the standalone create/edit page. It keeps its explicit
// save button; only the author edit page auto-saves.
templ savedViewFormPage(u store.User, f savedViewForm) {
	{{ action := "/views" }}
	if f.ID > 0 {
		{{ action = "/views/" + strconv.FormatInt(f.ID, 10) + "/edit" }}
	}
	<div class="row">
		<h1>
			if f.ID > 0 {
				edit view
			} else {
				new view
			}
		</h1>
		<a class="button small" href="/views">back to views</a>
	</div>
	<form class="stack card" method="post" action={ templ.URL(action) }>
		@csrfField()
		@viewEditorBody(u, f)
		<div class="row-actions">
			<a class="link" href="/views">cancel</a>
			<button type="submit">save view</button>
		</div>
	</form>
}

// viewEditorBody is one view's editable settings without a <form>: title,
// assigned author, collection memberships and filter rows. It is shared by the
// standalone edit page and the auto-saving author edit panel.
templ viewEditorBody(u store.User, f savedViewForm) {
	{{ id := strconv.FormatInt(f.ID, 10) }}
	if f.Error != "" {
		<div class="error" role="alert">{ f.Error }</div>
	}
	<label>title
		<input name="title" value={ f.Title } maxlength="120" required autofocus?={ f.ID == 0 }/>
	</label>
	@comboSelect("author_id", savedViewAuthorValue(f.AuthorID), "assign to author", "search authors", f.AuthorOptions, nil)
	@comboMulti("collections", "collections", savedViewCollectionValues(f.CollectionIDs), f.CollectionOptions)
	<p class="muted small">The view matches every feed; use its filters to limit the posts. Assignment decides its author page, and collections add it as a source.</p>
	<div class="field-group" data-filter-scope>
		<h3>filters</h3>
		{{ kinds := []string{filterKindTag} }}
		if len(f.FeedOptions) > 0 {
			{{ kinds = append(kinds, filterKindFeed) }}
		}
		{{ kinds = append(kinds, filterKindTime) }}
		<div class="filter-rows" id="saved-view-filter-rows" data-filter-rows>
			for i, flt := range f.Filters {
				@filterRow("saved-view-filter-"+strconv.Itoa(i), strconv.Itoa(i), flt.Kind, flt.Action, flt.Combine, flt.Values, f.TagOptions, f.FeedOptions, kinds, false, "")
			}
			if len(f.Filters) == 0 {
				@filterRow("saved-view-filter-empty", "empty", filterKindTag, filterShow, filterAll, nil, f.TagOptions, f.FeedOptions, kinds, false, "")
			}
		</div>
		<template id="saved-view-filter-row-template" data-filter-row-template>
			@filterRow("saved-view-filter-__token__", "__token__", filterKindTag, filterShow, filterAll, nil, f.TagOptions, f.FeedOptions, kinds, false, "")
		</template>
		<button type="button" class="link" data-add-filter-row>@web.Lucide("plus") add filter</button>
	</div>
	if f.ID > 0 {
		<div class="stack delete-form">
			<button type="button" class="danger" data-post-action={ templ.URL("/views/" + id + "/delete?back=author") } data-confirm="delete this view?">delete view</button>
		</div>
	}
}
