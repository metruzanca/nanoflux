package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

// itemVisuals precomputes an item's rendering classification once per row so
// the expensive HTML parse in IsImagePost runs a single time.
type itemVisuals struct {
	Video   bool
	Image   bool
	Link    bool
	Gallery bool
}

func visualsOf(it store.ItemWithFeed) itemVisuals {
	return itemVisuals{
		Video:   web.YoutubeEmbedURL(it.Link) != "",
		Image:   web.IsImagePost(it.Summary, it.ImageURL, it.Title),
		Link:    web.IsLinkPost(it.ImageURL),
		Gallery: web.IsGallery(it.ImageURL),
	}
}

func itemCardClass(v itemVisuals) string {
	switch {
	case v.Video:
		return "video-card"
	case v.Image || v.Gallery:
		return "image-card"
	case v.Link:
		return "link-card"
	default:
		return "text-card"
	}
}

// loadMoreData carries the fragment URL for a "load more" button. It is nil
// when there is no next page.
type loadMoreData struct {
	URL string // full fragment URL including the before= cursor
}

templ ItemsList(items []store.ItemWithFeed, hideAuthor bool) {
	if len(items) > 0 {
		<ul class="items" id="items-list">
			for _, it := range items {
				@ItemRow(it, hideAuthor)
			}
		</ul>
	} else {
		<p class="muted" id="items-list">nothing here</p>
	}
}

// ItemsListPage renders the item list plus a "load more" button when more
// pages exist. The button appends the next page into the list via htmx.
templ ItemsListPage(items []store.ItemWithFeed, more *loadMoreData, hideAuthor bool) {
	@ItemsList(items, hideAuthor)
	if more != nil {
		<button id="load-more" hx-get={ templ.URL(more.URL) } hx-target="#items-list" hx-swap="beforeend">load more</button>
	}
}

// ItemsSection wraps the list and its load-more button so list-wide actions
// (e.g. "mark all read") can swap the whole section atomically instead of
// orphaning a stale load-more button.
templ ItemsSection(items []store.ItemWithFeed, more *loadMoreData, hideAuthor bool) {
	<div id="items-section">
		@ItemsListPage(items, more, hideAuthor)
	</div>
}

// ItemsPage is the fragment response for a load-more request: the appended
// item rows plus an out-of-band swap that replaces (or removes) the load-more
// button.
templ ItemsPage(items []store.ItemWithFeed, more *loadMoreData, hideAuthor bool) {
	for _, it := range items {
		@ItemRow(it, hideAuthor)
	}
	if more != nil {
		<button id="load-more" hx-swap-oob="outerHTML" hx-get={ templ.URL(more.URL) } hx-target="#items-list" hx-swap="beforeend">load more</button>
	} else {
		<button id="load-more" hx-swap-oob="delete" hidden></button>
	}
}

templ ItemRow(it store.ItemWithFeed, hideAuthor bool) {
	@itemRowInner(it, visualsOf(it), hideAuthor)
}

templ itemRowInner(it store.ItemWithFeed, v itemVisuals, hideAuthor bool) {
	<li id={ "item-" + strconv.FormatInt(it.ID, 10) } class={ itemCardClass(v) }>
		if v.Video {
			<a class="thumb" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">
				if it.ImageURL != "" {
					<img src={ templ.URL(it.ImageURL) } alt="" loading="lazy"/>
				} else {
					<span class="thumb-ph">▶</span>
				}
			</a>
		} else if v.Image || v.Link || v.Gallery {
			<a class="thumb thumb--img" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">
				if gthumb := web.GalleryThumb(it.ImageURL); gthumb != "" {
					<img src={ templ.URL(gthumb) } alt="" loading="lazy"/>
				} else {
					<img src={ templ.URL(it.ImageURL) } alt="" loading="lazy"/>
				}
				if v.Link {
					<span class="thumb-badge" title="content lives on an external site">external</span>
				}
			</a>
		} else if it.ImageURL != "" {
			// A text post that still carries a thumbnail (e.g. one that arrived
			// only as an image enclosure) gets a thumb beside its text.
			<a class="thumb thumb--img" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">
				<img src={ templ.URL(it.ImageURL) } alt="" loading="lazy"/>
			</a>
		}
		<div class="card-body">
			<div class="row">
				<div>
					if it.Read {
						<a class="item-title" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">{ it.Title }</a>
					} else {
						<a class="item-title unread" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">{ it.Title }</a>
					}
					<div class="item-meta">
						if it.AuthorName != "" && !hideAuthor {
							<a href={ "/authors/" + strconv.FormatInt(it.AuthorID, 10) }>{ it.AuthorName }</a> ·
						}
@web.SourceIcon(it.FeedURL)
					<a href={ "/feeds/" + strconv.FormatInt(it.FeedID, 10) }>{ it.FeedTitle }</a>
					for _, src := range it.Sources {
						· also in <a href={ "/feeds/" + strconv.FormatInt(src.FeedID, 10) }>{ src.FeedTitle }</a><a href={ templ.URL(src.Link) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external"></a>
					}
					if it.PublishedAt != "" {
							· { web.TimeFmt(it.Timezone, it.PublishedAt) }
						}
						if it.Read && it.ReadAt != "" {
							· <span class="read-at">read { web.TimeFmt(it.Timezone, it.ReadAt) }</span>
						}
					</div>
					if it.Summary != "" && !v.Image && !v.Link && !v.Gallery {
						<div class="item-summary">{ web.StripHTML(it.Summary) }</div>
					}
				</div>
				<div class="row-actions">
					if it.Favorite {
						<button class="link fav-btn" title="unfavorite" hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/favorite" } hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) } hx-swap="outerHTML"
							if hideAuthor {
								hx-vals={ `{"hideAuthor":"1"}` }
							}>
							@web.FavIcon(true)
						</button>
					} else {
						<button class="link fav-btn" title="favorite" hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/favorite" } hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) } hx-swap="outerHTML"
							if hideAuthor {
								hx-vals={ `{"hideAuthor":"1"}` }
							}>
							@web.FavIcon(false)
						</button>
					}
					if it.Read {
						<button class="link read-btn" title="mark unread" hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/read" } hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) } hx-swap="outerHTML"
							if hideAuthor {
								hx-vals={ `{"hideAuthor":"1"}` }
							}>↺</button>
					} else {
						<button class="link read-btn" title="mark read" hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/read" } hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) } hx-swap="outerHTML"
							if hideAuthor {
								hx-vals={ `{"hideAuthor":"1"}` }
							}>✓</button>
					}
					@itemMenu(it.ID)
				</div>
			</div>
		</div>
	</li>
}

templ ScopedItems(d scopedItemsData) {
	if d.SwapOOB {
		<div id="scoped-items" hx-swap-oob="outerHTML">
			@scopedItemsInner(d)
		</div>
	} else {
		<div id="scoped-items">
			@scopedItemsInner(d)
		</div>
	}
}

templ scopedItemsInner(d scopedItemsData) {
	<div class="tabs-row">
		<nav class="tabs">
			if d.View == "unread" {
				<a class="active" href={ d.Path + "?view=unread" } hx-get={ d.ItemsPath + "?view=unread" } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=unread" }>unread ({ d.UnreadCount })</a>
			} else {
				<a href={ d.Path + "?view=unread" } hx-get={ d.ItemsPath + "?view=unread" } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=unread" }>unread ({ d.UnreadCount })</a>
			}
			if d.View == "read" {
				<a class="active" href={ d.Path + "?view=read" } hx-get={ d.ItemsPath + "?view=read" } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=read" }>read ({ d.ReadCount })</a>
			} else {
				<a href={ d.Path + "?view=read" } hx-get={ d.ItemsPath + "?view=read" } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=read" }>read ({ d.ReadCount })</a>
			}
		</nav>
		@DisplayModeControl()
	</div>
	@ItemsListPage(d.Items, d.More, d.HideAuthor)
}

// DisplayModeControl is the list/grid picker shown alongside the unread/read
// tabs and in the home/history/favorites headers. The server renders the
// default (list) state; app.js re-syncs it from localStorage on load and after
// every htmx swap.
templ DisplayModeControl() {
	<div class="display-mode" data-mode="list">
		<button type="button" id="display-mode-btn" class="mode-btn" aria-haspopup="true" aria-expanded="false" title="display mode" onclick="toggleDisplayMode(event)">
			<span class="mode-ic mode-ic--list">@ModeIcon("list")</span>
			<span class="mode-ic mode-ic--grid">@ModeIcon("grid")</span>
			<span class="mode-label mode-label--list">list</span>
			<span class="mode-label mode-label--grid">grid</span>
		</button>
		<div id="display-mode-menu" class="mode-menu" role="menu" hidden>
			<button type="button" class="mode-option" role="menuitemradio" data-mode="list" aria-checked="true" onclick="setDisplayMode('list', event)">@ModeIcon("list") list</button>
			<button type="button" class="mode-option" role="menuitemradio" data-mode="grid" aria-checked="false" onclick="setDisplayMode('grid', event)">@ModeIcon("grid") grid</button>
		</div>
	</div>
}

// ModeIcon renders the small icon for a display mode ("list" or "grid").
templ ModeIcon(mode string) {
	if mode == "grid" {
		<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
	} else {
		<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
	}
}

templ ItemView(d itemViewData) {
	@itemViewInner(d, visualsOf(store.ItemWithFeed{
		Item: store.Item{
			Link:     d.Link,
			Summary:  d.Summary,
			ImageURL: d.ImageURL,
			Title:    d.Title,
		},
	}))
}

templ itemViewInner(d itemViewData, v itemVisuals) {
	<div class="item-view">
		<h1>{ d.Title }</h1>
		<p class="item-meta">
			if d.AuthorName != "" {
				<a href={ "/authors/" + strconv.FormatInt(d.AuthorID, 10) }>{ d.AuthorName }</a> ·
			}
			<a href={ "/feeds/" + strconv.FormatInt(d.FeedID, 10) }>{ d.FeedTitle }</a>
			if d.PublishedAt != "" {
				· { web.TimeFmt(d.Timezone, d.PublishedAt) }
			}
			if d.SourceURL != "" {
				· <a href={ templ.URL(d.SourceURL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">source</a>
			}
		</p>
		@shareControl(d.ID, d.ShareToken)
		@itemMenu(d.ID)
		@itemContent(d, v)
	</div>
}

// itemContent renders an item's media, body, and enclosures. Shared between the
// authenticated modal and the public share page.
templ itemContent(d itemViewData, v itemVisuals) {
	if len(d.Gallery) > 0 {
		<div class="gallery">
			for _, img := range d.Gallery {
				<img src={ templ.URL(img) } alt="" loading="lazy"/>
			}
		</div>
	} else if v.Image {
		<div class="image-lightbox">
			<img src={ templ.URL(web.BestImageURL(d.Summary, d.ImageURL)) } alt={ d.Title } loading="lazy"/>
		</div>
	} else if d.EmbedSrc != "" {
		<div class="video-embed">
			<iframe src={ templ.URL(d.EmbedSrc) } title={ d.Title } frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy" referrerpolicy="no-referrer"></iframe>
		</div>
	} else if d.EmbedURL != "" {
		<div class="video-embed">
			<iframe src={ templ.URL(d.EmbedURL) } title={ d.Title } frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>
		</div>
	}
	if d.Body != "" && !v.Image && d.SourceURL == "" && len(d.Gallery) == 0 {
		<div class="item-body">@templ.Raw(web.UpgradeImageSrcs(string(d.Body)))</div>
	}
	if len(d.Enclosures) > 0 {
		<div class="enclosures">
			if imgs := web.ImageEnclosures(d.Enclosures); len(imgs) > 0 && !v.Image && len(d.Gallery) == 0 && !web.BodyHasImage(d.Summary) {
				if len(imgs) == 1 {
					<div class="image-lightbox">
						<img src={ templ.URL(imgs[0].URL) } alt="" loading="lazy"/>
					</div>
				} else {
					<div class="gallery">
						for _, e := range imgs {
							<img src={ templ.URL(e.URL) } alt="" loading="lazy"/>
						}
					</div>
				}
			}
			for _, e := range d.Enclosures {
				if kind := web.EnclosureKind(e); kind == "video" {
					<figure>
						<video controls preload="none" src={ templ.URL(e.URL) }></video>
					</figure>
				} else if kind == "audio" {
					<figure>
						<audio controls preload="none" src={ templ.URL(e.URL) }></audio>
					</figure>
				}
			}
			<ul class="plain small">
				for _, e := range d.Enclosures {
					if kind := web.EnclosureKind(e); kind != "image" {
						<li>· <a href={ templ.URL(e.URL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">{ web.EnclosureLabel(e) }</a></li>
					}
				}
			</ul>
		</div>
	}
}

// shareControl toggles the public share link for an item. Rendered inside the
// item modal; re-swapped in place by the share/revoke endpoints.
templ shareControl(itemID int64, token string) {
	<div id="item-share" class="item-meta">
		if token != "" {
			<span>shared · <a href={ "/shared/" + token } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">link</a></span>
			<button class="link danger" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/revoke" } hx-target="#item-share" hx-swap="outerHTML">stop sharing</button>
		} else {
			<button class="link" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/share" } hx-target="#item-share" hx-swap="outerHTML">share</button>
		}
	</div>
}

// itemMenu is the "⋯" action menu on an item card (list/grid) and in the item
// modal. It opens a dropdown of extra options: "add to list" (fetches the
// shared lists picker into the layout's dialog) and bulk "mark all before/after
// as read" for the item's feed. The dropdown is scoped per item via
// data-item-id so many cards can each have one.
templ itemMenu(itemID int64) {
	<div class="item-menu" data-item-id={ strconv.FormatInt(itemID, 10) }>
		<button type="button" class="link menu-btn" aria-haspopup="true" aria-expanded="false" title="more actions" onclick="toggleItemMenu(event)">⋯</button>
		<div class="menu-pop" role="menu" hidden>
			<button type="button" class="link menu-item" role="menuitem" onclick="itemMenuAction(event, 'lists')">add to list</button>
			<button type="button" class="link menu-item" role="menuitem" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/read-before" } hx-swap="none" hx-on::after-request="if(event.detail.successful) window.location.reload()">mark all before as read</button>
			<button type="button" class="link menu-item" role="menuitem" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/read-after" } hx-swap="none" hx-on::after-request="if(event.detail.successful) window.location.reload()">mark all after as read</button>
		</div>
	</div>
}

// itemListsDialogInner is the add-to-list picker content, injected into the
// shared #item-lists-dialog (declared in views_layout.templ) by the "add to
// list" menu action. Favorites is the special list (its checkbox mirrors
// items.favorite); the others are the user's lists. The form is the fragment
// target of the apply endpoint, so it re-renders with fresh membership state
// and closes on success.
templ itemListsDialogInner(itemID int64, favorite bool, lists []store.List, itemListIDs []int64) {
	<div class="row">
		<h2>add to list</h2>
		<button type="button" class="link" onclick="this.closest('dialog').close()">✕</button>
	</div>
	<form class="stack" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/lists" } hx-target="#item-lists-dialog" hx-swap="innerHTML" hx-on::after-request="if(event.detail.successful){document.getElementById('item-lists-dialog').close()}">
		<label>
			<input type="checkbox" name="lists" value="favorites"
			if favorite {
				checked
			}/> favorites
		</label>
		for _, l := range lists {
			<label>
				<input type="checkbox" name="lists" value={ strconv.FormatInt(l.ID, 10) }
				if containsListID(itemListIDs, l.ID) {
					checked
				}/> { l.Name }
			</label>
		}
		<div id="item-lists-error" class="error"></div>
		<button type="submit">save</button>
	</form>
}

// sharedItemPage is the public, unauthenticated view of a shared item. It
// reuses itemContent but never links to internal author/feed pages.
templ sharedItemPage(it store.ItemWithFeed, d itemViewData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@head(it.Title)
		</head>
		<body>
			<main>
				<div class="item-view">
					<h1>{ d.Title }</h1>
					<p class="item-meta">
						{ it.FeedTitle }
						if d.PublishedAt != "" {
							· { web.TimeFmt("", d.PublishedAt) }
						}
						· <a href={ templ.URL(d.Link) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">open live</a>
					</p>
					@itemContent(d, visualsOf(store.ItemWithFeed{
						Item: store.Item{
							Link:     d.Link,
							Summary:  d.Summary,
							ImageURL: d.ImageURL,
							Title:    d.Title,
						},
					}))
				</div>
			</main>
		</body>
	</html>
}