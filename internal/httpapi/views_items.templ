package httpapi

import (
	"strconv"
	"strings"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

// itemVisuals is an item's rendering classification for a row. The plugin's
// Kind (from the item's decoration) decides when set; otherwise a generic
// baseline detects a single-image post and video links render as video.
type itemVisuals struct {
	Video   bool
	Image   bool
	Link    bool
	Gallery bool
}

func visualsOf(it store.ItemWithFeed) itemVisuals {
	return itemVisuals{
		Video:   it.Kind == store.KindVideo,
		Image:   it.Kind == store.KindImage || (it.Kind == store.KindText && web.IsSingleImagePost(it.Summary, it.ImageURL, it.Title)),
		Link:    it.Kind == store.KindLink,
		Gallery: it.Kind == store.KindGallery,
	}
}

// visualsFromKind classifies the item modal, which carries Kind plus the item's
// fields (so the generic single-image baseline still applies when no plugin
// classified it).
func visualsFromKind(d itemViewData) itemVisuals {
	return itemVisuals{
		Video:   d.Kind == store.KindVideo,
		Image:   d.Kind == store.KindImage || (d.Kind == store.KindText && web.IsSingleImagePost(d.Summary, d.ImageURL, d.Title)),
		Link:    d.Kind == store.KindLink,
		Gallery: d.Kind == store.KindGallery,
	}
}

// rowThumb returns the image a row should show: the decoration's override when
// set (a gallery's full-res first image), else the cached copy when the item's
// image is cached, else the stored ImageURL. Templates pass the result through
// web.ProxiedImageURL, which leaves the local /cache path unchanged.
func rowThumb(it store.ItemWithFeed) string {
	if it.ThumbURL != "" {
		return it.ThumbURL
	}
	if it.ImageCacheKey != "" {
		return web.CachedImageURL(it.ImageCacheKey, it.ImageURL)
	}
	return it.ImageURL
}

func itemCardClass(v itemVisuals) string {
	switch {
	case v.Video:
		return "video-card"
	case v.Image || v.Gallery:
		return "image-card"
	case v.Link:
		return "link-card"
	default:
		return "text-card"
	}
}

// itemRowClass is the <li> class for a row: its media card class plus "read"
// when the item is read, which the CSS darkens (and app.js toggles in place on
// the mark-read fast path).
func itemRowClass(it store.ItemWithFeed, v itemVisuals) string {
	cls := itemCardClass(v)
	if it.Read {
		cls += " read"
	}
	return cls
}

// loadMoreData carries the fragment URL for a "load more" button. It is nil
// when there is no next page.
type loadMoreData struct {
	URL string // full fragment URL including the before= cursor
}

// itemsListClass is the <ul> class for an item list: "items", plus "masonry"
// for the grid layout or "cards" for the larger two-column card layout. The
// mode is server-side (per account), so the list is laid out correctly on
// first paint.
func itemsListClass(mode string) string {
	switch store.NormalizeViewMode(mode) {
	case store.ViewModeGrid:
		return "items masonry"
	case store.ViewModeCards:
		return "items cards"
	default:
		return "items"
	}
}

templ ItemsList(items []store.ItemWithFeed, hideAuthor bool, mode string) {
	if len(items) > 0 {
		<ul class={ itemsListClass(mode) } id="items-list">
			for _, it := range items {
				@ItemRow(it, hideAuthor)
			}
		</ul>
	} else {
		<p class="muted" id="items-list">nothing here</p>
	}
}

// ItemsListPage renders the item list plus a "load more" button when more
// pages exist. The button appends the next page into the list via htmx.
templ ItemsListPage(items []store.ItemWithFeed, more *loadMoreData, hideAuthor bool, mode string) {
	@ItemsList(items, hideAuthor, mode)
	if more != nil {
		<button id="load-more" hx-get={ templ.URL(more.URL) } hx-target="#items-list" hx-swap="beforeend">load more</button>
	}
}

// ItemsSection wraps the list and its load-more button so list-wide actions
// (e.g. "mark all read") can swap the whole section atomically instead of
// orphaning a stale load-more button.
templ ItemsSection(items []store.ItemWithFeed, more *loadMoreData, hideAuthor bool, mode string) {
	<div id="items-section">
		@ItemsListPage(items, more, hideAuthor, mode)
	</div>
}

// ItemsPage is the fragment response for a load-more request: the appended
// item rows plus an out-of-band swap that replaces (or removes) the load-more
// button.
templ ItemsPage(items []store.ItemWithFeed, more *loadMoreData, hideAuthor bool) {
	for _, it := range items {
		@ItemRow(it, hideAuthor)
	}
	if more != nil {
		<button id="load-more" hx-swap-oob="outerHTML" hx-get={ templ.URL(more.URL) } hx-target="#items-list" hx-swap="beforeend">load more</button>
	} else {
		<button id="load-more" hx-swap-oob="delete" hidden></button>
	}
}

templ ItemRow(it store.ItemWithFeed, hideAuthor bool) {
	@itemRowInner(it, visualsOf(it), hideAuthor, false)
}

// sourcesList renders an item's alternate feeds as "· also in <feed>" links.
// A source with a known author links to that author's page (the feed page is
// gone); otherwise the name is plain text. A source that carries a Link (the
// legacy title-based view-time collapse) also gets an external-link marker.
templ sourcesList(sources []store.ItemSource) {
	for _, src := range sources {
		·
		if u := authorFeedURL(src.AuthorID, src.FeedID); u != "" {
			also in <a href={ templ.URL(u) }>{ src.FeedTitle }</a>
		} else {
			also in <span>{ src.FeedTitle }</span>
		}
		if src.Link != "" {
			<a href={ templ.URL(src.Link) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external"></a>
		}
	}
}

// attrParts renders an attribution as space-separated parts, linking the ones
// that have a URL and marking external links. The parts come from the item's
// plugin decoration (store.AttributionPart), already resolved by the store.
templ attrParts(parts []store.AttributionPart) {
	for i, p := range parts {
		if i > 0 {
			{ " " }
		}
		if p.URL == "" {
			<span>{ p.Text }</span>
		} else if p.External {
			<a href={ templ.URL(p.URL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">{ p.Text }</a>
		} else {
			<a href={ templ.URL(p.URL) }>{ p.Text }</a>
		}
	}
}

// ItemRowOOB renders a row as an out-of-band swap, so a modal toggle can update
// the row behind the dialog in the same response.
templ ItemRowOOB(it store.ItemWithFeed, hideAuthor bool) {
	@itemRowInner(it, visualsOf(it), hideAuthor, true)
}

templ itemRowInner(it store.ItemWithFeed, v itemVisuals, hideAuthor, oob bool) {
	<li
		id={ "item-" + strconv.FormatInt(it.ID, 10) }
		class={ itemRowClass(it, v) }
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		if v.Video {
			<a class="thumb" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } data-open-item>
				if thumb := rowThumb(it); thumb != "" {
					<img src={ templ.URL(web.ProxiedImageURL(thumb)) } alt="" loading="lazy"/>
				} else {
					<span class="thumb-ph">▶</span>
				}
				if dur := web.FormatDuration(it.DurationSec); dur != "" {
					<span class="thumb-duration">{ dur }</span>
				}
			</a>
		} else if v.Image || v.Link || v.Gallery {
			<a class="thumb thumb--img" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } data-open-item>
				<img src={ templ.URL(web.ProxiedImageURL(rowThumb(it))) } alt="" loading="lazy"/>
				if v.Link {
					<span class="thumb-badge" title="content lives on an external site">external</span>
				}
			</a>
		} else if it.ImageURL != "" {
			// A text post that still carries a thumbnail (e.g. one that arrived
			// only as an image enclosure) gets a thumb beside its text.
			<a class="thumb thumb--img" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } data-open-item>
				<img src={ templ.URL(web.ProxiedImageURL(rowThumb(it))) } alt="" loading="lazy"/>
			</a>
		}
		<div class="card-body">
			<div class="row">
				<div>
					if it.Read {
						<a class="item-title" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } data-open-item>{ it.Title }</a>
					} else {
						<a class="item-title unread" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } data-open-item>{ it.Title }</a>
					}
					<div class="item-meta">
						@web.SourceIcon(itemIconURL(it))
						if it.FeedIsSystem {
							// Saved page: its feed/author are hidden, so the
							// source is plain text, not a navigation link.
							<span>saved</span><a href={ templ.URL(it.Link) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external"></a>
						} else if len(it.Attribution) > 0 {
							@attrParts(it.Attribution)
							@sourcesList(it.Sources)
						} else if it.AuthorName != "" && !hideAuthor {
							<a href={ "/authors/" + strconv.FormatInt(it.AuthorID, 10) }>{ it.AuthorName }</a>
							@sourcesList(it.Sources)
						} else if u := authorFeedURL(it.AuthorID, it.FeedID); u != "" {
							<a href={ templ.URL(u) }>{ it.FeedTitle }</a>
							@sourcesList(it.Sources)
						} else {
							<span>{ it.FeedTitle }</span>
							@sourcesList(it.Sources)
						}
						if it.PublishedAt != "" {
							· { web.TimeFmt(it.Timezone, it.PublishedAt) }
						}
						if it.Read && it.ReadAt != "" {
							· <span class="read-at">read { web.TimeFmt(it.Timezone, it.ReadAt) }</span>
						}
					</div>
					if it.Summary != "" && !v.Image && !v.Link && !v.Gallery {
						<div class="item-summary">{ web.StripHTML(it.Summary) }</div>
					}
				</div>
				<div class="row-actions">
					@itemToggleButtons(it.ID, it.Favorite, it.Bookmark, it.Read, false, hideAuthor)
					@itemMenuFullSys(it.ID, menuAuthorID(it, hideAuthor), "", "", false, it.FeedIsSystem)
				</div>
			</div>
		</div>
	</li>
}

// itemToggleButtons renders the favorite, bookmark and read/unread toggles for
// one item, shared by the item row and the modal header. inView selects the
// surface: true means the modal (swap target is the controls container and the
// handler answers with just the fresh toggles); false means the row (swap target
// is the row itself and the handler answers with the fresh row). hideAuthor
// carries the author-scoped flag a swapped row needs to stay consistent.
templ itemToggleButtons(itemID int64, favorite, bookmark, read, inView, hideAuthor bool) {
	@favToggle(itemID, favorite, toggleTarget(itemID, inView), toggleVals(inView, hideAuthor))
	@bookmarkToggle(itemID, bookmark, toggleTarget(itemID, inView), toggleVals(inView, hideAuthor))
	@readToggle(itemID, read, toggleTarget(itemID, inView), toggleVals(inView, false))
}

// toggleTarget is the htmx swap target for a toggle: the modal's controls
// container when inView, else the item's own row.
func toggleTarget(itemID int64, inView bool) string {
	if inView {
		return "#item-view-controls"
	}
	return "#item-" + strconv.FormatInt(itemID, 10)
}

// toggleVals builds the hx-vals JSON for a toggle: view=1 asks the handler for
// the modal toggles; hideAuthor preserves the author-scoped row.
func toggleVals(inView, hideAuthor bool) string {
	if inView {
		return `{"view":"1"}`
	}
	if hideAuthor {
		return `{"hideAuthor":"1"}`
	}
	return "{}"
}

// itemViewControls is the modal header's toggle container, swapped in place when
// a toggle is used from the modal.
templ itemViewControls(itemID int64, favorite, bookmark, read bool) {
	<div class="item-controls" id="item-view-controls">
		@itemToggleButtons(itemID, favorite, bookmark, read, true, false)
	</div>
}

// favToggle is the favorite star button.
templ favToggle(itemID int64, favorite bool, target, vals string) {
	<button
		class="link fav-btn"
		title={ favTitle(favorite) }
		hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/favorite" }
		hx-target={ target }
		hx-swap="outerHTML"
		hx-vals={ vals }
	>
		@web.FavIcon(favorite)
	</button>
}

// bookmarkToggle is the bookmark button (save-for-later), beside the star.
templ bookmarkToggle(itemID int64, bookmark bool, target, vals string) {
	<button
		class="link bookmark-btn"
		title={ bookmarkTitle(bookmark) }
		hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/bookmark" }
		hx-target={ target }
		hx-swap="outerHTML"
		hx-vals={ vals }
	>
		@web.BookmarkIcon(bookmark)
	</button>
}

// readToggle is the mark read/unread button.
templ readToggle(itemID int64, read bool, target, vals string) {
	<button
		class="link read-btn"
		title={ readTitle(read) }
		hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/read" }
		hx-target={ target }
		hx-swap="outerHTML"
		hx-vals={ vals }
	>
		if read {
			@web.Lucide("rotate-ccw")
		} else {
			@web.Lucide("check")
		}
	</button>
}

func favTitle(favorite bool) string {
	if favorite {
		return "unfavorite"
	}
	return "favorite"
}

func bookmarkTitle(bookmark bool) string {
	if bookmark {
		return "remove bookmark"
	}
	return "bookmark"
}

func readTitle(read bool) string {
	if read {
		return "mark unread"
	}
	return "mark read"
}

// scopedTabURL builds a tab link carrying the active sort and filters.
func scopedTabURL(path, view string, sort itemSort, filters listFilters, viewID int64) string {
	return filters.appendFilters(scopedViewQueryFor(path, view, viewID) + "&sort=" + sort.param())
}

// menuAuthorID is the author id the item menu's "go to author" entry uses: the
// item's author, or 0 on that author's own page (hideAuthor), where the entry
// would just link the page to itself.
func menuAuthorID(it store.ItemWithFeed, hideAuthor bool) int64 {
	if hideAuthor {
		return 0
	}
	return it.AuthorID
}

templ ScopedItems(d scopedItemsData) {
	if d.SwapOOB {
		<div id="scoped-items" hx-swap-oob="outerHTML">
			@scopedItemsInner(d)
		</div>
	} else {
		<div id="scoped-items">
			@scopedItemsInner(d)
		</div>
	}
}

templ scopedTab(path, itemsPath, view, label, count string, active bool, sort itemSort, filters listFilters, viewID int64) {
	if view == "feeds" {
		if active {
			<a class="active" href={ path + "?view=feeds" } hx-get={ itemsPath + "?view=feeds" } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ path + "?view=feeds" }>{ label } ({ count })</a>
		} else {
			<a href={ path + "?view=feeds" } hx-get={ itemsPath + "?view=feeds" } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ path + "?view=feeds" }>{ label } ({ count })</a>
		}
	} else {
		{{ u := scopedTabURL(path, view, sort, filters, viewID) }}
		{{ hu := scopedTabURL(itemsPath, view, sort, filters, viewID) }}
		if active {
			<a class="active" href={ u } hx-get={ hu } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ u }>{ label } ({ count })</a>
		} else {
			<a href={ u } hx-get={ hu } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ u }>{ label } ({ count })</a>
		}
	}
}

// filterRow is one editable row in the filter modal: action, kind, any/all,
// values, then remove/add controls. kinds is the set of kinds the caller
// offers (tag/feed/time); the kind select is hidden when only one is possible
// and its value still submits through a hidden input.
//
// Each possible kind's value editor is rendered as a <template>. app.js swaps
// the value cell when the kind changes, so no client-side option hydration is
// needed.
templ filterRow(id, token, kind, action, combine string, values []string, tagItems, feedItems []comboItem, kinds []string, allowBlock bool, namePrefix string) {
	<div class="filter-row" data-filter-row>
		<input type="hidden" name={ namePrefix + "filter_row" } value={ token } data-filter-row-token/>
		<select name={ namePrefix + "filter_action" } class="filter-select filter-action" aria-label="filter action">
			if allowBlock {
				<option value={ filterShow } selected?={ action == filterShow }>allow</option>
				<option value={ filterHide } selected?={ action == filterHide }>block</option>
			} else {
				<option value={ filterShow } selected?={ action == filterShow }>show</option>
				<option value={ filterHide } selected?={ action == filterHide }>hide</option>
			}
		</select>
		if len(kinds) > 1 {
			<select name={ namePrefix + "filter_kind" } class="filter-select filter-kind" aria-label="filter kind" data-filter-kind>
				for _, k := range kinds {
					<option value={ k } selected?={ kind == k }>{ k }</option>
				}
			</select>
		} else {
			<input type="hidden" name={ namePrefix + "filter_kind" } value={ kind }/>
		}
		<span data-filter-combine hidden?={ kind == filterKindTime }>
			<select name={ namePrefix + "filter_combine" } class="filter-select filter-combine" aria-label="how values combine">
				<option value={ filterAny } selected?={ combine == filterAny }>any</option>
				<option value={ filterAll } selected?={ combine == filterAll }>all</option>
			</select>
		</span>
		<div class="filter-value" data-filter-value data-filter-value-kind={ kind }>
			if kind == filterKindTime {
				@filterTimeRow(id+"-value", token, values, namePrefix)
			} else if kind == filterKindFeed {
				@comboMultiID(id+"-value", namePrefix+"filter_value_"+token, "", values, feedItems)
			} else {
				@comboMultiID(id+"-value", namePrefix+"filter_value_"+token, "", values, tagItems)
			}
		</div>
		for _, k := range kinds {
			if k == filterKindTime {
				<template data-filter-value-template="time">
					@filterTimeRow(id+"-value-time", token, nil, namePrefix)
				</template>
			} else if k == filterKindFeed {
				<template data-filter-value-template="feed">
					@comboMultiID(id+"-value-feed", namePrefix+"filter_value_"+token, "", nil, feedItems)
				</template>
			} else {
				<template data-filter-value-template="tag">
					@comboMultiID(id+"-value-tag", namePrefix+"filter_value_"+token, "", nil, tagItems)
				</template>
			}
		}
		<button type="button" class="link danger" title="remove filter" data-remove-closest=".filter-row">@web.Lucide("x")</button>
		<button type="button" class="link" title="add another filter" data-add-filter-row>@web.Lucide("plus")</button>
	</div>
}

// filterTimeRow is the value editor for a time row: a mode select, the primary
// date and optional time, and (for "between") the end date and optional time.
// A date-only bound means the whole day in the user's timezone.
templ filterTimeRow(id, token string, values []string, namePrefix string) {
	{{ mode := timeModeOf(values) }}
	{{ startDate, startClock := splitTimeInput(timePrimary(values)) }}
	{{ endDate, endClock := splitTimeInput(timeSecondary(values)) }}
	<div class="filter-time" data-filter-time>
		<select name={ namePrefix + "filter_time_mode_" + token } class="filter-select filter-time-mode" aria-label="time window" data-filter-time-mode>
			<option value={ filterTimeBetween } selected?={ mode == filterTimeBetween }>between</option>
			<option value={ filterTimeBefore } selected?={ mode == filterTimeBefore }>before</option>
			<option value={ filterTimeAfter } selected?={ mode == filterTimeAfter }>after</option>
		</select>
		<label class="filter-time-field">date
			<input type="date" name={ namePrefix + "filter_time_start_" + token } value={ startDate }/>
		</label>
		<label class="filter-time-field">time
			<input type="time" name={ namePrefix + "filter_time_start_clock_" + token } value={ startClock }/>
		</label>
		<span class="filter-time-end" data-filter-time-end hidden?={ mode != filterTimeBetween }>
			<label class="filter-time-field">to date
				<input type="date" name={ namePrefix + "filter_time_end_" + token } value={ endDate }/>
			</label>
			<label class="filter-time-field">to time
				<input type="time" name={ namePrefix + "filter_time_end_clock_" + token } value={ endClock }/>
			</label>
		</span>
	</div>
}

// filterButton opens the filter modal when the list has anything to filter by.
templ filterButton(fp filterPanelData) {
	if fp.available() {
		<button type="button" class="mode-btn" title="filter by tag, feed or time" data-open="tag-filter-dialog">@web.Lucide("funnel-plus")</button>
	}
}

// filterChips renders the active filters as removable chips plus the match
// count and a clear-all link.
templ filterChips(fp filterPanelData) {
	if len(fp.Filters) > 0 {
		<div class="chips active-tags">
			for i, f := range fp.Filters {
				{{ cls := "chip" }}
				if f.hidden() {
					{{ cls = "chip chip-hide" }}
				}
				<a class={ cls } href={ templ.URL(filterPageURLFor(fp.Path, fp.View, fp.Sort, fp.Filters.without(i), fp.ViewID)) } title={ "remove " + f.Action + " filter " + f.label() }>{ f.label() } <span aria-hidden="true">×</span></a>
			}
			<span class="chip chip-count" title="posts matching the active filters">{ strconv.Itoa(fp.FilteredCount) } matching</span>
			<a class="chip chip-clear" href={ templ.URL(filterPageURLFor(fp.Path, fp.View, fp.Sort, nil, fp.ViewID)) }>clear all</a>
		</div>
	}
}

// filterDialog is the shared filter modal. One form submits a row token per
// filter plus that row's values; blank rows are dropped server-side.
templ filterDialog(fp filterPanelData) {
	if fp.available() {
		{{ defaultKind := fp.defaultKind() }}
		{{ kinds := fp.kinds() }}
		{{ feedItems := fp.effectiveFeedOptions() }}
		<dialog id="tag-filter-dialog" class="modal" data-filter-scope>
			<div class="row">
				<h2>filter</h2>
				<button type="button" class="link" title="close" data-close-dialog>@web.Lucide("x")</button>
			</div>
			<form method="get" action={ templ.URL(fp.Path) } class="stack">
				if fp.ViewID > 0 {
					<input type="hidden" name="view" value={ strconv.FormatInt(fp.ViewID, 10) }/>
					<input type="hidden" name="tab" value={ fp.View }/>
				} else {
					<input type="hidden" name="view" value={ fp.View }/>
				}
				<input type="hidden" name="sort" value={ fp.Sort.param() }/>
				if fp.ScopeAuthorID > 0 {
					<input type="hidden" name="author_id" value={ strconv.FormatInt(fp.ScopeAuthorID, 10) }/>
				}
				<p class="muted small">show matching posts, or hide them. tag and feed rows combine their values with any (or) or all (and); time rows match a window on the post time, in your timezone. show rows must all match, and any hide row excludes.</p>
				<div class="filter-rows" id="filter-rows" data-filter-rows>
					for i, f := range fp.Filters {
						@filterRow("filter-"+strconv.Itoa(i), strconv.Itoa(i), f.Kind, f.Action, f.Combine, f.Values, fp.TagOptions, feedItems, kinds, false, "")
					}
					if len(fp.Filters) == 0 {
						@filterRow("filter-empty", "empty", defaultKind, filterShow, filterAll, nil, fp.TagOptions, feedItems, kinds, false, "")
					}
				</div>
				<template id="filter-row-template" data-filter-row-template>
					@filterRow("filter-__token__", "__token__", defaultKind, filterShow, filterAll, nil, fp.TagOptions, feedItems, kinds, false, "")
				</template>
				<button type="button" class="link" data-add-filter-row>@web.Lucide("plus") add filter</button>
				<div class="row-actions">
					<button type="submit" class="link" title="save this list as a view" formaction="/views/new" formmethod="get">@web.Lucide("bookmark-plus") save as view</button>
					<button type="button" class="link" data-close-dialog>cancel</button>
					<button type="submit">apply</button>
				</div>
			</form>
		</dialog>
	}
}

templ scopedItemsInner(d scopedItemsData) {
	{{ fp := d.filterPanel() }}
	<div class="tabs-row">
		<nav class="tabs">
			@scopedTab(d.Path, d.ItemsPath, "unread", "unread", strconv.Itoa(d.UnreadCount), d.View == "unread", d.Sort, d.Filters, d.ViewID)
			@scopedTab(d.Path, d.ItemsPath, "read", "read", strconv.Itoa(d.ReadCount), d.View == "read", d.Sort, d.Filters, d.ViewID)
			if d.FeedsTab {
				@scopedTab(d.Path, d.ItemsPath, "feeds", "sources", strconv.Itoa(d.FeedCount+d.ViewCount), d.View == "feeds", d.Sort, d.Filters, d.ViewID)
			}
			if d.FavTab {
				@scopedTab(d.Path, d.ItemsPath, "favorites", "favorites", strconv.Itoa(d.FavCount), d.View == "favorites", d.Sort, d.Filters, d.ViewID)
			}
		</nav>
		if d.View != "feeds" {
			<div class="row-actions">
				@filterButton(fp)
				@sortPicker(d.Path, d.View, d.Sort, d.NoMagic, d.Filters, d.ViewID)
				@DisplayModeControl(d.Path, d.Mode)
			</div>
		} else {
			<div class="row-actions">
				@FeedSortControl()
			</div>
		}
	</div>
	if d.View == "feeds" {
		@CollectionSourceCards(mergeCollectionSources(d.Feeds, d.Views))
	} else {
		@filterChips(fp)
		@ItemsListPage(d.Items, d.More, d.HideAuthor, d.Mode)
		@filterDialog(fp)
	}
}

// pickerOption is one choice in a PickerControl. Client-side pickers (no Href)
// are handled by app.js via data attributes + localStorage; server-side pickers
// set Href/HxGet so the option reloads the list.
type pickerOption struct {
	Value    string
	Label    string
	Icon     string // ModeIcon name; "" renders a label only
	Href     string
	HxGet    string
	HxPost   string // POST endpoint for a server-side mutation picker (e.g. home mode)
	HxVals   string // JSON extra values sent with HxPost
	HxTarget string
	HxConfirm string // confirmation prompt for a mutating option
}

// PickerControl is the shared pill + dropdown used for the display mode, the
// authors sort, and the item sort direction. The button shows the current
// option's icon/label; the server renders the default and app.js re-syncs it
// from state after swaps. scope namespaces a client-side picker's remembered
// value (the display mode is remembered per page); it is "" for pickers whose
// state is not scoped.
templ PickerControl(name, title, current, scope string, options []pickerOption) {
	<div class="picker" data-picker={ name } data-scope={ scope } data-mode={ current }>
		<button type="button" class="mode-btn" aria-haspopup="true" aria-expanded="false" title={ title } data-toggle-picker>
			for _, o := range options {
				if o.Icon != "" {
					<span
						class="pick-ic"
						data-option={ o.Value }
						if o.Value != current {
							hidden
						}
					>@ModeIcon(o.Icon)
</span>
				}
				<span
					class="pick-label"
					data-option={ o.Value }
					if o.Value != current {
						hidden
					}
				>{ o.Label }</span>
			}
		</button>
		<div class="mode-menu" role="menu" hidden>
			for _, o := range options {
				if o.Href != "" {
					<a
						class="mode-option"
						role="menuitemradio"
						data-option={ o.Value }
						aria-checked={ strconv.FormatBool(o.Value == current) }
						href={ templ.URL(o.Href) }
						if o.HxGet != "" {
							hx-get={ templ.URL(o.HxGet) }
							hx-target={ o.HxTarget }
							hx-swap="outerHTML"
							hx-push-url={ templ.URL(o.Href) }
						}
					>
						if o.Icon != "" {
							@ModeIcon(o.Icon)
						}
						<span>{ o.Label }</span>
					</a>
				} else if o.HxPost != "" {
					<button
						type="button"
						class="mode-option"
						role="menuitemradio"
						data-option={ o.Value }
						aria-checked={ strconv.FormatBool(o.Value == current) }
						hx-post={ o.HxPost }
						hx-vals={ o.HxVals }
						hx-target={ o.HxTarget }
						hx-swap="outerHTML"
						if o.HxConfirm != "" {
							hx-confirm={ o.HxConfirm }
						}
					>
						if o.Icon != "" {
							@ModeIcon(o.Icon)
						}
						<span>{ o.Label }</span>
					</button>
				} else {
					<button type="button" class="mode-option" role="menuitemradio" data-option={ o.Value } aria-checked={ strconv.FormatBool(o.Value == current) }>
						if o.Icon != "" {
							@ModeIcon(o.Icon)
						}
						<span>{ o.Label }</span>
					</button>
				}
			}
		</div>
	</div>
}

// DisplayModeControl is the list/grid picker shown alongside the unread/read
// tabs and in the home/history/favorites headers. mode is the user's saved
// preference for this scope (server-side, per account); scope is the page key
// the choice is stored under. Clicking an option asks app.js to persist the
// change to /prefs/display and re-apply it.
templ DisplayModeControl(scope, mode string) {
	@PickerControl("display", "display mode", store.NormalizeViewMode(mode), scope, []pickerOption{
		{Value: "list", Label: "list", Icon: "list"},
		{Value: "grid", Label: "grid", Icon: "grid"},
		{Value: "cards", Label: "cards", Icon: "cards"},
	})
}

// AuthorSortControl sorts the authors list alphabetically ("abc"), by newest
// first, by most unread items, or by magic (the taste of the author's feeds:
// raised feeds first, then most favorited). Client-side: app.js reorders the
// rendered rows. The default is "unread".
templ AuthorSortControl() {
	@PickerControl("authors", "sort", "unread", "", []pickerOption{
		{Value: "abc", Label: "abc"},
		{Value: "newest", Label: "newest"},
		{Value: "unread", Label: "unread"},
		{Value: "magic", Label: "magic", Icon: "magic"},
	})
}

// FeedSortControl sorts feed cards alphabetically ("abc"), by newest first, by
// fewest unread items, or by most unread items. Client-side: app.js reorders
// every rendered feed list, mirroring AuthorSortControl. The default is "abc"
// to match the server's title order. "unread" is kept as the legacy
// most-unread value so an existing saved preference keeps working.
templ FeedSortControl() {
	@PickerControl("feeds", "sort", "abc", "", []pickerOption{
		{Value: "abc", Label: "abc"},
		{Value: "newest", Label: "newest"},
		{Value: "unread_asc", Label: "unread ↑"},
		{Value: "unread", Label: "unread ↓"},
	})
}

// SortControl is the item sort picker: newest/oldest by time, or magic (feed
// taste). Server-side: each option is a link that reloads the page with
// ?sort=. basePath and view build the target URL; the list fragment is reloaded
// in place by app.js on navigation.
templ SortControl(basePath, view string, current itemSort) {
	@sortPicker(basePath, view, current, false, nil, 0)
}

// sortPicker renders the sort options, omitting magic when noMagic is set (a
// list orders by membership time, so feed taste does not apply). filters are
// carried into each option so changing the sort keeps the active filters. A
// view-scoped author page passes viewID so the links keep ?view=<id>&tab=.
templ sortPicker(basePath, view string, current itemSort, noMagic bool, filters listFilters, viewID int64) {
	{{ sep := scopedViewSep(view, viewID) }}
	@PickerControl("sort", "sort", current.param(), "", sortOptions(basePath, sep, current, noMagic, filters))
}

// SimpleSortControl is SortControl for a page whose list is not scoped (a plain
// query-string base such as "/unread" or "/favorites"). filters are preserved in
// each option's link.
templ SimpleSortControl(basePath string, current itemSort, filters listFilters) {
	{{ sep := "?" }}
	if strings.Contains(basePath, "?") {
		{{ sep = "&" }}
	}
	@PickerControl("sort", "sort", current.param(), "", sortOptions(basePath, sep, current, false, filters))
}

// sortOptions builds the newest/oldest/magic picker options for a base URL. The
// magic option is dropped when noMagic is set.
func sortOptions(basePath, sep string, current itemSort, noMagic bool, filters listFilters) []pickerOption {
	opts := []pickerOption{
		{Value: string(sortNewest), Label: "newest", Icon: "desc", Href: filters.appendFilters(basePath+sep+"sort=newest")},
		{Value: string(sortOldest), Label: "oldest", Icon: "asc", Href: filters.appendFilters(basePath+sep+"sort=oldest")},
	}
	if !noMagic {
		opts = append(opts, pickerOption{Value: string(sortMagic), Label: "magic", Icon: "magic", Href: filters.appendFilters(basePath+sep+"sort=magic")})
	}
	return opts
}

// ModeIcon renders the small Lucide icon for a picker option.
templ ModeIcon(name string) {
	switch name {
		case "grid":
			@web.Lucide("layout-grid")
		case "cards":
			@web.Lucide("layout-dashboard")
		case "list":
			@web.Lucide("list")
		case "desc":
			@web.Lucide("arrow-down")
		case "asc":
			@web.Lucide("arrow-up")
		case "magic":
			@web.Lucide("sparkles")
	}
}

templ ItemView(d itemViewData) {
	@itemViewInner(d, visualsFromKind(d))
}

templ itemViewInner(d itemViewData, v itemVisuals) {
	<div class="item-view">
		<!-- Relocated into the dialog header by openItem: the title (left) and
		     the fav / read / ⋯ controls (right), so both sit at the top and only
		     the content below scrolls. -->
		<div id="item-dialog-controls-src">
			<h1>{ d.Title }</h1>
			<div class="item-controls">
				@itemViewControls(d.ID, d.Favorite, d.Bookmark, d.Read)
				@itemMenuFullSys(d.ID, d.AuthorID, d.SourceURL, d.ShareToken, true, d.FeedIsSystem)
			</div>
		</div>
		<p class="item-meta">
			if d.FeedIsSystem {
				<span>saved</span>
			} else if len(d.Attribution) > 0 {
				@attrParts(d.Attribution)
			} else {
				if d.AuthorName != "" {
					<a href={ "/authors/" + strconv.FormatInt(d.AuthorID, 10) }>{ d.AuthorName }</a>
				} else if u := authorFeedURL(d.AuthorID, d.FeedID); u != "" {
					<a href={ templ.URL(u) }>feed</a>
				}
			}
			if d.PublishedAt != "" {
				· { web.TimeFmt(d.Timezone, d.PublishedAt) }
			}
			if dur := web.FormatDuration(d.DurationSec); dur != "" {
				· { dur }
			}
			· <a href={ templ.URL(d.Link) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">open live</a>
		</p>
		if len(d.Categories) > 0 {
			<p class="item-tags muted small">
				for _, c := range d.Categories {
					if d.FeedIsSystem {
						<span class="item-tag">#{ c }</span>{ " " }
					} else if u := authorTagHref(d.AuthorID, c); u != "" {
						<a class="item-tag" href={ templ.URL(u) } title={ "show items tagged " + c }>#{ c }</a>{ " " }
					} else {
						<span class="item-tag">#{ c }</span>{ " " }
					}
				}
			</p>
		}
		@itemContent(d, v)
	</div>
}

// itemContent renders an item's media, body, and enclosures. Shared between the
// authenticated modal and the public share page.
templ itemContent(d itemViewData, v itemVisuals) {
	if len(d.Gallery) > 0 {
		<div class="gallery">
			for _, img := range d.Gallery {
				<img src={ templ.URL(d.imgSrc(img)) } alt="" loading="lazy"/>
			}
		</div>
	} else if d.EmbedSrc != "" {
		<div class="video-embed">
			<!-- The app's global Referrer-Policy: no-referrer would strip the
			     Referer some players require (for example, YouTube error 153).
			     Override it here so only the embedding origin is sent. -->
			<iframe
				src={ templ.URL(d.resumeSrc()) }
				title={ d.Title }
				frameborder="0"
				allow="autoplay; fullscreen; picture-in-picture; web-share"
				allowfullscreen
				loading="lazy"
				referrerpolicy="origin"
				if d.Progress != nil && d.Progress.Player == web.PlayerYouTube {
					data-progress-item={ strconv.FormatInt(d.Progress.ItemID, 10) }
					data-progress-key={ d.Progress.Key }
					data-progress-player={ d.Progress.Player }
					data-progress-resume={ strconv.Itoa(d.Progress.Position) }
					data-progress-duration={ strconv.Itoa(d.Progress.Duration) }
				}
			></iframe>
		</div>
	} else if v.Image {
		<div class="image-lightbox">
			<img src={ templ.URL(d.cachedImageSrc(web.BestImageURL(d.Summary, d.ImageURL))) } alt={ d.Title } loading="lazy"/>
		</div>
	}
	if d.Body != "" && !v.Image && d.SourceURL == "" && len(d.Gallery) == 0 {
		<div class="item-body">@templ.Raw(d.bodyHTML())
</div>
	}
	if len(d.Enclosures) > 0 {
		<div class="enclosures">
			if imgs := web.ImageEnclosures(d.Enclosures); len(imgs) > 0 && !v.Image && len(d.Gallery) == 0 && !web.BodyHasImage(d.Summary) {
				if len(imgs) == 1 {
					<div class="image-lightbox">
						<img src={ templ.URL(d.enclosureSrc(imgs[0])) } alt="" loading="lazy"/>
					</div>
				} else {
					<div class="gallery">
						for _, e := range imgs {
							<img src={ templ.URL(d.enclosureSrc(e)) } alt="" loading="lazy"/>
						}
					</div>
				}
			}
			if d.EmbedSrc == "" {
				for _, e := range d.Enclosures {
					if kind := web.EnclosureKind(e); kind == "hls" {
						// An HLS manifest is played by hls.js (static/hls-video.js
						// loads it lazily and attaches on the data-hls URL); the
						// enclosure poster or the item thumbnail is the poster.
						<figure>
							<video
								controls
								preload="none"
								data-hls={ e.URL }
								poster={ templ.URL(d.enclosurePoster(e)) }
								if d.Progress != nil && d.Progress.Player == web.PlayerNative {
									data-progress-item={ strconv.FormatInt(d.Progress.ItemID, 10) }
									data-progress-key={ d.Progress.Key }
									data-progress-player={ d.Progress.Player }
									data-progress-resume={ strconv.Itoa(d.Progress.Position) }
									data-progress-duration={ strconv.Itoa(d.Progress.Duration) }
								}
							></video>
						</figure>
					} else if kind == "video" {
						<figure>
							<video
								controls
								preload="none"
								src={ templ.URL(e.URL) }
								poster={ templ.URL(d.enclosurePoster(e)) }
								if d.Progress != nil && d.Progress.Player == web.PlayerNative {
									data-progress-item={ strconv.FormatInt(d.Progress.ItemID, 10) }
									data-progress-key={ d.Progress.Key }
									data-progress-player={ d.Progress.Player }
									data-progress-resume={ strconv.Itoa(d.Progress.Position) }
									data-progress-duration={ strconv.Itoa(d.Progress.Duration) }
								}
							></video>
						</figure>
					} else if kind == "audio" {
						<figure>
							<audio
								controls
								preload="none"
								src={ templ.URL(e.URL) }
								if d.Progress != nil && d.Progress.Player == web.PlayerNative {
									data-progress-item={ strconv.FormatInt(d.Progress.ItemID, 10) }
									data-progress-key={ d.Progress.Key }
									data-progress-player={ d.Progress.Player }
									data-progress-resume={ strconv.Itoa(d.Progress.Position) }
									data-progress-duration={ strconv.Itoa(d.Progress.Duration) }
								}
							></audio>
						</figure>
					}
				}
			}
			<ul class="plain small">
				for _, e := range d.Enclosures {
					if kind := web.EnclosureKind(e); kind != "image" {
						<li>· <a href={ templ.URL(e.URL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">{ web.EnclosureLabel(e) }</a></li>
					}
				}
			</ul>
		</div>
	}
}

// shareControl toggles the public share link for an item, as entries in the
// item modal's ⋯ menu; re-swapped in place by the share/revoke endpoints.
templ shareControl(itemID int64, token string) {
	<div id="item-share" class="share-menu">
		if token != "" {
			<a class="menu-item external" role="menuitem" href={ "/shared/" + token } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">share link</a>
			<button class="link menu-item danger" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/revoke" } hx-target="#item-share" hx-swap="outerHTML">stop sharing</button>
		} else {
			<button type="button" class="link menu-item" role="menuitem" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/share" } hx-target="#item-share" hx-swap="outerHTML">share</button>
		}
	</div>
}

// itemMenuFullSys is the "⋯" action menu on an item card (list/grid) and in the
// item modal (inModal): "add to list", "go to author" (omitted for a saved page,
// whose author is hidden), the bulk "mark all before/after as read" actions, and
// in the modal the source link and the share control. The dropdown is scoped per
// item via data-item-id so many cards can each have one.
templ itemMenuFullSys(itemID, authorID int64, sourceURL, shareToken string, inModal, isSystem bool) {
	<div class="item-menu" data-item-id={ strconv.FormatInt(itemID, 10) }>
		<button type="button" class="link menu-btn" aria-haspopup="true" aria-expanded="false" title="more actions" data-toggle-item-menu>@web.Lucide("ellipsis")
</button>
		<div class="menu-pop" role="menu" hidden>
			<button type="button" class="link menu-item" role="menuitem" data-item-menu="lists">add to list</button>
			if !isSystem && authorID != 0 {
				<a class="menu-item" role="menuitem" href={ "/authors/" + strconv.FormatInt(authorID, 10) }>go to author</a>
			}
			if inModal && sourceURL != "" {
				<a class="menu-item external" role="menuitem" href={ templ.URL(sourceURL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">source</a>
			}
			<button type="button" class="link menu-item" role="menuitem" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/read-before" } hx-swap="none" data-reload-on-success>mark all before as read</button>
			<button type="button" class="link menu-item" role="menuitem" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/read-after" } hx-swap="none" data-reload-on-success>mark all after as read</button>
			if inModal {
				<button type="button" class="link menu-item" role="menuitem" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/unread" } hx-swap="none" data-unread-reload>mark as not read</button>
				@shareControl(itemID, shareToken)
			}
			if isSystem {
				<button type="button" class="link menu-item danger" role="menuitem" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/delete" } hx-swap="none" hx-confirm="delete this saved url?">delete saved url</button>
			}
		</div>
	</div>
}

// itemListsDialogInner is the add-to-list picker content, injected into the
// shared #item-lists-dialog (declared in views_layout.templ) by the "add to
// list" menu action. It is a multi-select combo: favorites is a normal item
// whose value "favorites" maps to items.favorite, and the user's lists follow.
// The form posts to the apply endpoint, which re-renders this content and
// signals "item-lists-saved"; app.js closes the dialog on that event.
templ itemListsDialogInner(itemID int64, items []comboItem, selected []string) {
	<div class="row">
		<h2>add to list</h2>
		<button type="button" class="link" data-close-dialog>@web.Lucide("x")</button>
	</div>
	<form class="stack" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/lists" } hx-target="#item-lists-dialog" hx-swap="innerHTML">
		@comboMulti("lists", "lists", selected, items)
		<div id="item-lists-error" class="error"></div>
		<button type="submit">save</button>
	</form>
}

// sharedItemPage is the public, unauthenticated view of a shared item. It
// reuses itemContent but never links to internal author/feed pages.
templ sharedItemPage(it store.ItemWithFeed, d itemViewData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@head(it.Title, "")
		</head>
		<body>
			<main>
				<div class="item-view">
					<h1>{ d.Title }</h1>
					<p class="item-meta">
						{ it.FeedTitle }
						if d.PublishedAt != "" {
							· { web.TimeFmt("", d.PublishedAt) }
						}
						if dur := web.FormatDuration(d.DurationSec); dur != "" {
							· { dur }
						}
						· <a href={ templ.URL(d.Link) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">open live</a>
					</p>
					@itemContent(d, visualsOf(store.ItemWithFeed{
						Item: store.Item{
							Link:     d.Link,
							Summary:  d.Summary,
							ImageURL: d.ImageURL,
							Title:    d.Title,
						},
					}))
				</div>
			</main>
		</body>
	</html>
}

// markAllReadControl is the check-check button plus its confirmation dialog,
// shown in the author page header. Its action already carries the active
// feed/tag filter, so it marks every unread item the list shows read; the dialog
// gates it because the action is not one-click reversible. Only one control
// renders per page, so the dialog is reached relative to the button rather than
// by a page-unique id.
templ markAllReadControl(d markAllReadData) {
	if d.Action != "" {
		<div class="mark-all-read">
			<button
				type="button"
				class="link"
				title={ "mark all " + strconv.Itoa(d.Unread) + " items as read" }
				if d.Unread == 0 {
					disabled
				}
				data-open-next
			>@web.Lucide("check-check")
</button>
			if d.Unread > 0 {
				<dialog class="modal">
					<div class="row">
						<h2>mark { d.Unread } items as read?</h2>
						<button type="button" class="link" title="close" data-close-dialog>@web.Lucide("x")
</button>
					</div>
					<div class="row-actions">
						<button type="button" class="link" data-close-dialog>cancel</button>
						<button type="button" hx-post={ d.Action } hx-swap="none" data-reload-close>mark as read</button>
					</div>
				</dialog>
			}
		</div>
	}
}
