package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

// itemVisuals precomputes an item's rendering classification once per row so
// the expensive HTML parse in IsImagePost runs a single time.
type itemVisuals struct {
	Video   bool
	Image   bool
	Link    bool
	Gallery bool
}

func visualsOf(it store.ItemWithFeed) itemVisuals {
	return itemVisuals{
		Video:   web.YoutubeEmbedURL(it.Link) != "",
		Image:   web.IsImagePost(it.Summary, it.ImageURL, it.Title),
		Link:    web.IsLinkPost(it.ImageURL),
		Gallery: web.IsGallery(it.ImageURL),
	}
}

func itemCardClass(v itemVisuals) string {
	switch {
	case v.Video:
		return "video-card"
	case v.Image || v.Gallery:
		return "image-card"
	case v.Link:
		return "link-card"
	default:
		return "text-card"
	}
}

// loadMoreData carries the fragment URL for a "load more" button. It is nil
// when there is no next page.
type loadMoreData struct {
	URL string // full fragment URL including the before= cursor
}

// itemsListClass is the <ul> class for an item list: "items", plus "masonry"
// when the scope's saved display mode is grid. The mode is server-side (per
// account), so the list is laid out correctly on first paint.
func itemsListClass(mode string) string {
	if store.NormalizeViewMode(mode) == store.ViewModeGrid {
		return "items masonry"
	}
	return "items"
}

templ ItemsList(items []store.ItemWithFeed, hideAuthor bool, mode string) {
	if len(items) > 0 {
		<ul class={ itemsListClass(mode) } id="items-list">
			for _, it := range items {
				@ItemRow(it, hideAuthor)
			}
		</ul>
	} else {
		<p class="muted" id="items-list">nothing here</p>
	}
}

// ItemsListPage renders the item list plus a "load more" button when more
// pages exist. The button appends the next page into the list via htmx.
templ ItemsListPage(items []store.ItemWithFeed, more *loadMoreData, hideAuthor bool, mode string) {
	@ItemsList(items, hideAuthor, mode)
	if more != nil {
		<button id="load-more" hx-get={ templ.URL(more.URL) } hx-target="#items-list" hx-swap="beforeend">load more</button>
	}
}

// ItemsSection wraps the list and its load-more button so list-wide actions
// (e.g. "mark all read") can swap the whole section atomically instead of
// orphaning a stale load-more button.
templ ItemsSection(items []store.ItemWithFeed, more *loadMoreData, hideAuthor bool, mode string) {
	<div id="items-section">
		@ItemsListPage(items, more, hideAuthor, mode)
	</div>
}

// ItemsPage is the fragment response for a load-more request: the appended
// item rows plus an out-of-band swap that replaces (or removes) the load-more
// button.
templ ItemsPage(items []store.ItemWithFeed, more *loadMoreData, hideAuthor bool) {
	for _, it := range items {
		@ItemRow(it, hideAuthor)
	}
	if more != nil {
		<button id="load-more" hx-swap-oob="outerHTML" hx-get={ templ.URL(more.URL) } hx-target="#items-list" hx-swap="beforeend">load more</button>
	} else {
		<button id="load-more" hx-swap-oob="delete" hidden></button>
	}
}

templ ItemRow(it store.ItemWithFeed, hideAuthor bool) {
	@itemRowInner(it, visualsOf(it), hideAuthor)
}

templ itemRowInner(it store.ItemWithFeed, v itemVisuals, hideAuthor bool) {
	<li id={ "item-" + strconv.FormatInt(it.ID, 10) } class={ itemCardClass(v) }>
		if v.Video {
			<a class="thumb" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">
				if it.ImageURL != "" {
					<img src={ templ.URL(it.ImageURL) } alt="" loading="lazy"/>
				} else {
					<span class="thumb-ph">▶</span>
				}
			</a>
		} else if v.Image || v.Link || v.Gallery {
			<a class="thumb thumb--img" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">
				if gthumb := web.GalleryThumb(it.ImageURL); gthumb != "" {
					<img src={ templ.URL(gthumb) } alt="" loading="lazy"/>
				} else {
					<img src={ templ.URL(it.ImageURL) } alt="" loading="lazy"/>
				}
				if v.Link {
					<span class="thumb-badge" title="content lives on an external site">external</span>
				}
			</a>
		} else if it.ImageURL != "" {
			// A text post that still carries a thumbnail (e.g. one that arrived
			// only as an image enclosure) gets a thumb beside its text.
			<a class="thumb thumb--img" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">
				<img src={ templ.URL(it.ImageURL) } alt="" loading="lazy"/>
			</a>
		}
		<div class="card-body">
			<div class="row">
				<div>
					if it.Read {
						<a class="item-title" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">{ it.Title }</a>
					} else {
						<a class="item-title unread" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">{ it.Title }</a>
					}
					<div class="item-meta">
						@web.SourceIcon(itemIconURL(it))
						if it.AuthorName != "" && !hideAuthor {
							<a href={ "/authors/" + strconv.FormatInt(it.AuthorID, 10) }>{ it.AuthorName }</a>
						} else {
							<a href={ "/feeds/" + strconv.FormatInt(it.FeedID, 10) }>{ it.FeedTitle }</a>
						}
						for _, src := range it.Sources {
							· also in <a href={ "/feeds/" + strconv.FormatInt(src.FeedID, 10) }>{ src.FeedTitle }</a><a href={ templ.URL(src.Link) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external"></a>
						}
						if it.PublishedAt != "" {
							· { web.TimeFmt(it.Timezone, it.PublishedAt) }
						}
						if it.Read && it.ReadAt != "" {
							· <span class="read-at">read { web.TimeFmt(it.Timezone, it.ReadAt) }</span>
						}
					</div>
					if it.Summary != "" && !v.Image && !v.Link && !v.Gallery {
						<div class="item-summary">{ web.StripHTML(it.Summary) }</div>
					}
				</div>
				<div class="row-actions">
					if it.Favorite {
						<button
							class="link fav-btn"
							title="unfavorite"
							hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/favorite" }
							hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) }
							hx-swap="outerHTML"
							if hideAuthor {
								hx-vals={ `{"hideAuthor":"1"}` }
							}
						>
							@web.FavIcon(true)
						</button>
					} else {
						<button
							class="link fav-btn"
							title="favorite"
							hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/favorite" }
							hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) }
							hx-swap="outerHTML"
							if hideAuthor {
								hx-vals={ `{"hideAuthor":"1"}` }
							}
						>
							@web.FavIcon(false)
						</button>
					}
					if it.Read {
						<button
							class="link read-btn"
							title="mark unread"
							hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/read" }
							hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) }
							hx-swap="outerHTML"
							if hideAuthor {
								hx-vals={ `{"hideAuthor":"1"}` }
							}
						>@web.Lucide("rotate-ccw")
</button>
					} else {
						<button
							class="link read-btn"
							title="mark read"
							hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/read" }
							hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) }
							hx-swap="outerHTML"
							if hideAuthor {
								hx-vals={ `{"hideAuthor":"1"}` }
							}
						>@web.Lucide("check")
</button>
					}
					@itemMenu(it.ID, it.FeedID)
				</div>
			</div>
		</div>
	</li>
}

templ ScopedItems(d scopedItemsData) {
	if d.SwapOOB {
		<div id="scoped-items" hx-swap-oob="outerHTML">
			@scopedItemsInner(d)
		</div>
	} else {
		<div id="scoped-items">
			@scopedItemsInner(d)
		</div>
	}
}

templ scopedItemsInner(d scopedItemsData) {
	<div class="tabs-row">
		<nav class="tabs">
			if d.View == "unread" {
				<a class="active" href={ d.Path + "?view=unread&dir=" + d.Dir } hx-get={ d.ItemsPath + "?view=unread&dir=" + d.Dir } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=unread&dir=" + d.Dir }>unread ({ d.UnreadCount })</a>
			} else {
				<a href={ d.Path + "?view=unread&dir=" + d.Dir } hx-get={ d.ItemsPath + "?view=unread&dir=" + d.Dir } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=unread&dir=" + d.Dir }>unread ({ d.UnreadCount })</a>
			}
			if d.View == "read" {
				<a class="active" href={ d.Path + "?view=read&dir=" + d.Dir } hx-get={ d.ItemsPath + "?view=read&dir=" + d.Dir } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=read&dir=" + d.Dir }>read ({ d.ReadCount })</a>
			} else {
				<a href={ d.Path + "?view=read&dir=" + d.Dir } hx-get={ d.ItemsPath + "?view=read&dir=" + d.Dir } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=read&dir=" + d.Dir }>read ({ d.ReadCount })</a>
			}
		</nav>
		<div class="row-actions">
			@SortDirControl(d.Dir, d.Path+"?view="+d.View+"&dir=desc", d.Path+"?view="+d.View+"&dir=asc")
			@DisplayModeControl(d.Path, d.Mode)
		</div>
	</div>
	@ItemsListPage(d.Items, d.More, d.HideAuthor, d.Mode)
}

// pickerOption is one choice in a PickerControl. Client-side pickers (no Href)
// are handled by app.js via data attributes + localStorage; server-side pickers
// set Href/HxGet so the option reloads the list.
type pickerOption struct {
	Value    string
	Label    string
	Icon     string // ModeIcon name; "" renders a label only
	Href     string
	HxGet    string
	HxTarget string
}

// PickerControl is the shared pill + dropdown used for the display mode, the
// authors sort, and the item sort direction. The button shows the current
// option's icon/label; the server renders the default and app.js re-syncs it
// from state after swaps. scope namespaces a client-side picker's remembered
// value (the display mode is remembered per page); it is "" for pickers whose
// state is not scoped.
templ PickerControl(name, title, current, scope string, options []pickerOption) {
	<div class="picker" data-picker={ name } data-scope={ scope } data-mode={ current }>
		<button type="button" class="mode-btn" aria-haspopup="true" aria-expanded="false" title={ title } onclick="togglePicker(event)">
			for _, o := range options {
				if o.Icon != "" {
					<span
						class="pick-ic"
						data-option={ o.Value }
						if o.Value != current {
							hidden
						}
					>@ModeIcon(o.Icon)
</span>
				}
				<span
					class="pick-label"
					data-option={ o.Value }
					if o.Value != current {
						hidden
					}
				>{ o.Label }</span>
			}
		</button>
		<div class="mode-menu" role="menu" hidden>
			for _, o := range options {
				if o.Href != "" {
					<a
						class="mode-option"
						role="menuitemradio"
						data-option={ o.Value }
						aria-checked={ strconv.FormatBool(o.Value == current) }
						href={ templ.URL(o.Href) }
						if o.HxGet != "" {
							hx-get={ templ.URL(o.HxGet) }
							hx-target={ o.HxTarget }
							hx-swap="outerHTML"
							hx-push-url={ templ.URL(o.Href) }
						}
					>
						if o.Icon != "" {
							@ModeIcon(o.Icon)
						}
						<span>{ o.Label }</span>
					</a>
				} else {
					<button type="button" class="mode-option" role="menuitemradio" data-option={ o.Value } aria-checked={ strconv.FormatBool(o.Value == current) }>
						if o.Icon != "" {
							@ModeIcon(o.Icon)
						}
						<span>{ o.Label }</span>
					</button>
				}
			}
		</div>
	</div>
}

// DisplayModeControl is the list/grid picker shown alongside the unread/read
// tabs and in the home/history/favorites headers. mode is the user's saved
// preference for this scope (server-side, per account); scope is the page key
// the choice is stored under. Clicking an option asks app.js to persist the
// change to /prefs/display and re-apply it.
templ DisplayModeControl(scope, mode string) {
	@PickerControl("display", "display mode", store.NormalizeViewMode(mode), scope, []pickerOption{
		{Value: "list", Label: "list", Icon: "list"},
		{Value: "grid", Label: "grid", Icon: "grid"},
	})
}

// AuthorSortControl sorts the authors list alphabetically ("abc"), by newest
// first, or by most unread items. Client-side: app.js reorders the rendered
// rows. The default is "unread".
templ AuthorSortControl() {
	@PickerControl("authors", "sort", "unread", "", []pickerOption{
		{Value: "abc", Label: "abc"},
		{Value: "newest", Label: "newest"},
		{Value: "unread", Label: "unread"},
	})
}

// SortDirControl is the asc/desc picker for item lists. Server-side: each
// option is a link that reloads the page with ?dir=.
templ SortDirControl(dir, descHref, ascHref string) {
	@PickerControl("dir", "sort order", dir, "", []pickerOption{
		{Value: "desc", Label: "newest", Icon: "desc", Href: descHref},
		{Value: "asc", Label: "oldest", Icon: "asc", Href: ascHref},
	})
}

// ModeIcon renders the small Lucide icon for a picker option.
templ ModeIcon(name string) {
	switch name {
		case "grid":
			@web.Lucide("layout-grid")
		case "list":
			@web.Lucide("list")
		case "desc":
			@web.Lucide("arrow-down")
		case "asc":
			@web.Lucide("arrow-up")
	}
}

templ ItemView(d itemViewData) {
	@itemViewInner(d, visualsOf(store.ItemWithFeed{
		Item: store.Item{
			Link:     d.Link,
			Summary:  d.Summary,
			ImageURL: d.ImageURL,
			Title:    d.Title,
		},
	}))
}

templ itemViewInner(d itemViewData, v itemVisuals) {
	<div class="item-view">
		<h1>{ d.Title }</h1>
		<p class="item-meta">
			if d.AuthorName != "" {
				<a href={ "/authors/" + strconv.FormatInt(d.AuthorID, 10) }>{ d.AuthorName }</a> ·
			}
			<a href={ "/feeds/" + strconv.FormatInt(d.FeedID, 10) }>feed</a>
			if d.PublishedAt != "" {
				· { web.TimeFmt(d.Timezone, d.PublishedAt) }
			}
			· <a href={ templ.URL(d.Link) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">open live</a>
		</p>
		<div class="item-controls" id="item-dialog-controls-src">
			@itemMenuFull(d.ID, d.FeedID, d.SourceURL, d.ShareToken, true)
		</div>
		@itemContent(d, v)
	</div>
}

// itemContent renders an item's media, body, and enclosures. Shared between the
// authenticated modal and the public share page.
templ itemContent(d itemViewData, v itemVisuals) {
	if len(d.Gallery) > 0 {
		<div class="gallery">
			for _, img := range d.Gallery {
				<img src={ templ.URL(img) } alt="" loading="lazy"/>
			}
		</div>
	} else if d.EmbedSrc != "" {
		<div class="video-embed">
			<iframe src={ templ.URL(d.EmbedSrc) } title={ d.Title } frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy" referrerpolicy="no-referrer"></iframe>
		</div>
	} else if d.EmbedURL != "" {
		<div class="video-embed">
			<!-- The app's global Referrer-Policy: no-referrer would strip the
			     Referer the YouTube player needs (error 153). Override it here
			     so only the embedding origin is sent. -->
			<iframe src={ templ.URL(d.EmbedURL) } title={ d.Title } frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy" referrerpolicy="origin"></iframe>
		</div>
	} else if v.Image {
		<div class="image-lightbox">
			<img src={ templ.URL(web.BestImageURL(d.Summary, d.ImageURL)) } alt={ d.Title } loading="lazy"/>
		</div>
	}
	if d.Body != "" && !v.Image && d.SourceURL == "" && len(d.Gallery) == 0 {
		<div class="item-body">@templ.Raw(web.UpgradeImageSrcs(string(d.Body)))
</div>
	}
	if len(d.Enclosures) > 0 {
		<div class="enclosures">
			if imgs := web.ImageEnclosures(d.Enclosures); len(imgs) > 0 && !v.Image && len(d.Gallery) == 0 && !web.BodyHasImage(d.Summary) {
				if len(imgs) == 1 {
					<div class="image-lightbox">
						<img src={ templ.URL(imgs[0].URL) } alt="" loading="lazy"/>
					</div>
				} else {
					<div class="gallery">
						for _, e := range imgs {
							<img src={ templ.URL(e.URL) } alt="" loading="lazy"/>
						}
					</div>
				}
			}
			if d.EmbedSrc == "" {
				for _, e := range d.Enclosures {
					if kind := web.EnclosureKind(e); kind == "video" {
						<figure>
							<video controls preload="none" src={ templ.URL(e.URL) }></video>
						</figure>
					} else if kind == "audio" {
						<figure>
							<audio controls preload="none" src={ templ.URL(e.URL) }></audio>
						</figure>
					}
				}
			}
			<ul class="plain small">
				for _, e := range d.Enclosures {
					if kind := web.EnclosureKind(e); kind != "image" {
						<li>· <a href={ templ.URL(e.URL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">{ web.EnclosureLabel(e) }</a></li>
					}
				}
			</ul>
		</div>
	}
}

// shareControl toggles the public share link for an item, as entries in the
// item modal's ⋯ menu; re-swapped in place by the share/revoke endpoints.
templ shareControl(itemID int64, token string) {
	<div id="item-share" class="share-menu">
		if token != "" {
			<a class="menu-item external" role="menuitem" href={ "/shared/" + token } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">share link</a>
			<button class="link menu-item danger" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/revoke" } hx-target="#item-share" hx-swap="outerHTML">stop sharing</button>
		} else {
			<button type="button" class="link menu-item" role="menuitem" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/share" } hx-target="#item-share" hx-swap="outerHTML">share</button>
		}
	</div>
}

// itemMenu is the "⋯" action menu on an item card (list/grid). It opens a
// dropdown of extra options: "add to list", "go to feed", and bulk "mark all
// before/after as read" for the item's feed. The item modal uses itemMenuFull,
// which adds the source link and the share control. The dropdown is scoped per
// item via data-item-id so many cards can each have one.
templ itemMenu(itemID, feedID int64) {
	@itemMenuFull(itemID, feedID, "", "", false)
}

// itemMenuFull renders the ⋯ menu. In the modal (inModal) it also carries the
// external "source" link (when the item resolves to one) and the share control.
templ itemMenuFull(itemID, feedID int64, sourceURL, shareToken string, inModal bool) {
	<div class="item-menu" data-item-id={ strconv.FormatInt(itemID, 10) }>
		<button type="button" class="link menu-btn" aria-haspopup="true" aria-expanded="false" title="more actions" onclick="toggleItemMenu(event)">@web.Lucide("ellipsis")
</button>
		<div class="menu-pop" role="menu" hidden>
			<button type="button" class="link menu-item" role="menuitem" onclick="itemMenuAction(event, 'lists')">add to list</button>
			<a class="menu-item" role="menuitem" href={ "/feeds/" + strconv.FormatInt(feedID, 10) }>go to feed</a>
			if inModal && sourceURL != "" {
				<a class="menu-item external" role="menuitem" href={ templ.URL(sourceURL) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer">source</a>
			}
			<button type="button" class="link menu-item" role="menuitem" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/read-before" } hx-swap="none" hx-on::after-request="if(event.detail.successful) window.location.reload()">mark all before as read</button>
			<button type="button" class="link menu-item" role="menuitem" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/read-after" } hx-swap="none" hx-on::after-request="if(event.detail.successful) window.location.reload()">mark all after as read</button>
			if inModal {
				<button type="button" class="link menu-item" role="menuitem" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/unread" } hx-swap="none" hx-on::after-request="if(event.detail.successful) markUnreadReload()">mark as not read</button>
				@shareControl(itemID, shareToken)
			}
		</div>
	</div>
}

// itemListsDialogInner is the add-to-list picker content, injected into the
// shared #item-lists-dialog (declared in views_layout.templ) by the "add to
// list" menu action. It is a multi-select combo: favorites is a normal item
// whose value "favorites" maps to items.favorite, and the user's lists follow.
// The form posts to the apply endpoint, which re-renders this content and
// signals "item-lists-saved"; app.js closes the dialog on that event.
templ itemListsDialogInner(itemID int64, items []comboItem, selected []string) {
	<div class="row">
		<h2>add to list</h2>
		<button type="button" class="link" onclick="this.closest('dialog').close()">@web.Lucide("x")</button>
	</div>
	<form class="stack" hx-post={ "/items/" + strconv.FormatInt(itemID, 10) + "/lists" } hx-target="#item-lists-dialog" hx-swap="innerHTML">
		@comboMulti("lists", "lists", selected, items)
		<div id="item-lists-error" class="error"></div>
		<button type="submit">save</button>
	</form>
}

// sharedItemPage is the public, unauthenticated view of a shared item. It
// reuses itemContent but never links to internal author/feed pages.
templ sharedItemPage(it store.ItemWithFeed, d itemViewData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@head(it.Title, "")
		</head>
		<body>
			<main>
				<div class="item-view">
					<h1>{ d.Title }</h1>
					<p class="item-meta">
						{ it.FeedTitle }
						if d.PublishedAt != "" {
							· { web.TimeFmt("", d.PublishedAt) }
						}
						· <a href={ templ.URL(d.Link) } target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer" class="external">open live</a>
					</p>
					@itemContent(d, visualsOf(store.ItemWithFeed{
						Item: store.Item{
							Link:     d.Link,
							Summary:  d.Summary,
							ImageURL: d.ImageURL,
							Title:    d.Title,
						},
					}))
				</div>
			</main>
		</body>
	</html>
}

// markAllReadControl is the check-check button plus its confirmation dialog,
// shown in the header of a feed page and an author page. It marks every unread
// item in scope read; the dialog gates it because the action is not one-click
// reversible. Only one control renders per page, so the dialog is reached
// relative to the button rather than by a page-unique id.
templ markAllReadControl(d markAllReadData) {
	<div class="mark-all-read">
		<button
			type="button"
			class="link"
			title={ "mark all " + strconv.Itoa(d.Unread) + " items as read" }
			if d.Unread == 0 {
				disabled
			}
			onclick="this.nextElementSibling.showModal()"
		>@web.Lucide("check-check")
</button>
		if d.Unread > 0 {
			<dialog class="modal">
				<div class="row">
					<h2>mark { d.Unread } items as read?</h2>
					<button type="button" class="link" title="close" onclick="this.closest('dialog').close()">@web.Lucide("x")
</button>
				</div>
				<div class="row-actions">
					<button type="button" class="link" onclick="this.closest('dialog').close()">cancel</button>
					<button type="button" hx-post={ d.Action } hx-swap="none" hx-on::after-request="if(event.detail.successful){this.closest('dialog').close();window.location.reload()}">mark as read</button>
				</div>
			</dialog>
		}
	</div>
}
