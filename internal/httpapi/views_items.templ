package httpapi

import (
	"strconv"

	"github.com/metruzanca/nanoflux/internal/store"
	"github.com/metruzanca/nanoflux/internal/web"
)

// itemVisuals precomputes an item's rendering classification once per row so
// the expensive HTML parse in IsImagePost runs a single time.
type itemVisuals struct {
	Video   bool
	Image   bool
	Link    bool
	Gallery bool
}

func visualsOf(it store.ItemWithFeed) itemVisuals {
	return itemVisuals{
		Video:   web.YoutubeEmbedURL(it.Link) != "",
		Image:   web.IsImagePost(it.Summary, it.ImageURL, it.Title),
		Link:    web.IsLinkPost(it.ImageURL),
		Gallery: web.IsGallery(it.ImageURL),
	}
}

func itemCardClass(v itemVisuals) string {
	switch {
	case v.Video:
		return "video-card"
	case v.Image || v.Gallery:
		return "image-card"
	case v.Link:
		return "link-card"
	default:
		return "text-card"
	}
}

templ ItemsList(items []store.ItemWithFeed) {
	if len(items) > 0 {
		<ul class="items" id="items-list">
			for _, it := range items {
				@ItemRow(it)
			}
		</ul>
	} else {
		<p class="muted" id="items-list">nothing here</p>
	}
}

templ ItemRow(it store.ItemWithFeed) {
	@itemRowInner(it, visualsOf(it))
}

templ itemRowInner(it store.ItemWithFeed, v itemVisuals) {
	<li id={ "item-" + strconv.FormatInt(it.ID, 10) } class={ itemCardClass(v) }>
		if v.Video {
			<a class="thumb" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">
				if it.ImageURL != "" {
					<img src={ templ.URL(it.ImageURL) } alt="" loading="lazy"/>
				} else {
					<span class="thumb-ph">▶</span>
				}
			</a>
		} else if v.Image || v.Link || v.Gallery {
			<a class="thumb thumb--img" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">
				if gthumb := web.GalleryThumb(it.ImageURL); gthumb != "" {
					<img src={ templ.URL(gthumb) } alt="" loading="lazy"/>
				} else {
					<img src={ templ.URL(it.ImageURL) } alt="" loading="lazy"/>
				}
				if v.Link {
					<span class="thumb-badge" title="content lives on an external site">external</span>
				}
			</a>
		}
		<div class="card-body">
			<div class="row">
				<div>
					if it.Read {
						<a class="item-title" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">{ it.Title }</a>
					} else {
						<a class="item-title unread" href={ "#item-" + strconv.FormatInt(it.ID, 10) } data-item-id={ strconv.FormatInt(it.ID, 10) } data-item-link={ it.Link } onclick="return openItem(this)">{ it.Title }</a>
					}
					<div class="item-meta">
						if it.AuthorName != "" {
							<a href={ "/authors/" + strconv.FormatInt(it.AuthorID, 10) }>{ it.AuthorName }</a> ·
						}
						@web.SourceIcon(it.FeedURL)
						<a href={ "/feeds/" + strconv.FormatInt(it.FeedID, 10) }>{ it.FeedTitle }</a>
						if it.PublishedAt != "" {
							· { web.TimeFmt(it.Timezone, it.PublishedAt) }
						}
						if it.Read && it.ReadAt != "" {
							· <span class="read-at">read { web.TimeFmt(it.Timezone, it.ReadAt) }</span>
						}
					</div>
					if it.Summary != "" && !v.Image && !v.Link && !v.Gallery {
						<div class="item-summary">{ web.StripHTML(it.Summary) }</div>
					}
				</div>
				<div class="row-actions">
					if it.Favorite {
						<button class="link fav-btn" title="unfavorite" hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/favorite" } hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) } hx-swap="outerHTML">
							@web.FavIcon(true)
						</button>
					} else {
						<button class="link fav-btn" title="favorite" hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/favorite" } hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) } hx-swap="outerHTML">
							@web.FavIcon(false)
						</button>
					}
					if it.Read {
						<button class="link read-btn" title="mark unread" hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/read" } hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) } hx-swap="outerHTML">↺</button>
					} else {
						<button class="link read-btn" title="mark read" hx-post={ "/items/" + strconv.FormatInt(it.ID, 10) + "/read" } hx-target={ "#item-" + strconv.FormatInt(it.ID, 10) } hx-swap="outerHTML">✓</button>
					}
				</div>
			</div>
		</div>
	</li>
}

templ ScopedItems(d scopedItemsData) {
	if d.SwapOOB {
		<div id="scoped-items" hx-swap-oob="outerHTML">
			@scopedItemsInner(d)
		</div>
	} else {
		<div id="scoped-items">
			@scopedItemsInner(d)
		</div>
	}
}

templ scopedItemsInner(d scopedItemsData) {
	<nav class="tabs">
		if d.View == "unread" {
			<a class="active" href={ d.Path + "?view=unread" } hx-get={ d.ItemsPath + "?view=unread" } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=unread" }>unread ({ d.UnreadCount })</a>
		} else {
			<a href={ d.Path + "?view=unread" } hx-get={ d.ItemsPath + "?view=unread" } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=unread" }>unread ({ d.UnreadCount })</a>
		}
		if d.View == "read" {
			<a class="active" href={ d.Path + "?view=read" } hx-get={ d.ItemsPath + "?view=read" } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=read" }>read ({ d.ReadCount })</a>
		} else {
			<a href={ d.Path + "?view=read" } hx-get={ d.ItemsPath + "?view=read" } hx-target="#scoped-items" hx-swap="outerHTML" hx-push-url={ d.Path + "?view=read" }>read ({ d.ReadCount })</a>
		}
	</nav>
	@ItemsList(d.Items)
}

templ ItemView(d itemViewData) {
	@itemViewInner(d, visualsOf(store.ItemWithFeed{
		Item: store.Item{
			Link:     d.Link,
			Summary:  d.Summary,
			ImageURL: d.ImageURL,
			Title:    d.Title,
		},
	}))
}

templ itemViewInner(d itemViewData, v itemVisuals) {
	<div class="item-view">
		<h1>{ d.Title }</h1>
		<p class="item-meta">
			if d.AuthorName != "" {
				<a href={ "/authors/" + strconv.FormatInt(d.AuthorID, 10) }>{ d.AuthorName }</a> ·
			}
			<a href={ "/feeds/" + strconv.FormatInt(d.FeedID, 10) }>{ d.FeedTitle }</a>
			if d.PublishedAt != "" {
				· { web.TimeFmt(d.Timezone, d.PublishedAt) }
			}
			if d.SourceURL != "" {
				· <a href={ templ.URL(d.SourceURL) } target="_blank" rel="noopener" class="external">source</a>
			}
		</p>
		if len(d.Gallery) > 0 {
			<div class="gallery">
				for _, img := range d.Gallery {
					<img src={ templ.URL(img) } alt="" loading="lazy"/>
				}
			</div>
		} else if v.Image {
			<div class="image-lightbox">
				<img src={ templ.URL(d.ImageURL) } alt={ d.Title } loading="lazy"/>
			</div>
		} else if d.EmbedSrc != "" {
			<div class="video-embed">
				<iframe src={ templ.URL(d.EmbedSrc) } title={ d.Title } frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy" referrerpolicy="no-referrer"></iframe>
			</div>
		} else if d.EmbedURL != "" {
			<div class="video-embed">
				<iframe src={ templ.URL(d.EmbedURL) } title={ d.Title } frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>
			</div>
		}
		if d.Body != "" && !v.Image && d.SourceURL == "" && len(d.Gallery) == 0 {
			<div class="item-body">@templ.Raw(d.Body)</div>
		}
	</div>
}